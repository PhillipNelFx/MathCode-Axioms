            f"   Signed distance: "
            f"{features['anchor_distance_pips']:+.1f} pips"
        )
    else:
        print(
            "   Signed distance in pips: N/A "
            "(pip convention not set for this instrument)"
        )
        print(
            f"   Signed distance (price units): "
            f"{price - anchor:+.6g}"
        )

    ascii_anchor_position(price, anchor)
    print("   Z extension: " + fmt(features.get("Z"), 4))
    print("   Z scale mode: " + DEFAULT_CONFIG["z_scale_mode"])
    print(
        "   Note: Z is a model-specific reference-relative offset, "
        "not a probability or a conventional return z-score."
    )

    print(
        "\n2) LIVE MOVEMENT AGAINST PREVIOUS COMPLETED DAILY CLOSE"
    )
    print(f"   Previous close: {last_close:.8g}")
    print(f"   Live quote     : {price:.8g}")

    if pip_size is not None:
        print(
            f"   Change         : "
            f"{features['live_return_pips']:+.1f} pips"
        )
    else:
        print(
            f"   Change (price) : "
            f"{price - last_close:+.6g}"
        )

    print(
        f"   Percent change : {features['live_return_pct']:+.4f}%"
    )

    pct_abs = abs(features["live_return_pct"])
    if pct_abs > LIVE_QUOTE_ANOMALY_PCT:
        print(
            f"   ANOMALY: live quote differs from the last "
            f"completed close by {pct_abs:.4f}%, which exceeds "
            f"the provisional {LIVE_QUOTE_ANOMALY_PCT:.2f}% "
            "warning threshold."
        )
        print(
            "   Display warning only. The quote is not rejected, "
            "and neither value is inferred to be wrong."
        )

    d_live = features.get("D")
    print("   Provisional D_live: " + fmt(d_live, 4))
    print(
        "   "
        + (
            f"[{bar(d_live, 6)}]"
            if d_live is not None
            else "N/A — insufficient baseline returns"
        )
    )
    print(
        "   D_live is intraday/provisional; the time exposure is "
        "not a full D1 interval even when it is labeled "
        "against a full-D1 baseline."
    )

    print("\n3) OTHER LIVE-SNAPSHOT MEASUREMENTS")
    print(
        "   Relative volatility V_live: "
        + fmt(features.get("V"), 4)
    )
    print(
        "   Path efficiency E_live    : "
        + fmt(features.get("E"), 4)
    )
    print(
        "      E measures directness of the recent path; "
        "it is not a replacement measure."
    )

    direction = features["U"]
    direction_label = (
        "UP" if direction > 0
        else ("DOWN" if direction < 0 else "FLAT")
    )
    print(f"   Latest quote direction U  : {direction_label}")

    trend = features["trend_direction"]
    trend_label = (
        "UP" if trend > 0
        else ("DOWN" if trend < 0 else "FLAT/UNAVAILABLE")
    )
    print(f"   Prior trend direction     : {trend_label}")

    print("\nINTERPRETATION BOUNDARIES")
    side = (
        "above" if price > anchor
        else ("below" if price < anchor else "at")
    )
    print(
        f"  • The quote is {side} the historical reference anchor."
    )
    print(
        "  • Anchor distance and live daily-close movement "
        "are different measurements."
    )
    print(
        "  • A large anchor distance does not prove a reversal "
        "is due."
    )
    print(
        "  • A large D_live is provisional while the D1 candle "
        "remains open; time exposure differs from a completed D1."
    )
    print(
        "  • Replacement outcome: NOT MEASURED — no future "
        "prices are available."
    )
    print(
        "  • This snapshot does not alter or append to the "
        "historical dataset."
    )
    print("=" * 66)


def live_reconstruction():
    dataset = load_current_dataset()
    if dataset is None:
        print("No valid historical dataset. Use B first.")
        return

    print("\n=== L | LIVE RECONSTRUCTION ===")
    print(
        f"Instrument: {dataset['symbol']} "
        f"| last stored D1 close: {dataset['prices'][-1]:.8g}"
    )
    print(
        "Paste/type the current price displayed by MT5. "
        "Do not enter a spread or pip value."
    )

    pip_size = instrument_pip_size(dataset["symbol"])
    if pip_size is None:
        print(
            f"Warning: unknown pip convention for "
            f"'{dataset['symbol']}'. Enter a pip size explicitly, "
            "or leave blank to skip pip display."
        )
        raw_pip = input("Pip size (e.g. 0.0001): ").strip()
        if raw_pip:
            try:
                pip_size = normalize_price(raw_pip)
            except (ValueError, TypeError):
                print("Invalid pip size; pip display will be skipped.")
                pip_size = None

    raw = input("Current quote: ").strip()
    try:
        quote = normalize_price(raw)
    except (ValueError, TypeError):
        print(
            "Invalid quote. Enter one positive price, e.g. 1.3796."
        )
        return

    quote_time = input(
        "Quote timestamp (optional, e.g. 2026-10-15 10:30 SAST): "
    ).strip()

    try:
        features = calculate_live_features(
            dataset, quote, dict(DEFAULT_CONFIG), pip_size
        )
    except (ValueError, TypeError, IndexError) as exc:
        print(f"Live reconstruction failed: {exc}")
        return

    print_live_report(dataset, features, quote_time)

    snapshot = {
        "version": VERSION,
        "mode": "manual_live_snapshot",
        "created_utc": datetime.now(timezone.utc).isoformat(),
        "quote_time_entered": quote_time or None,
        "symbol": dataset["symbol"],
        "timeframe_base": dataset["timeframe"],
        "price_field_base": dataset["price_field"],
        "dataset_hash": dataset["dataset_hash"],
        "config": DEFAULT_CONFIG,
        "pip_size": pip_size,
        "features": features,
        "epistemic_note": (
            "Live snapshot only. No T1 outcome calculated or "
            "implied."
        ),
    }

    write_json(LIVE_FILE, snapshot)
    print(f"Live snapshot saved separately: {LIVE_FILE.name}")
    print(
        "The quote was not added to the completed-close history."
    )


