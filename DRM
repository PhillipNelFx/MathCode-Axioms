# ============================================================
# BACKUP (one-time, per file, never overwrites an existing backup)
# ============================================================

def ensure_backup(path):
    if not path.exists():
        return
    backup = path.with_suffix(path.suffix + BACKUP_SUFFIX)
    if backup.exists():
        return
    try:
        shutil.copy2(path, backup)
        print(f"Backup created: {backup.name}")
    except OSError as exc:
        print(f"Warning: could not back up {path.name}: {exc}")


def ensure_data_backups():
    for path in (DATASET_FILE, ARCHIVE_FILE, REPORT_FILE, LIVE_FILE):
        ensure_backup(path)


# ============================================================
# JSON STORAGE
# ============================================================

def read_json(path, default):
    if not path.exists():
        return default
    try:
        with path.open("r", encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"Warning: could not read {path.name}: {exc}")
        return default


def write_json(path, data):
    temporary = path.with_suffix(path.suffix + ".tmp")
    with temporary.open("w", encoding="utf-8") as handle:
        json.dump(data, handle, indent=2, allow_nan=False)
    temporary.replace(path)


# ============================================================
# EVENT POSITION NORMALIZATION
# ============================================================

def normalize_event_positions(raw):
    """
    Normalize to list of {"position": int, "mode": str}.

    Legacy list of ints -> each becomes mode "unknown" (FIX-2).
    Only mode == "contemporaneous" may enter T0 event-context DNA.
    """
    if raw is None:
        return []
    if not isinstance(raw, list):
        raise ValueError("event_positions must be a list.")
    result = []
    for item in raw:
        if isinstance(item, bool):
            raise ValueError("Event positions must be integers.")
        if isinstance(item, int):
            result.append({"position": item, "mode": "unknown"})
            continue
        if isinstance(item, dict):
            pos = item.get("position")
            mode = item.get("mode", "unknown")
            if isinstance(pos, bool) or not isinstance(pos, int):
                raise ValueError("Event positions must be integers.")
            if mode not in EVENT_ANNOTATION_MODES:
                raise ValueError(
                    f"Unknown event annotation mode: {mode}"
                )
            result.append({"position": pos, "mode": mode})
            continue
        raise ValueError("Invalid event position entry.")
    return result


def get_contemporaneous_positions(dataset):
    """Return set of positions whose marker is explicitly contemporaneous."""
    try:
        events = normalize_event_positions(
            dataset.get("event_positions")
        )
    except ValueError:
        return set()
    return {
        e["position"] for e in events if e["mode"] == "contemporaneous"
    }


# ============================================================
# INSTRUMENT-AWARE PIP SIZE (FIX-3)
# ============================================================

def instrument_pip_size(symbol):
    """
    Return the conventional pip size for the instrument, or None
    if the convention cannot be inferred safely.

    FX pairs (both halves are known currency codes):
        quote == JPY -> 0.01
        otherwise    -> 0.0001

    Metals (XAU, XAG, XPT, XPD), crypto (BTC, ETH, ...),
    indices, and any 6-letter symbol whose halves are not both
    currencies return None. The caller must supply the size
    explicitly or skip pip display.
    """
    s = str(symbol or "").strip().upper()
    if len(s) != 6 or not s.isalpha():
        return None
    base, quote = s[:3], s[3:]
    if base not in FX_CURRENCIES or quote not in FX_CURRENCIES:
        return None
    if quote == "JPY":
        return 0.01
    return 0.0001


# ============================================================
# INPUT, VALIDATION, AND DATASET PERSISTENCE
# ============================================================

def normalize_price(value):
    price = float(value)
    if not math.isfinite(price) or price <= 0:
        raise ValueError("Prices must be finite positive numbers.")
    return price


def instrument_jump_threshold(symbol, default=0.5):
    """
    Per-instrument sanity threshold for adjacent log-price jumps.
    Default retained at 0.5 (audit notes this is permissive; kept
    for continuity because tightening here is a research decision).
    """
    return default


def parse_sanity_warnings(prices, limit=None, symbol=None):
    if limit is None:
        limit = instrument_jump_threshold(symbol)
    warnings = []
    for i in range(1, len(prices)):
        jump = abs(math.log(prices[i] / prices[i - 1]))
        if jump > limit:
            warnings.append((i + 1, prices[i - 1], prices[i]))
    return warnings


def dataset_hash(dataset):
    canonical = {
        "symbol": dataset["symbol"].strip().upper(),
        "timeframe": dataset["timeframe"].strip().upper(),
        "price_field": dataset["price_field"].strip().lower(),
        "prices": [format(float(p), ".15g") for p in dataset["prices"]],
        "timestamps": dataset.get("timestamps"),
    }
    encoded = json.dumps(
        canonical, sort_keys=True, separators=(",", ":")
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def validate_dataset(dataset):
    prices = dataset.get("prices", [])

    if not MIN_OBSERVATIONS <= len(prices) <= MAX_BUFFER_CAPACITY:
        raise ValueError(
            f"Expected {MIN_OBSERVATIONS} to {MAX_BUFFER_CAPACITY} "
            f"prices; received {len(prices)}."
        )

    for price in prices:
        normalize_price(price)

    for field in ("symbol", "timeframe", "price_field"):
        if not str(dataset.get(field, "")).strip():
            raise ValueError(f"{field} cannot be empty.")

    try:
        events = normalize_event_positions(
            dataset.get("event_positions")
        )
    except ValueError as exc:
        raise ValueError(f"Event markers invalid: {exc}")

    for event in events:
        if event["position"] < 1 or event["position"] > len(prices):
            raise ValueError(
                f"Event position {event['position']} is outside "
                "the dataset."
            )

    mode = dataset.get("event_annotation_mode", "unspecified")
    if mode not in EVENT_ANNOTATION_MODES:
        raise ValueError(f"Unknown event annotation mode: {mode}")

    timestamps = dataset.get("timestamps")
    if timestamps is not None:
        if not isinstance(timestamps, list):
            raise ValueError("timestamps must be a list or null.")
        if len(timestamps) != len(prices):
            raise ValueError(
                "timestamps length must match prices length."
            )
        if len(set(timestamps)) != len(timestamps):
            raise ValueError("Duplicate timestamps detected.")


def read_price_block(prompt="Paste daily prices, oldest to newest."):
    print(prompt)
    print("Press Enter on an empty line to finish.")
    lines = []
    while True:
        try:
            line = input()
        except EOFError:
            break
        if not line.strip():
            if lines:
                break
            continue
        lines.append(line)
    return lines


def parse_price_lines(lines):
    prices = []
    skipped = 0
    for number, line in enumerate(lines, start=1):
        normalized = line.replace(",", " ").replace(";", " ")
        for token in normalized.split():
            try:
                value = float(token)
            except ValueError:
                if any(char.isdigit() for char in token):
                    raise ValueError(
                        f"Line {number}: cannot read '{token}' "
                        "as a price."
                    )
                skipped += 1
                continue
            prices.append(normalize_price(value))
    return prices, skipped


def parse_timestamps(raw, expected_count):
    """
    Parse optional comma-separated timestamps (FIX-8).

    Returns:
        None  if the input string is blank.
        list  of string timestamps otherwise.

    Raises:
        ValueError if the count differs from expected_count,
        if duplicates are present, or if every entry parses as
        an ISO datetime and the sequence is not strictly
        ascending.

    If not every entry parses as ISO, the raw strings are
    returned without an order check (opaque labels cannot be
    ordered).
    """
    text = (raw or "").strip()
    if not text:
        return None
    parts = [p.strip() for p in text.replace(";", ",").split(",")]
    parts = [p for p in parts if p]
    if len(parts) != expected_count:
        raise ValueError(
            f"Expected {expected_count} timestamps; got "
            f"{len(parts)}. Provide one timestamp per historical "
            "observation, or leave blank to skip."
        )
    if len(set(parts)) != len(parts):
        raise ValueError("Duplicate timestamps detected.")
    try:
        parsed = [datetime.fromisoformat(p) for p in parts]
    except ValueError:
        return parts
    for i in range(1, len(parsed)):
        if parsed[i] <= parsed[i - 1]:
            raise ValueError(
                f"Timestamps not strictly ascending at index "
                f"{i + 1}."
            )
    return parts


def collect_dataset():
    print("\n=== B | BATCH INJECT HISTORICAL DATA ===")
    print(
        f"Accepted range: {MIN_OBSERVATIONS}–"
        f"{MAX_BUFFER_CAPACITY} daily closes."
    )

    previous = read_json(DATASET_FILE, {}) or {}
    default_symbol = str(previous.get("symbol", "")).strip().upper()

    if default_symbol:
        symbol = (
            input(f"Instrument [{default_symbol}]: ").strip().upper()
            or default_symbol
        )
    else:
        symbol = input("Instrument (e.g. USDCAD): ").strip().upper()

    if not symbol:
        print("Rejected: instrument cannot be empty.")
        return None

    lines = read_price_block()
    try:
        prices, skipped = parse_price_lines(lines)
    except ValueError as exc:
        print(f"Dataset rejected: {exc}")
        return None

    if skipped:
        print(
            f"Skipped {skipped} non-numeric text item(s), "
            "such as headers."
        )

    if not MIN_OBSERVATIONS <= len(prices) <= MAX_BUFFER_CAPACITY:
        print(
            f"Dataset rejected: received {len(prices)} prices; "
            "expected 90–150."
        )
        return None

    suspicious = parse_sanity_warnings(prices, symbol=symbol)
    if suspicious:
        print("\nWARNING: unusually large one-step jumps detected:")
        for position, before, after in suspicious[:5]:
            print(f"  observation {position}: {before} -> {after}")
        print("Check for a decimal-comma or pasted-data problem.")
        if (
            input("Keep this dataset anyway? [y/N]: ").strip().lower()
            != "y"
        ):
            print("Dataset rejected.")
            return None

    preview = ", ".join(f"{p:.8g}" for p in prices[-5:])
    print(f"\nLast 5 prices (newest last): {preview}")

    ts_raw = input(
        "Optional timestamps (comma-separated, oldest first, "
        "one per observation, blank to skip): "
    )
    try:
        timestamps = parse_timestamps(ts_raw, len(prices))
    except ValueError as exc:
        print(f"Dataset rejected: {exc}")
        return None

    if timestamps is None:
        print(
            "No timestamps provided. Chronology cannot be "
            "independently verified."
        )
        if (
            input(
                "Confirm the list is oldest-to-newest? [y/N]: "
            ).strip().lower()
            != "y"
        ):
            print("Dataset rejected.")
            return None

    dataset = {
        "version": VERSION,
        "created_utc": datetime.now(timezone.utc).isoformat(),
        "symbol": symbol,
        "timeframe": DEFAULT_TIMEFRAME,
        "price_field": DEFAULT_PRICE_FIELD,
        "prices": prices,
        "timestamps": timestamps,
        "event_positions": [],
        "event_annotation_mode": "unspecified",
    }

    try:
        validate_dataset(dataset)
    except ValueError as exc:
        print(f"Dataset rejected: {exc}")
        return None

    dataset["dataset_hash"] = dataset_hash(dataset)
    write_json(DATASET_FILE, dataset)

    print(
        f"\nAccepted {len(prices)} closes for {symbol} (D1 Close)."
    )
    print(f"First: {prices[0]:.8g} | Last: {prices[-1]:.8g}")
    print(f"Dataset hash: {dataset['dataset_hash']}")
    print(
        "Historical event markers were reset because a new "
        "price series was loaded."
    )
    return dataset


def load_current_dataset():
    dataset = read_json(DATASET_FILE, None)
    if not dataset:
        return None
    try:
        validate_dataset(dataset)
        if dataset.get("dataset_hash") != dataset_hash(dataset):
            print("Stored dataset hash mismatch; dataset rejected.")
            return None
        dataset.setdefault("event_annotation_mode", "unspecified")
        dataset["event_positions"] = normalize_event_positions(
            dataset.get("event_positions")
        )
        return dataset
    except (ValueError, TypeError, KeyError, AttributeError) as exc:
        print(f"Stored dataset is invalid: {exc}")
        return None


def edit_event_markers():
    dataset = load_current_dataset()
    if dataset is None:
        print("No valid dataset. Use B first.")
        return

    count = len(dataset["prices"])

    print("\n=== E | ANNOTATE HISTORICAL EVENTS (per-marker mode) ===")
    current = dataset.get("event_positions") or []
    if current:
        pretty = ", ".join(
            f"{e['position']}:{e['mode'][0]}" for e in current
        )
    else:
        pretty = "none"
    print(f"Current event markers: {pretty}")
    print(f"Use 1-based observation positions from 1 to {count}.")
    print("Example positions: 15,36,67. Blank clears all markers.")

    raw = input("Event positions: ").strip()

    try:
        positions = sorted({
            int(part)
            for part in raw.replace(" ", "").split(",")
            if part
        })
    except ValueError:
        print("Invalid positions; nothing changed.")
        return

    entries = []
    if positions:
        print(
            "For each position, choose mode: "
            "c=contemporaneous, r=retrospective, "
            "u=unspecified"
        )
        for position in positions:
            choice = input(
                f"  position {position} mode [u]: "
            ).strip().lower()
            mode = {
                "c": "contemporaneous",
                "r": "retrospective",
                "u": "unspecified",
                "": "unspecified",
            }.get(choice)
            if mode is None:
                print(
                    f"Invalid mode for position {position}; "
                    "nothing changed."
                )
                return
            entries.append({"position": position, "mode": mode})

    dataset["event_positions"] = entries
    dataset["event_annotation_mode"] = "unspecified"

    try:
        validate_dataset(dataset)
    except ValueError as exc:
        print(f"Rejected: {exc}")
        return

    write_json(DATASET_FILE, dataset)

    if entries:
        print("Saved event markers:")
        for entry in entries:
            print(f"  position {entry['position']} -> {entry['mode']}")
    else:
        print("Saved event markers: none")

    print(
        "Only 'contemporaneous' markers enter T0 event-context DNA. "
        "Retrospective and unspecified/unknown markers are retained "
        "for T1+ analysis only."
    )


# ============================================================
# NUMERICAL UTILITIES
# ============================================================

def sign(value):
    return 1 if value > 0 else (-1 if value < 0 else 0)


def median_or_none(values):
    return statistics.median(values) if values else None


def mad_scale(values):
    if len(values) < 2:
        return None
    center = statistics.median(values)
    scale = 1.4826 * statistics.median(
        [abs(x - center) for x in values]
    )
    return None if scale <= EPSILON else scale


def standard_deviation_or_none(values):
    if len(values) < 2:
        return None
    value = statistics.pstdev(values)
    return None if value <= EPSILON else value


def safe_ratio(numerator, denominator):
    if (
        numerator is None
        or denominator is None
        or abs(denominator) <= EPSILON
    ):
        return None
    return numerator / denominator


def log_returns(prices):
    returns = [None]
    for i in range(1, len(prices)):
        returns.append(math.log(prices[i] / prices[i - 1]))
    return returns


def hamming_distance(a, b):
    return bin(int(a) ^ int(b)).count("1")


# ============================================================
# T0 FEATURE RECONSTRUCTION
# ============================================================

def reference_scale(prior_logs, returns, index, config):
    """
    Scale for Z.

    level_mad    : robust level scale (default).
    return_mad_rw: robust return scale * sqrt(sum((m/n)^2)).

    FIX-6: the return slice for return_mad_rw uses exactly `n`
    prior completed returns, matching the D window convention.
    """
    mode = config["z_scale_mode"]

    if mode == "level_mad":
        return mad_scale(prior_logs)

    if mode == "return_mad_rw":
        n = config["reference_window"]
        window_returns = [
            value
            for value in returns[max(1, index - n):index]
            if value is not None
        ]
        if len(window_returns) < n:
            return None
        sigma = mad_scale(window_returns)
        if sigma is None:
            return None
        return sigma * math.sqrt(
            sum((m / n) ** 2 for m in range(1, n + 1))
        )

    raise ValueError(f"Unknown z_scale_mode: {mode}")


def calculate_features(prices, index, config):
    """
    T0 features. Only prices[0:index+1] are read.

    Added in repair pass (FIX-4, FIX-5), descriptive only:
        start_price_single, start_price_multi
        multi_window_return, multi_window_duration
        direction_run
    """
    if index < 1:
        return None

    observed = prices[:index + 1]
    logs = [math.log(p) for p in observed]
    returns = log_returns(observed)
    current_return = returns[index]

    d_window = config["displacement_window"]
    z_window = config["reference_window"]
    recent_window = config["recent_volatility_window"]
    baseline_window = config["baseline_volatility_window"]
    path_window = config["path_window"]
    trend_window = config["trend_window"]

    features = {
        "index": index,
        "price": prices[index],
        "return": current_return,
        "D": None,
        "Z": None,
        "V": None,
        "E": None,
        "U": sign(current_return),
        "e": None,
        "baseline_abs_return": None,
        "reference_log_mean": None,
        "reference_price": None,
        "trend_direction": 0,
        "event_context": False,
        "start_price_single": None,
        "start_price_multi": None,
        "multi_window_return": None,
        "multi_window_duration": None,
        "direction_run": 0,
    }

    prior_returns = [
        v
        for v in returns[max(1, index - d_window):index]
        if v is not None
    ]
    if len(prior_returns) >= d_window:
        baseline = median_or_none([abs(v) for v in prior_returns])
        features["baseline_abs_return"] = baseline
        features["D"] = safe_ratio(abs(current_return), baseline)

    prior_logs = logs[max(0, index - z_window):index]
    if len(prior_logs) >= z_window:
        center = statistics.fmean(prior_logs)
        features["reference_log_mean"] = center
        features["reference_price"] = math.exp(center)
        features["e"] = logs[index] - center
        scale = reference_scale(prior_logs, returns, index, config)
        if scale is not None:
            features["Z"] = features["e"] / scale

    recent_start = max(1, index - recent_window + 1)
    recent = [
        v for v in returns[recent_start:index + 1] if v is not None
    ]
    baseline_end = recent_start
    baseline_start = max(1, baseline_end - baseline_window)
    baseline_returns = [
        v
        for v in returns[baseline_start:baseline_end]
        if v is not None
    ]
    if (
        len(recent) >= recent_window
        and len(baseline_returns) >= baseline_window
    ):
        features["V"] = safe_ratio(
            standard_deviation_or_none(recent),
            standard_deviation_or_none(baseline_returns),
        )

    if index >= path_window:
        segment = prices[index - path_window:index + 1]
        path_length = sum(
            abs(segment[j] - segment[j - 1])
            for j in range(1, len(segment))
        )
        net_move = abs(segment[-1] - segment[0])
        if path_length > EPSILON:
            features["E"] = min(1.0, net_move / path_length)

    prior_trend = logs[max(0, index - trend_window):index]
    if len(prior_trend) >= trend_window:
        features["trend_direction"] = sign(
            prior_trend[-1] - prior_trend[0]
        )

    if index >= 1:
        features["start_price_single"] = prices[index - 1]

    if index >= MULTI_CANDLE_WINDOW:
        start_multi = prices[index - MULTI_CANDLE_WINDOW]
        features["start_price_multi"] = start_multi
        features["multi_window_return"] = math.log(
            prices[index] / start_multi
        )
        features["multi_window_duration"] = MULTI_CANDLE_WINDOW

    run = 0
    j = index
    while j >= 1:
        r = returns[j]
        if r is None or r == 0:
            break
        if run == 0:
            run = 1
            prev_sign = sign(r)
            j -= 1
            continue
        if sign(r) == prev_sign:
            run += 1
            j -= 1
        else:
            break
    features["direction_run"] = run

    return features


def build_dna(features, contemporaneous_positions, config):
    """
    FIX-2: only explicitly contemporaneous event positions count
    toward EVENT_CONTEXT in T0 DNA.
    """
    dna = 0

    index = features["index"]
    displacement_ratio = features["D"]
    z_score = features["Z"]
    extension = features["e"]
    volatility = features["V"]
    direction = features["U"]
    trend = features["trend_direction"]

    displacement = (
        displacement_ratio is not None
        and displacement_ratio >= config["displacement_threshold"]
    )

    conditions = {
        "DISPLACEMENT": displacement,
        "BELOW_REFERENCE": extension is not None and extension < 0,
        "ABOVE_REFERENCE": extension is not None and extension > 0,
        "HIGH_VOLATILITY": (
            volatility is not None
            and volatility >= config["volatility_ratio_threshold"]
        ),
        "EVENT_CONTEXT": (index + 1) in contemporaneous_positions,
        "TREND_ALIGNED": (
            direction != 0 and trend != 0 and direction == trend
        ),
        "EXTREME_EXTENSION": (
            z_score is not None
            and abs(z_score) >= config["extension_threshold"]
        ),
        "UP_DISPLACEMENT": displacement and direction > 0,
        "DOWN_DISPLACEMENT": displacement and direction < 0,
    }

    for name, condition in conditions.items():
        if condition:
            dna |= DNA_FLAGS[name]

    return dna


def decode_dna(dna):
    return [
        name
        for name, value in DNA_FLAGS.items()
        if dna & value
    ]


def build_fingerprint(features):
    return {
        name: features.get(name)
        for name in ("D", "Z", "V", "E", "U")
    }


