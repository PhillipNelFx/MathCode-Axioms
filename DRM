def bar(value, maximum, width=24,
        positive_char="#", negative_char="-"):
    if value is None:
        return "N/A"
    if not math.isfinite(float(value)):
        return "N/A"
    if maximum <= 0:
        return " " * width
    count = min(
        width,
        int(round(min(abs(value) / maximum, 1.0) * width)),
    )
    character = positive_char if value >= 0 else negative_char
    return character * count + "." * (width - count)


def fmt(value, digits=4):
    if value is None:
        return "N/A"
    try:
        if not math.isfinite(float(value)):
            return "N/A"
        return f"{value:.{digits}f}"
    except (TypeError, ValueError):
        return str(value)


def ascii_anchor_position(price, anchor, width=40):
    if anchor is None or price is None or anchor <= 0:
        print(
            "  Position: unavailable (reference anchor not available)"
        )
        return
    if price == anchor:
        anchor_position = price_position = width // 2
    elif price > anchor:
        anchor_position = 8
        price_position = min(
            width - 1, 8 + max(1, int(width * 0.72))
        )
    else:
        anchor_position = width - 9
        price_position = max(
            0, width - 9 - max(1, int(width * 0.72))
        )
    characters = ["-"] * width
    characters[anchor_position] = "A"
    characters[price_position] = "P"
    print("  " + "".join(characters))
    print("  " + " " * anchor_position + "A = anchor")
    print("  " + " " * price_position + "P = current price")
    side = (
        "ABOVE"
        if price > anchor
        else ("BELOW" if price < anchor else "AT")
    )
    print(f"  Current quote is {side} the reference anchor.")


def print_measurement_bars(features):
    """
