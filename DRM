def show_summary():
    config = DEFAULT_CONFIG
    config_digest = config_hash(config)

    episodes = [
        item
        for item in read_json(
            ARCHIVE_FILE, {"episodes": []}
        ).get("episodes", [])
        if item.get("config_hash") == config_digest
    ]

    print("\n=== S | ARCHIVE SUMMARY ===")
    print(f"Config hash: {config_digest}")
    print(f"Episodes under this configuration: {len(episodes)}")

    if not episodes:
        return

    counts = {}
    for item in episodes:
        status = item.get("outcome", {}).get("status", "unknown")
        counts[status] = counts.get(status, 0) + 1

    print(
        "Outcome status: "
        + ", ".join(f"{k}={v}" for k, v in counts.items())
    )

    complete = [
        item["outcome"]
        for item in episodes
        if item.get("outcome", {}).get("status") == "complete"
    ]

    sample_size = len(complete)
    if not sample_size:
        print(
            "No complete-follow-up episodes yet; no frequencies "
            "reported."
        )
        return

    print(
        f"\nComplete follow-up only (n={sample_size}), "
        f"horizon {config['outcome_horizon']}:"
    )

    for threshold in config["replacement_thresholds"]:
        hits = [
            outcome["replacement_times"][str(threshold)]["h"]
            for outcome in complete
            if outcome["replacement_times"][str(threshold)]["observed"]
        ]
        line = (
            f"  q={threshold}: reached in {len(hits)}/{sample_size} "
            f"({len(hits) / sample_size:.0%})"
        )
        if hits:
            line += (
                f"; median first-reach h={statistics.median(hits)}"
            )
        print(line)

    continuation = [o["max_continuation"] for o in complete]
    print(
        "  Median max continuation C_H: "
        f"{statistics.median(continuation):.3f}"
    )

    if sample_size < 30:
        print(f"Caution: n={sample_size} is small.")

    print(
        "These are observed frequencies, not probabilities. "
        "Overlapping episodes are not independent."
    )


