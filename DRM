# T1+ OUTCOME MEASUREMENT
# ============================================================

def classify_outcome(max_q, max_continuation):
    tags = []
    if max_continuation > 0:
        tags.append("further_displacement")
    if max_q <= 0:
        tags.append("no_movement_toward_anchor")
    elif max_q < 1.0:
        tags.append("partial_replacement_only")
    else:
        tags.append("reached_anchor")
        if max_q > 1.0:
            tags.append("overshoot")
    return tags


def compute_retracement_ratio(endpoint, reference, futures):
    """
    Signed maximum progress toward `reference` over `futures`.

    Sign convention:
        > 0 -> future price moved toward the reference
        = 0 -> no net progress
        < 0 -> future price only moved farther from the reference

    1.0 means the reference is reached; > 1.0 means overshoot.

    Returns None if the reference is missing or coincides with
    the endpoint (degenerate distance).
    """
    if reference is None:
        return None
    distance = abs(endpoint - reference)
    if distance <= EPSILON:
        return None
    direction = sign(endpoint - reference)
    if direction == 0:
        return None
    best = None
    for future in futures:
        q = direction * (endpoint - future) / distance
        if best is None or q > best:
            best = q
    return best


def calculate_outcome(prices, index, features, config):
    anchor = features.get("reference_price")
    endpoint = prices[index]

    if anchor is None:
        return {
            "status": "unavailable",
            "reason": "Insufficient reference history",
        }

    distance = abs(endpoint - anchor)
    direction = sign(endpoint - anchor)

    if distance <= EPSILON or direction == 0:
        return {
            "status": "unavailable",
            "reason": "Displacement from anchor is too small",
        }

    floor = config.get("min_anchor_distance_moves")
    if floor is not None:
        baseline = features.get("baseline_abs_return")
        offset = features.get("e")
        if (
            baseline is None
            or offset is None
            or abs(offset) < floor * baseline
        ):
            return {
                "status": "unavailable",
                "reason": (
                    f"Endpoint is within {floor} typical daily "
                    "move(s) of the anchor; ratios are unstable"
                ),
            }

    requested = config["outcome_horizon"]
    available = min(requested, len(prices) - index - 1)

    if available <= 0:
        return {
            "status": "right_censored",
            "reason": "No later observations",
            "available_horizon": 0,
            "requested_horizon": requested,
        }

    q_values = []
    continuation_values = []
    futures = []

    for horizon in range(1, available + 1):
        future = prices[index + horizon]
        futures.append(future)
        q_value = direction * (endpoint - future) / distance
        continuation_value = direction * (future - endpoint) / distance
        q_values.append(q_value)
        continuation_values.append(continuation_value)

    replacement_times = {}
    for threshold in config["replacement_thresholds"]:
        first_hit = next(
            (
                horizon
                for horizon, q_value in enumerate(q_values, 1)
                if q_value >= threshold
            ),
            None,
        )
        replacement_times[str(threshold)] = {
            "observed": first_hit is not None,
            "h": first_hit,
            "observed_horizon": available,
        }

    max_q = max(q_values)
    max_continuation = max(0.0, max(continuation_values))

    result = {
        "status": (
            "complete" if available == requested else "right_censored"
        ),
        "anchor_price": anchor,
        "endpoint_price": endpoint,
        "displacement_size": distance,
        "direction": direction,
        "requested_horizon": requested,
        "available_horizon": available,
        "q_at_last_observation": q_values[-1],
        "max_replacement": max_q,
        "max_continuation": max_continuation,
        "replacement_times": replacement_times,
        "outcome_tags": classify_outcome(max_q, max_continuation),
        "q_values": q_values,
    }

    start_single = features.get("start_price_single")
    start_multi = features.get("start_price_multi")
    result["start_price_single"] = start_single
    result["start_price_multi"] = start_multi
    result["retracement_to_start_single"] = compute_retracement_ratio(
        endpoint, start_single, futures
    )
    result["retracement_to_start_multi"] = compute_retracement_ratio(
        endpoint, start_multi, futures
    )

    return result


def outcome_summary(outcome):
    keys = (
        "status",
        "available_horizon",
        "requested_horizon",
        "max_replacement",
        "max_continuation",
        "replacement_times",
        "outcome_tags",
        "retracement_to_start_single",
        "retracement_to_start_multi",
    )
    return {key: outcome.get(key) for key in keys}


