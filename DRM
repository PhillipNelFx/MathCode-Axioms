    print(
        "  Z standardized offset : "
        + (
            f"{fmt(z, 2)}  [{bar(z, 4)}]"
            if z is not None
            else "N/A (scale unavailable)"
        )
    )
    print(
        "      Z is a model-specific reference-relative "
        "offset, not a probability or a conventional "
        "return z-score."
    )

    print(
        "  V relative volatility : "
        + (
            f"{fmt(v, 2)}  [{bar(v - 1, 2)}] "
            "(center = 1.0 baseline)"
            if v is not None
            else "N/A (insufficient history)"
        )
    )

    print(
        "  E path efficiency     : "
        + (
            f"{fmt(e, 2)}  [{bar(e, 1)}]"
            if e is not None
            else "N/A (insufficient history)"
        )
    )
    print(
        "      E measures directness of the recent path "
        "(0 = oscillatory, 1 = direct). It is not a "
        "replacement measure."
    )

    ms = features.get("start_price_single")
    mm = features.get("start_price_multi")
    mwr = features.get("multi_window_return")
    mwd = features.get("multi_window_duration")
    dr = features.get("direction_run")

    if ms is not None or mm is not None:
        print("\n  Descriptive starting prices (FIX-4, FIX-5):")
        print(
            f"    start_price_single (previous close): "
            f"{fmt(ms, 8)}"
        )
        print(
            f"    start_price_multi  (close {MULTI_CANDLE_WINDOW} "
            f"back)          : {fmt(mm, 8)}"
        )
        print(
            f"    multi_window_return (log)          : "
            f"{fmt(mwr, 6)}"
        )
        print(
            f"    multi_window_duration (candles)    : "
            f"{mwd if mwd is not None else 'N/A'}"
        )
        print(
            f"    direction_run (consecutive candles): "
            f"{dr if dr is not None else 0}"
        )


def print_outcome_visual(outcome):
    print("\nT1+ OUTCOME VISUAL — OBSERVED AFTER T0")

    if outcome.get("status") == "unavailable":
        print(
            "  Outcome: unavailable — "
            + outcome.get("reason", "reason not supplied")
        )
        return

    available = outcome.get("available_horizon", 0)
    requested = outcome.get("requested_horizon", 0)

    if available <= 0:
        print(
            f"  Outcome: {outcome.get('status')} "
            f"(0/{requested} future observations)"
        )
        return

    q = outcome.get("max_replacement")
    continuation = outcome.get("max_continuation")

    print(
        f"  Follow-up: {available}/{requested} observations "
        f"| status={outcome.get('status')}"
    )

    print(
        f"  Signed max progress toward anchor   : {fmt(q, 3)}  "
        f"[{bar(q, 1.5, 28)}]"
    )
    print(
        "       Sign convention: positive = moved toward the "
        "reference; 0 = no net progress; negative = only moved "
        "further away. 1.0 = reference reached; >1 = overshoot."
    )

    rs = outcome.get("retracement_to_start_single")
    rm = outcome.get("retracement_to_start_multi")

    print(
        f"  Signed max progress toward single-candle start : "
        f"{fmt(rs, 3)}"
    )
    print(
        f"  Signed max progress toward multi-candle start  : "
        f"{fmt(rm, 3)}"
    )
    print(
        "       Same sign convention. Each is measured against "
        "its own start price, not against the anchor."
    )

    print(
        f"  Max continuation ratio               : "
        f"{fmt(continuation, 3)}  [{bar(continuation, 1.5, 28)}]"
    )

    for threshold, info in outcome.get(
        "replacement_times", {}
    ).items():
        if info.get("observed"):
            print(
                f"  q={threshold} first reached at h={info.get('h')}"
            )
        else:
            print(
                f"  q={threshold} not observed within "
                f"{info.get('observed_horizon')} observed step(s)"
            )

    print("  Tags: " + ", ".join(outcome.get("outcome_tags", [])))


