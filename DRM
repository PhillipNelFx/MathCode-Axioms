def make_episode_key(dataset, index, config_hash_value):
    start = max(0, index - IDENTITY_TAIL + 1)
    window = [
        format(float(price), ".15g")
        for price in dataset["prices"][start:index + 1]
    ]
    canonical = {
        "config": config_hash_value,
        "symbol": dataset["symbol"].strip().upper(),
        "timeframe": dataset["timeframe"].strip().upper(),
        "price_field": dataset["price_field"].strip().lower(),
        "window": window,
    }
    encoded = json.dumps(
        canonical, sort_keys=True, separators=(",", ":")
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def numerical_fingerprint_distance(current, historical, config):
    current_fp = current.get("fingerprint", {})
    historical_fp = historical.get("fingerprint", {})

    squared_distance = 0.0
    shared = 0

    for name in ("D", "Z", "V", "E", "U"):
        a = current_fp.get(name)
        b = historical_fp.get(name)
        if a is None or b is None:
            continue
        squared_distance += (
            (float(a) - float(b)) / FINGERPRINT_SCALES[name]
        ) ** 2
        shared += 1

    if shared < config["minimum_shared_features"]:
        return None, shared

    distance = math.sqrt(squared_distance / shared)
    return distance, shared


def historical_matches(current, archive, config):
    """
    FIX-7: same-dataset distinct episodes may match; weak matches
    beyond MAX_MATCH_DISTANCE are rejected. Overlap risk between
    episodes from the same series is documented via the
    `same_dataset` flag, not silently hidden.

    A passing threshold does NOT establish that the candidate
    episode and the current episode will share outcomes. It only
    reports that their T0 fingerprints are numerically close
    under the configured scaling. Outcome equivalence is not
    implied.
    """
    direction = current["features"]["U"]

    eligible = [
        item
        for item in archive
        if item.get("dna") is not None
        and item.get("config_hash") == current["config_hash"]
        and item.get("episode_key") != current["episode_key"]
    ]

    compatible = [
        item
        for item in eligible
        if (
            direction != 0
            and item.get("features", {}).get("U") == direction
        )
    ]

    pool = compatible if compatible else eligible
    mode = "direction-compatible" if compatible else "exploratory"

    candidates = []
    for item in pool:
        distance, shared = numerical_fingerprint_distance(
            current, item, config
        )
        if distance is None:
            continue
        if distance > MAX_MATCH_DISTANCE:
            continue
        candidates.append({
            "episode_id": item.get("episode_id", "unknown"),
            "symbol": item.get("symbol", "?"),
            "distance": distance,
            "hamming": hamming_distance(
                current["dna"], item["dna"]
            ),
            "shared_features": shared,
            "compatibility": mode,
            "same_dataset": (
                item.get("dataset_hash")
                == current.get("dataset_hash")
            ),
            "outcome": outcome_summary(item.get("outcome", {})),
        })

    candidates.sort(key=lambda x: (x["distance"], x["hamming"]))
    return candidates[:config["match_count"]]


def merge_into_archive(archive, episodes):
    positions = {
        record.get("episode_key"): i
        for i, record in enumerate(archive)
    }

    added = 0
    upgraded = 0
    unchanged = 0
    notes = []

    for episode in episodes:
        stored = {
            k: v
            for k, v in episode.items()
            if k != "historical_matches"
        }
        position = positions.get(episode["episode_key"])

        if position is None:
            archive.append(stored)
            positions[episode["episode_key"]] = len(archive) - 1
            added += 1
            continue

        old = archive[position]

        if (
            (old["dna"] ^ episode["dna"])
            & DNA_FLAGS["EVENT_CONTEXT"]
        ):
            notes.append(
                f"{old.get('episode_id')}: event marker differs; "
                "archived T0 kept."
            )

        old_horizon = (old.get("outcome") or {}).get(
            "available_horizon", 0
        )
        new_horizon = episode["outcome"].get("available_horizon", 0)

        if new_horizon > old_horizon:
            old["outcome"] = episode["outcome"]
            old["outcome_updated_utc"] = datetime.now(
                timezone.utc
            ).isoformat()
            old["outcome_source_dataset_hash"] = episode["dataset_hash"]
            upgraded += 1
        else:
            unchanged += 1

    return added, upgraded, unchanged, notes


