def calculate_live_features(dataset, live_price, config, pip_size):
    """
    Live snapshot uses completed daily closes as the historical
    base. The manually entered quote is NOT appended to history.

    FIX-3: pip_size is resolved by the caller; None suppresses
    pip-displayed fields (percent fields remain available).
    """
    prices = dataset["prices"]

    minimum_history = max(
        config["reference_window"],
        config["displacement_window"] + 1,
    )
    if len(prices) < minimum_history:
        raise ValueError(
            "Not enough historical closes for a live reconstruction."
        )

    live_price = normalize_price(live_price)

    logs = [math.log(p) for p in prices]
    returns = log_returns(prices)

    last_close = prices[-1]
    live_return = math.log(live_price / last_close)

    reference_window = config["reference_window"]
    prior_anchor_logs = logs[-reference_window:]
    anchor_log_mean = statistics.fmean(prior_anchor_logs)
    anchor = math.exp(anchor_log_mean)
    extension = math.log(live_price) - anchor_log_mean

    if config["z_scale_mode"] == "level_mad":
        scale = mad_scale(prior_anchor_logs)
    elif config["z_scale_mode"] == "return_mad_rw":
        prior_returns = [
            v for v in returns[1:] if v is not None
        ][-reference_window:]
        sigma = mad_scale(prior_returns)
        if sigma is not None:
            scale = sigma * math.sqrt(
                sum(
                    (m / reference_window) ** 2
                    for m in range(1, reference_window + 1)
                )
            )
        else:
            scale = None
    else:
        scale = None

    z_score = extension / scale if scale is not None else None

    displacement_window = config["displacement_window"]
    historical_returns = [
        abs(v) for v in returns[1:] if v is not None
    ]
    baseline_returns = historical_returns[-displacement_window:]
    baseline_abs_return = (
        median_or_none(baseline_returns)
        if len(baseline_returns) >= displacement_window
        else None
    )
    d_live = safe_ratio(abs(live_return), baseline_abs_return)

    recent_n = config["recent_volatility_window"]
    baseline_n = config["baseline_volatility_window"]
    all_returns = [v for v in returns[1:] if v is not None]

    if recent_n > 1:
        recent_historical = all_returns[-(recent_n - 1):]
    else:
        recent_historical = []

    recent_with_live = recent_historical + [live_return]
    baseline_end = max(0, len(all_returns) - (recent_n - 1))
    baseline_start = max(0, baseline_end - baseline_n)
    baseline_volatility_returns = all_returns[
        baseline_start:baseline_end
    ]

    v_live = None
    if (
        len(recent_with_live) >= recent_n
        and len(baseline_volatility_returns) >= baseline_n
    ):
        v_live = safe_ratio(
            standard_deviation_or_none(recent_with_live),
            standard_deviation_or_none(baseline_volatility_returns),
        )

    path_window = config["path_window"]
    path_prices = prices[-path_window:] + [live_price]
    if len(path_prices) > path_window + 1:
        path_prices = path_prices[-(path_window + 1):]

    e_live = None
    if len(path_prices) >= path_window + 1:
        path_length = sum(
            abs(path_prices[i] - path_prices[i - 1])
            for i in range(1, len(path_prices))
        )
        if path_length > EPSILON:
            e_live = min(
                1.0,
                abs(path_prices[-1] - path_prices[0]) / path_length,
            )

    trend_window = config["trend_window"]
    trend_logs = logs[-trend_window:]
    trend = (
        sign(trend_logs[-1] - trend_logs[0])
        if len(trend_logs) >= trend_window
        else 0
    )

    live_features = {
        "index": len(prices),
        "price": live_price,
        "return": live_return,
        "D": d_live,
        "Z": z_score,
        "V": v_live,
        "E": e_live,
        "U": sign(live_return),
        "e": extension,
        "baseline_abs_return": baseline_abs_return,
        "reference_log_mean": anchor_log_mean,
        "reference_price": anchor,
        "trend_direction": trend,
        "event_context": False,
        "last_completed_close": last_close,
        "live_return_pct": (live_price / last_close - 1.0) * 100.0,
        "snapshot_type": "manual_live_quote",
        "pip_size": pip_size,
    }

    if pip_size is not None:
        live_features["live_return_pips"] = (
            live_price - last_close
        ) / pip_size
        live_features["anchor_distance_pips"] = (
            live_price - anchor
        ) / pip_size

    return live_features


def print_live_report(dataset, features, quote_time):
    price = features["price"]
    anchor = features["reference_price"]
    last_close = features["last_completed_close"]
    pip_size = features.get("pip_size")

    print("\n" + "=" * 66)
    print(f"{VERSION} — LIVE PRICE RECONSTRUCTION")
    print("=" * 66)
    print(
        f"Instrument: {dataset['symbol']} "
        f"| Base series: D1 Close"
    )
    print(f"Quote time entered: {quote_time or 'not supplied'}")
    print(f"Current MT5 quote: {price:.8g}")
    print(f"Previous completed D1 close: {last_close:.8g}")
    print(
        f"Historical anchor (geometric mean of prior "
        f"{DEFAULT_CONFIG['reference_window']} completed closes): "
        f"{anchor:.8g}"
    )

    print("\n1) POSITION AGAINST HISTORICAL REFERENCE ANCHOR")
    print(f"   Anchor: {anchor:.8g}")
    print(f"   Quote : {price:.8g}")

    if pip_size is not None:
        print(
            f"   Pip size used: {pip_size:g} "
            f"(instrument-aware)"
        )
