def print_episode(number, episode):
    features = episode["features"]
    outcome = episode["outcome"]

    print("\n" + "-" * 66)
    print(
        f"EPISODE {number}: {episode['episode_id']} "
        f"| observation {episode['observation_number']}"
    )
    print(f"Endpoint price: {episode['price']:.8g}")
    print(
        f"DNA: {episode['dna']} "
        f"({', '.join(episode['flags']) or 'no flags'})"
    )

    print("\nT0 fingerprint (features known at this observation):")
    for key in ("D", "Z", "V", "E", "U"):
        print(f"  {key}: {fmt(features.get(key), 5)}")

    print(
        f"  Anchor: {fmt(features.get('reference_price'), 8)}"
        f" | e: {fmt(features.get('e'), 7)}"
    )

    print_measurement_bars(features)
    print_outcome_visual(outcome)

    matches = episode.get("historical_matches", [])

    print("\nHistorical matches (ranked on T0 features only):")
    if not matches:
        print(
            "  No sufficiently similar archived episode found "
            f"(rejection threshold = {MAX_MATCH_DISTANCE:.2f})."
        )
        return

    for match in matches:
        result = match["outcome"]
        if result.get("available_horizon") is not None:
            horizon = (
                f"{result.get('available_horizon')}/"
                f"{result.get('requested_horizon')}"
            )
        else:
            horizon = "n/a"

        same = " | same-dataset" if match.get("same_dataset") else ""

        print(
            f"  {match['episode_id']} | {match['symbol']} "
            f"| distance={match['distance']:.4f} "
            f"| Hamming={match['hamming']} "
            f"| shared={match['shared_features']} "
            f"| {match['compatibility']}{same}"
        )
        print(
            f"    outcome={result.get('status')} ({horizon}) "
            f"| tags={result.get('outcome_tags') or ['none']}"
        )

    complete = sum(
        1
        for match in matches
        if match["outcome"].get("status") == "complete"
    )
    print(
        f"  Complete outcomes among matches: {complete}/{len(matches)}. "
        "Similarity is not a forecast, and a passing threshold does "
        "not imply that outcomes will match."
    )


def build_episode(dataset, index, features, dna,
                  config_hash_value, data_hash, archive, config):
    key = make_episode_key(dataset, index, config_hash_value)

    episode = {
        "episode_id": f"{key[:10]}-P{index + 1:03d}",
        "episode_key": key,
        "dataset_hash": data_hash,
        "config_hash": config_hash_value,
        "version": VERSION,
        "symbol": dataset["symbol"],
        "timeframe": dataset["timeframe"],
        "price_field": dataset["price_field"],
        "observation_number": index + 1,
        "price": dataset["prices"][index],
        "features": features,
        "fingerprint": build_fingerprint(features),
        "dna": dna,
        "flags": decode_dna(dna),
        "event_annotation_mode": (
            "contemporaneous"
            if features.get("event_context")
            else None
        ),
        "outcome": calculate_outcome(
            dataset["prices"], index, features, config
        ),
    }

    episode["historical_matches"] = historical_matches(
        episode, archive, config
    )
    return episode


def run_research(dataset):
    validate_dataset(dataset)

    prices = dataset["prices"]
    contemporaneous = get_contemporaneous_positions(dataset)
    config = dict(DEFAULT_CONFIG)

    config_digest = config_hash(config)
    data_digest = dataset["dataset_hash"]

    archive_data = read_json(ARCHIVE_FILE, {"episodes": []})
    archive = archive_data.get("episodes", [])

    print("\n" + "=" * 66)
    print(f"{VERSION} — HISTORICAL RESEARCH REPORT")
    print("=" * 66)
    print(
        f"Instrument: {dataset['symbol']} "
        f"| Timeframe: {dataset['timeframe']} "
        f"| Field: {dataset['price_field']}"
    )
    print(
        f"Observations: {len(prices)} "
        f"| Contemporaneous markers: "
        f"{sorted(contemporaneous) if contemporaneous else 'None'}"
    )
    print(
        f"Dataset hash: {data_digest} | Config hash: {config_digest}"
    )

    states = []
    episodes = []

    for index in range(len(prices)):
        features = calculate_features(prices, index, config)
        if features is None:
            continue
        features["event_context"] = (
            index + 1
        ) in contemporaneous
        dna = build_dna(features, contemporaneous, config)
        states.append({
            "index": index,
            "price": prices[index],
            "features": features,
            "dna": dna,
            "flags": decode_dna(dna),
            "fingerprint": build_fingerprint(features),
        })
        if dna & DNA_FLAGS["DISPLACEMENT"]:
            episodes.append(
                build_episode(
                    dataset, index, features, dna,
                    config_digest, data_digest, archive, config,
                )
            )

    print(f"\nStates reconstructed: {len(states)}")
    print(f"Displacement episodes: {len(episodes)}")

    if not episodes:
        print(
            "No observations crossed the current displacement "
            "threshold. This is a valid result."
        )

    for number, episode in enumerate(episodes, 1):
        print_episode(number, episode)

    added, upgraded, unchanged, notes = merge_into_archive(
        archive, episodes
    )

    write_json(
        ARCHIVE_FILE,
        {"version": VERSION, "episodes": archive},
    )

    print(
        f"\nArchive update: {added} added, "
        f"{upgraded} outcome(s) upgraded, {unchanged} unchanged."
    )
    for note in notes:
        print("Note: " + note)

    report = {
        "version": VERSION,
        "run_utc": datetime.now(timezone.utc).isoformat(),
        "symbol": dataset["symbol"],
        "timeframe": dataset["timeframe"],
        "price_field": dataset["price_field"],
        "dataset_hash": data_digest,
        "config_hash": config_digest,
        "config": config,
        "event_annotation_mode": "per_marker",
        "contemporaneous_positions": sorted(contemporaneous),
        "observation_count": len(prices),
        "state_count": len(states),
        "episode_count": len(episodes),
        "episodes": episodes,
        "states": [
            {
