def null_distance_probabilities():
    return tuple(ladder_count(k) / float(TOTAL) for k in range(R + 1))


def tilted_emissions(thetas=(-0.5, 0.0, 0.5)):
    """Null-nested emissions: B_s(k) proportional to p0(k)*exp(theta_s*k).
    theta = 0 reproduces the fair-lottery distance law exactly."""
    p0 = null_distance_probabilities()
    rows = []
    for th in thetas:
        raw = [p0[k] * math.exp(th * k) for k in range(R + 1)]
        z = sum(raw)
        rows.append(tuple(x / z for x in raw))
    return tuple(rows)


