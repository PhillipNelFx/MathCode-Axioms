def require_history(draws, exact=None, minimum=None):
    history = [canon(d) for d in draws]
    if exact is not None and len(history) != exact:
        raise ValueError("Exactly {} chronological draws are required.".format(exact))
    if minimum is not None and len(history) < minimum:
        raise ValueError("At least {} chronological draws are required.".format(minimum))
    return history


def recency_weights(length=HISTORY_SIZE, half_life=RECENCY_HALF_LIFE):
    if length < 1 or half_life <= 0:
        raise ValueError("Length and half-life must be positive.")
    raw = [2.0 ** (-(length - 1 - i) / float(half_life))
           for i in range(length)]
    total = sum(raw)
    return tuple(x / total for x in raw)


def generate_radius_neighbourhood(anchor, radius=CANDIDATE_RADIUS):
    """Yield unique states within Johnson distance <= radius of anchor."""
    anchor = canon(anchor)
    if not isinstance(radius, int) or radius < 0 or radius > R:
        raise ValueError("Radius must be an integer from 0 to 5.")
    selected = set(anchor)
    outside = [v for v in range(1, N + 1) if v not in selected]
    yield anchor
    for distance in range(1, radius + 1):
        for removed in itertools.combinations(anchor, distance):
            remaining = selected.difference(removed)
            for added in itertools.combinations(outside, distance):
                yield tuple(sorted(remaining.union(added)))


def radius_ball_size(radius=CANDIDATE_RADIUS):
    return sum(ladder_count(k) for k in range(radius + 1))


def generate_candidates(history, radius=CANDIDATE_RADIUS):
    """Union radius-r neighbourhoods; masks deduplicate states and track anchors."""
    history = require_history(history, exact=HISTORY_SIZE)
    anchor_indices = defaultdict(list)
    for index, anchor in enumerate(history):
        for candidate in generate_radius_neighbourhood(anchor, radius):
            cm = mask(candidate)
            if not anchor_indices[cm] or anchor_indices[cm][-1] != index:
                anchor_indices[cm].append(index)
    return anchor_indices


def structural_candidate_rows(history, candidate_map, half_life=RECENCY_HALF_LIFE):
    """Return rows with structural metrics; compatibility is not probability."""
    history = require_history(history, exact=HISTORY_SIZE)
    weights = recency_weights(len(history), half_life)
    rows = []
    for cm, anchors in candidate_map.items():
        candidate = decode_mask(cm)
        distances = [jdist(candidate, d) for d in history]
        j_weighted = sum(w * d / float(R) for w, d in zip(weights, distances))
        g_weighted = sum(w * gapdist(candidate, d) for w, d in zip(weights, history))
        s_weighted = sum(w * sumdist(candidate, d) for w, d in zip(weights, history))
        r_weighted = sum(w * rangedist(candidate, d) for w, d in zip(weights, history))
        weighted_distance = (0.70*j_weighted + 0.15*g_weighted
                             + 0.10*s_weighted + 0.05*r_weighted)
        rows.append({
            "draw": candidate,
            "mask": cm,
            "anchor_count": len(anchors),
            "anchor_indices": tuple(anchors),
            "anchor_recurrence": len(anchors) / float(HISTORY_SIZE),
            "min_j": min(distances),
            "mean_j": sum(distances) / float(HISTORY_SIZE),
            "weighted_distance": weighted_distance,
            "structural_score": 1.0 - weighted_distance
        })
    rows.sort(key=lambda x: (
        -x["structural_score"], -x["anchor_count"],
        x["weighted_distance"], x["min_j"], x["draw"]))
    return rows


# ------------------------------ CTDM (Engine B) ------------------------------

def ctdm_fit(history, kappa=CTDM_KAPPA):
    """Null-centred Dirichlet posterior predictive for categorical J-distance.
    Prior = Dirichlet(kappa * p0); predictive_k = (n_k + kappa*p0_k)/(n + kappa)."""
    history = require_history(history, exact=HISTORY_SIZE)
    if kappa <= 0:
        raise ValueError("CTDM kappa must be positive.")
    distances = [jdist(history[i], history[i+1])
                 for i in range(len(history)-1)]
    counts = Counter(distances)
    p0 = null_distance_probabilities()
    predictive = tuple(
        (counts[k] + kappa*p0[k]) / (len(distances) + kappa)
        for k in range(R+1)
    )
    if not math.isclose(sum(predictive), 1.0, abs_tol=1e-12):
        raise AssertionError("CTDM predictive probabilities do not sum to one.")
    return {
        "distances": tuple(distances),
        "counts": tuple(counts[k] for k in range(R+1)),
        "null": p0,
        "predictive": predictive,
        "kappa": kappa
    }


def ctdm_shell_table(ctdm):
    """Per-shell predictive mass, per-state probability and lift over null.
    Within a J-shell every state shares q_k / |shell_k|, so the state
    probabilities sum to one over the FULL universe (not just candidates)."""
    rows = []
    for k in range(R + 1):
        q, p0 = ctdm["predictive"][k], ctdm["null"][k]
        rows.append({
            "k": k, "shell_size": ladder_count(k), "null_mass": p0,
            "mass": q, "per_state": q / ladder_count(k),
            "lift": q / p0
        })
    return rows


def ctdm_log_bayes_factor(counts, kappa=CTDM_KAPPA):
    """log[ Dirichlet-multinomial marginal / null-multinomial ] for one fixed
    ordered sequence of distances. Under the null, E[BF] = 1, so log BF is
    typically negative; values near 0 or below mean no evidence for structure."""
    p0 = null_distance_probabilities()
    n = sum(counts)
    log_m = math.lgamma(kappa) - math.lgamma(kappa + n)
    for k in range(R + 1):
        a = kappa * p0[k]
        log_m += math.lgamma(a + counts[k]) - math.lgamma(a)
    log_null = sum(counts[k] * math.log(p0[k]) for k in range(R + 1))
    return log_m - log_null


# ------------------------------ HMM (Engine C) ------------------------------

def validate_probability_vector(values, length, label):
    if len(values) != length or any(x < 0 for x in values):
        raise ValueError(label + " has invalid dimensions or negative values.")
    if not math.isclose(sum(values), 1.0, abs_tol=1e-10):
        raise ValueError(label + " must sum to one.")


def validate_hmm_parameters(pi=HMM_PI, transition=HMM_A, emission=HMM_B):
    validate_probability_vector(pi, 3, "HMM initial distribution")
    if len(transition) != 3 or len(emission) != 3:
        raise ValueError("HMM requires three transition and emission rows.")
    for row in transition:
        validate_probability_vector(row, 3, "HMM transition row")
    for row in emission:
        validate_probability_vector(row, 6, "HMM emission row")
    means = [sum(k*p for k, p in enumerate(row)) for row in emission]
    if not (means[0] < means[1] < means[2]):
        raise ValueError("HMM emission means must order COMPACT < MODERATE < DISPERSED.")
    return True


def hmm_forward(observations, pi=HMM_PI, transition=HMM_A, emission=HMM_B):
    """Scaled forward recursion; parameters are illustrative and not estimated."""
    validate_hmm_parameters(pi, transition, emission)
    if not observations or any(not isinstance(x, int) or x < 0 or x > 5
                               for x in observations):
        raise ValueError("HMM observations must be a non-empty sequence in 0..5.")
    alpha = [pi[i] * emission[i][observations[0]] for i in range(3)]
    scale = sum(alpha)
    if scale <= 0:
        raise ValueError("HMM sequence has zero likelihood.")
    log_likelihood = math.log(scale)
    alpha = [x / scale for x in alpha]
    for observation in observations[1:]:
        nxt = [
            emission[j][observation] *
            sum(alpha[i] * transition[i][j] for i in range(3))
            for j in range(3)
        ]
        scale = sum(nxt)
        if scale <= 0:
            raise ValueError("HMM sequence has zero likelihood.")
        log_likelihood += math.log(scale)
        alpha = [x / scale for x in nxt]
    posterior_last = tuple(alpha)
    next_regime = tuple(
        sum(posterior_last[i] * transition[i][j] for i in range(3))
        for j in range(3)
    )
    next_observation = tuple(
        sum(next_regime[j] * emission[j][k] for j in range(3))
        for k in range(6)
    )
    return {
        "log_likelihood": log_likelihood,
        "last_regime_posterior": posterior_last,
        "next_regime": next_regime,
        "next_distance": next_observation
    }


def hmm_log_bayes_vs_null(observations, **kw):
    """Log-likelihood ratio of the HMM against the iid null distance law."""
    p0 = null_distance_probabilities()
    hmm = hmm_forward(observations, **kw)
    return hmm["log_likelihood"] - sum(math.log(p0[k]) for k in observations)


# --------------------- STRUCTURAL SCORING OVER THE UNIVERSE ---------------------

def make_structural_scorer(history, half_life=RECENCY_HALF_LIFE):
    """Fast weighted composite distance for any VALID SORTED 5-tuple.
    Identical formula to structural_candidate_rows (verified in verify_v04)."""
    history = require_history(history, exact=HISTORY_SIZE)
    weights = recency_weights(len(history), half_life)
    a_j, a_g, a_s, a_r = STRUCT_WEIGHTS
    hm = [mask(d) for d in history]
    hg = [gaps(d) for d in history]
    hs = [sum(d) for d in history]
    hr = [rangesig(d) for d in history]
    packed = list(zip(weights, hm, hg, hs, hr))

    def weighted_distance(c):
        cm = 0
        for v in c:
            cm |= 1 << (v - 1)
        g0, g1, g2, g3, g4, g5 = (c[0]-1, c[1]-c[0]-1, c[2]-c[1]-1,
                                  c[3]-c[2]-1, c[4]-c[3]-1, N-c[4])
        s = c[0]+c[1]+c[2]+c[3]+c[4]
        r0 = r1 = 0
        for v in c:
            if v <= 12:
                r0 += 1
            elif v <= 24:
                r1 += 1
        r2 = R - r0 - r1
        total = 0.0
        for w, m, g, hsum, rr in packed:
            j = (R - bin(cm & m).count("1")) / float(R)
            gd = (abs(g0-g[0]) + abs(g1-g[1]) + abs(g2-g[2]) +
                  abs(g3-g[3]) + abs(g4-g[4]) + abs(g5-g[5])) / 62.0
            sd = abs(s - hsum) / 155.0
            rd = (abs(r0-rr[0]) + abs(r1-rr[1]) + abs(r2-rr[2])) / 10.0
            total += w * (a_j*j + a_g*gd + a_s*sd + a_r*rd)
        return total
    return weighted_distance


def structural_percentile(history, realised, sample=None, rng=None,
                          half_life=RECENCY_HALF_LIFE, show_progress=False):
    """Mid-rank percentile u of `realised` among states ranked by structural
    score. u near 0 = near the top of the ranking; under the fair-lottery null
    (realised independent of history) u is uniform on (0,1).
    sample=None scores all 376,992 states exactly; otherwise a Monte-Carlo
    sample of that many random states (standard error ~ sqrt(u(1-u)/sample))."""
    scorer = make_structural_scorer(history, half_life)
    realised = canon(realised)
    target = scorer(realised)
    eps = 1e-12
    better = ties = 0
    if sample is None:
        total = TOTAL
        for i, c in enumerate(universe()):
            d = scorer(c)
            if d < target - eps:
                better += 1
            elif d <= target + eps:
                ties += 1
            if show_progress and i and i % 50000 == 0:
                print("  scored {:,} / {:,}".format(i, TOTAL))
        rank_best, rank_worst = better + 1, better + ties
    else:
        rng = rng or random.Random()
        total = sample
        for _ in range(sample):
            c = tuple(sorted(rng.sample(range(1, N + 1), R)))
            d = scorer(c)
            if d < target - eps:
                better += 1
            elif d <= target + eps:
                ties += 1
        rank_best = rank_worst = None
    u = (better + 0.5 * ties) / float(total)
    return {"score": 1.0 - target, "weighted_distance": target, "u": u,
            "rank_best": rank_best, "rank_worst": rank_worst,
            "better": better, "ties": ties, "total": total}


