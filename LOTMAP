def simulate():
    raw = input("Number of independent pairs (default 10000, max 2000000): ").strip()
    try:
        n = int(raw) if raw else 10000
        if not 1 <= n <= 2000000:
            raise ValueError
    except ValueError:
        print("Enter an integer from 1 to 2,000,000.")
        return
    rng, observed = random.Random(), Counter()
    for _ in range(n):
        a = tuple(sorted(rng.sample(range(1,N+1), R)))
        b = tuple(sorted(rng.sample(range(1,N+1), R)))
        observed[jdist(a,b)] += 1
    print("\nSIMULATION: {:,} independent pairs".format(n))
    print("d | Simulated | Expected | Difference")
    for d, count, p in ladder():
        expected = n*p
        print("{} | {} | {:.1f} | {:+.1f}".format(
            d, observed[d], expected, observed[d]-expected))
    print("Simulation tests the null model; it does not forecast draws.")


