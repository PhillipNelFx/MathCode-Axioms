ANIMATE = True   # set False if your terminal shows broken progress lines


def format_seconds(seconds):
    seconds = int(max(0, round(seconds)))
    return "{}m{:02d}s".format(seconds // 60, seconds % 60)


class ProgressBar(object):
    """Live spinner + bar + elapsed + ETA. ETA = elapsed * (1 - f) / f, where f
    is the completed fraction. Lines stay under ~40 characters so they do not
    wrap on a narrow phone terminal (wrapping would break the carriage return)."""
    FRAMES = "|/-\\"

    def __init__(self, total, animate=True, width=10):
        self.total = float(total)
        self.animate = animate
        self.width = width
        self.start = time.time()
        self.last = 0.0
        self.prev_len = 0

    def update(self, done, force=False):
        now = time.time()
        if not force and now - self.last < 0.2:
            return
        self.last = now
        frac = max(0.0, min(1.0, done / self.total))
        elapsed = now - self.start
        eta = elapsed * (1.0 - frac) / frac if frac > 0.002 else None
        filled = int(round(frac * self.width))
        line = "{} [{}] {:3d}% {} ETA {}".format(
            self.FRAMES[int(now * 6) % 4],
            "#" * filled + "-" * (self.width - filled),
            int(frac * 100), format_seconds(elapsed),
            format_seconds(eta) if eta is not None else "...")
        if self.animate:
            pad = " " * max(0, self.prev_len - len(line))
            sys.stdout.write("\r" + line + pad)
            sys.stdout.flush()
            self.prev_len = len(line)
        elif force:
            print(line)

    def finish(self):
        self.update(self.total, force=True)
        if self.animate:
            sys.stdout.write("\n")
            sys.stdout.flush()


def null_top_score_fast(history, candidate_map, tick=None):
    """Top structural score via the verified fast scorer. Mathematically equal
    to structural_candidate_rows(...)[0]['structural_score'] (see verify_v03)."""
    scorer = make_structural_scorer(history)
    best = None
    count = len(candidate_map)
    for i, cm in enumerate(candidate_map):
        d = scorer(decode_mask(cm))
        if best is None or d < best:
            best = d
        if tick is not None and i % 1500 == 0:
            tick(i / float(count))
    return 1.0 - best


def full_pipeline_null_simulation(repetitions=100, seed=None, animate=None):
    """Run candidate extraction and structural scoring on independent
    ten-draw null histories. Reports candidate count and top structural score.
    Shows a live progress bar so a long run is visibly alive."""
    if not isinstance(repetitions, int) or not 1 <= repetitions <= 2000:
        raise ValueError("Repetitions must be an integer from 1 to 2,000.")
    animate = ANIMATE if animate is None else animate
    rng = random.Random(seed)
    candidate_counts, top_scores, max_recurrences = [], [], []
    print("\nRunning {:,} null replications...".format(repetitions))
    bar = ProgressBar(repetitions, animate)
    bar.update(0, force=True)
    for rep in range(repetitions):
        history = [tuple(sorted(rng.sample(range(1, N+1), R)))
                   for _ in range(HISTORY_SIZE)]
        cmap = generate_candidates(history)
        top = null_top_score_fast(
            history, cmap, tick=lambda f, r=rep: bar.update(r + f))
        candidate_counts.append(len(cmap))
        top_scores.append(top)
        max_recurrences.append(max(len(v) for v in cmap.values()))
        bar.update(rep + 1, force=not animate)
    bar.finish()
    candidate_counts.sort()
    top_scores.sort()
    max_recurrences.sort()

    def quantile(values, q):
        index = int(round((len(values)-1)*q))
        return values[index]

    print("\nFULL-PIPELINE INDEPENDENT-UNIFORM NULL SIMULATION")
    print("Replications: {:,} | Seed: {}".format(repetitions, seed))
    print("Candidate count: mean {:.1f}; 5%-95% interval [{}, {}]".format(
        sum(candidate_counts)/float(repetitions),
        quantile(candidate_counts, 0.05), quantile(candidate_counts, 0.95)))
    print("Maximum recurrence: mean {:.3f}; 5%-95% interval [{}, {}]".format(
        sum(max_recurrences)/float(repetitions),
        quantile(max_recurrences, 0.05), quantile(max_recurrences, 0.95)))
    print("Top structural score: mean {:.6f}; 5%-95% interval [{:.6f}, {:.6f}]".format(
        sum(top_scores)/float(repetitions),
        quantile(top_scores, 0.05), quantile(top_scores, 0.95)))
    print("These are null reference distributions, not evidence of predictability.")
    return {"candidate_counts": candidate_counts, "top_scores": top_scores,
            "max_recurrences": max_recurrences}


def rolling_origin_backtest(draws, top_k=100):
    """Original top-K hit test (kept). Null hit rate is only K/376,992, so
    this needs thousands of windows to say anything; prefer option 12."""
    history = require_history(draws, minimum=HISTORY_SIZE + 1)
    if not isinstance(top_k, int) or top_k < 1:
        raise ValueError("Top K must be a positive integer.")
    results = []
    for target_index in range(HISTORY_SIZE, len(history)):
        training = history[target_index-HISTORY_SIZE:target_index]
        held_out = history[target_index]
        cmap = generate_candidates(training)
        rows = structural_candidate_rows(training, cmap)
        top = rows[:top_k]
        hit = any(row["draw"] == held_out for row in top)
        results.append({
            "target_index": target_index, "held_out": held_out,
            "candidate_count": len(cmap), "hit": hit,
            "rank": next((i+1 for i, row in enumerate(rows)
                          if row["draw"] == held_out), None)
        })
    hits = sum(1 for row in results if row["hit"])
    print("\nROLLING-ORIGIN TOP-K TEST")
    print("Top K: {} | Evaluation windows: {}".format(top_k, len(results)))
    for row in results:
        print("Target draw {}: {} | candidates {:,} | rank {} | {}".format(
            row["target_index"]+1, row["held_out"], row["candidate_count"],
            row["rank"] if row["rank"] is not None else "OUTSIDE CANDIDATES",
            "HIT" if row["hit"] else "MISS"))
    print("Hits: {}/{} ({:.2%})".format(hits, len(results), hits/float(len(results))))
    print("Null hit rate for K unique candidates: K/{:,} = {:.6%}".format(
        TOTAL, min(top_k, TOTAL)/float(TOTAL)))
    return results


def ks_statistic(values):
    xs = sorted(values)
    n = len(xs)
    return max(max((i+1)/float(n) - x, x - i/float(n)) for i, x in enumerate(xs))


def rolling_origin_percentile(draws, sample=20000, seed=None):
    """Percentile (PIT) backtest. For every window: rank the NEXT draw among all
    states by structural score (Monte-Carlo sample), and score CTDM/HMM on the
    realised distance. Under the fair-lottery null each u is i.i.d. uniform, so
    the mean-u z-test and KS test are valid even with overlapping windows."""
    history = require_history(draws, minimum=HISTORY_SIZE + 1)
    rng = random.Random(seed)
    p0 = null_distance_probabilities()
    us, ctdm_ll, hmm_ll, retrieved = [], [], [], 0
    print("\nROLLING-ORIGIN PERCENTILE TEST (sample {:,} states per window)".format(sample))
    for t in range(HISTORY_SIZE, len(history)):
        training = history[t-HISTORY_SIZE:t]
        held = history[t]
        res = structural_percentile(training, held, sample=sample, rng=rng)
        k = jdist(training[-1], held)
        ctdm = ctdm_fit(training)
        c_lift = ctdm["predictive"][k] / p0[k]
        h = hmm_forward(ctdm["distances"])
        h_lift = h["next_distance"][k] / p0[k]
        in_c = mask(held) in generate_candidates(training)
        retrieved += 1 if in_c else 0
        us.append(res["u"])
        ctdm_ll.append(math.log(c_lift))
        hmm_ll.append(math.log(h_lift))
        print("Draw {}: u={:.3f} | J={} | in candidates: {} | CTDM log-lift {:+.3f} | HMM {:+.3f}".format(
            t+1, res["u"], k, "Y" if in_c else "N", ctdm_ll[-1], hmm_ll[-1]))
    n = len(us)
    mean_u = sum(us)/float(n)
    z = (mean_u - 0.5) / math.sqrt(1.0/12.0/n)
    print("\nWindows: {}".format(n))
    print("Mean u: {:.4f} (null 0.5000, z = {:+.2f}); u < 0.5 means better than chance".format(mean_u, z))
    print("KS distance to uniform: {:.4f} (approx 5% critical value {:.4f})".format(
        ks_statistic(us), 1.36/math.sqrt(n)))
    print("Candidate-set retrieval: {}/{} ({:.1%}); null expectation about 12%".format(
        retrieved, n, retrieved/float(n)))
    print("Mean CTDM log-lift: {:+.4f} | Mean HMM log-lift: {:+.4f}".format(
        sum(ctdm_ll)/n, sum(hmm_ll)/n))
    print("Under the null the expected log-lift is <= 0 (it equals minus KL).")
    print("Positive means across many windows would be the first sign of structure.")
    return {"u": us, "ctdm": ctdm_ll, "hmm": hmm_ll}


