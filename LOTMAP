def analyse(draws, label="HISTORICAL TRANSITIONS"):
    history = [canon(x) for x in draws]
    print("\n" + label)
    if len(history) < 2:
        print("Enter at least two draws.")
        return
    observed = Counter()
    print("Index | Previous -> Current | J-distance | Shared | Out | In")
    for i in range(1, len(history)):
        a, b = history[i-1], history[i]
        shared = sorted(set(a) & set(b))
        out = sorted(set(a) - set(b))
        incoming = sorted(set(b) - set(a))
        d = jdist(a, b)
        observed[d] += 1
        print("{} | {} -> {} | {} | {} | {} | {}".format(
            i, a, b, d, shared, out, incoming))
    ntrans = len(history)-1
    print("\nObserved vs independent-uniform theoretical baseline")
    print("d | Observed | Expected count | Theoretical probability")
    for d, count, p in ladder():
        print("{} | {} | {:.3f} | {:.6%}".format(
            d, observed[d], ntrans*p, p))
    print("Expected counts are a null-model reference, not predictions.")


def read_draw(prompt):
    raw = input(prompt).strip().replace(",", " ")
    return canon([int(v) for v in raw.split()])


def read_draw_list(minimum_note, limit=None):
    print(minimum_note)
    draws = []
    while limit is None or len(draws) < limit:
        raw = input("Draw {} (blank ends): ".format(len(draws)+1)).strip()
        if not raw:
            break
        try:
            draws.append(canon([int(v) for v in raw.replace(",", " ").split()]))
        except ValueError as e:
            print("Invalid draw:", e)
    return draws


def enter_history():
