# Unchanged definitions and formulas.

def canon(draw):
    x = tuple(draw)
    if len(x) != R or any(not isinstance(v, int) for v in x):
        raise ValueError("Enter exactly five integers.")
    if len(set(x)) != R:
        raise ValueError("Numbers must be distinct.")
    if any(v < 1 or v > N for v in x):
        raise ValueError("Numbers must be from 1 to 36.")
    return tuple(sorted(x))


def universe():
    return itertools.combinations(range(1, N + 1), R)


def mask(draw):
    m = 0
    for v in canon(draw):
        m |= 1 << (v - 1)
    return m


def decode_mask(m):
    if not isinstance(m, int) or m < 0 or m >= (1 << N):
        raise ValueError("Invalid 36-bit mask.")
    if bin(m).count("1") != R:
        raise ValueError("A state mask must have exactly five set bits.")
    return tuple(i + 1 for i in range(N) if (m >> i) & 1)


def gaps(draw):
    x = canon(draw)
    return ((x[0] - 1,) +
            tuple(x[i] - x[i - 1] - 1 for i in range(1, R)) +
            (N - x[-1],))


def from_gaps(g):
    if len(g) != R + 1 or any(not isinstance(v, int) or v < 0 for v in g):
        raise ValueError("A gap vector needs six non-negative integers.")
    if sum(g) != N - R:
        raise ValueError("Gap components must sum to 31.")
    x = [1 + g[0]]
    for v in g[1:-1]:
        x.append(x[-1] + v + 1)
    return canon(x)


def jdist(a, b):
    return R - bin(mask(a) & mask(b)).count("1")


def sumdist(a, b):
    return abs(sum(canon(a)) - sum(canon(b))) / 155.0


def gapdist(a, b):
    return sum(abs(x-y) for x, y in zip(gaps(a), gaps(b))) / 62.0


def rangesig(draw):
    x = canon(draw)
    return (sum(1 <= v <= 12 for v in x),
            sum(13 <= v <= 24 for v in x),
            sum(25 <= v <= 36 for v in x))


def rangedist(a, b):
    x, y = rangesig(a), rangesig(b)
    return sum(abs(i-j) for i, j in zip(x, y)) / 10.0


def composite(a, b, weights=(0.70, 0.15, 0.10, 0.05)):
    alpha, beta, gamma, delta = weights
    if any(w < 0 for w in weights) or alpha <= 0:
        raise ValueError("Weights must be non-negative; alpha must be positive.")
    if not math.isclose(sum(weights), 1.0, abs_tol=1e-12):
        raise ValueError("Weights must sum to one.")
    return (alpha*jdist(a, b)/R + beta*gapdist(a, b)
            + gamma*sumdist(a, b) + delta*rangedist(a, b))


def ladder_count(d):
    return math.comb(R, d) * math.comb(N-R, d) if 0 <= d <= R else 0


def ladder():
    return [(d, ladder_count(d), ladder_count(d)/TOTAL) for d in range(R+1)]


