        if qp is not None and ssv.get("zone_median_price") is not None:
            dist_pips=abs(qp-ssv["zone_median_price"])*10000 if qp<5 else abs(qp-ssv["zone_median_price"]); ssv["query_distance_pips"]=round(dist_pips,2); ssv["zone_width"]=0.01 if qp<5 else 0.1
        return ssv
    def commit_ssv(self,ssv):
