    def distance_map(self,zone,vf=None):
        zones=sorted({n.price_zone for n in self.nodes.values() if n.price_zone!="Z?"},key=_zone_val)
        if zone not in zones: return {}
        vf=vf or self.vector_field(); att=[z for z in zones if vf.get(z,{}).get("classification")=="attractor"]; rep=[z for z in zones if vf.get(z,{}).get("classification")=="repeller"]; zd=lambda z:abs(zones.index(z)-zones.index(zone)); path,cur=[],zone
        for _ in range(10):
            if cur in path: break
            path.append(cur)
            if vf.get(cur,{}).get("classification")=="attractor": break
            pr=self.ct.probs(cur)
            if not pr: break
            cur=max(pr,key=pr.get)
        return {"current_zone":zone,"nearest_attractor":min(att,key=zd,default=None),"nearest_repeller":min(rep,key=zd,default=None),"path_to_equilibrium":path,"equilibrium_steps":len(path)-1}
    def structural_report(self,query):
        if not self.nodes: return " No data loaded."
        results=self.search(query)
        if not results: return " No matches found"
        nmd=self._nmd_summary(results); vf=self.vector_field(); _qp,_=extract_price(query); ssv=self.build_ssv([dict(r) for r in results],vf,commit=False,query_price=_qp); zone=ssv["observed_zone"]; dmap=self.distance_map(zone,vf)
        L=[]; W=56; rule=lambda c="-":L.append(" "+c*W); hdr=lambda t:L.extend([f" ╔{'='*W}╗",f" ║ {t:<{W-2}}║",f" ╚{'='*W}╝"])
        def sec(t): L.append(""); rule(); L.append(f" {t} [Axiomatic]"); rule()
        def row(k,v,w=20): L.append(f" {k:<{w}} {v}")
        bar=lambda p,k=24:"█"*int(p*k); hdr(f"{VERSION} - LATENT STATE RECONSTRUCTION"); L+=[f" Query : {query}",f" Zone : {zone} - Price: {ssv['observed_price']}",f" Match : {CONFIDENCE_DISPLAY.get(ssv['match_confidence'],ssv['match_confidence'])}"]
        if ssv.get("query_distance_pips") is not None: L.append(f" Query distance to zone median: {ssv['query_distance_pips']:.2f} pips (zone width approx {ssv.get('zone_width')} - tight similarity vol explains WEAK MATCH when off-centre)")
        rsa=ssv["regime_shift_alert"]
        if rsa["active"]: L+=["",f" REGIME SHIFT {rsa['message']}"]
        sec("MATCH SCORES")
        for i,r in enumerate(results[:5],1):
            px=f"px={r['price']:.4f}" if r.get("price") else ""; bs=f"+{r['boost']:.3f}" if r["boost"]>0 else ""; L.append(f" {i}. {r['value']:<22} {r['display']:.4f} base={r['base']:.3f} {bs} [{r['zone']}] {px}")
        sec("NMD HYPOTHESIS SPACE"); row("Entropy (normalized)",f"{nmd['entropy']:.2f} ({nmd['entropy_label']}) [0=dominated, 1=fully competitive]"); row("Hypotheses examined",str(nmd["hypothesis_count"])); row("Dominant score",f"{nmd['dominant_score']:.4f}"); row("Second score",f"{nmd['second_score']:.4f}"); row("Score spread",f"{nmd['spread']:.4f}")
        sec("LATENT STATE RECONSTRUCTION"); row("Zone",f"{zone} ({ssv['zone_classification']})"); row("Internal regime",ssv["internal_regime"]); row("Local density",f"{ssv['local_density']} nodes"); row("Zone median price",f"{ssv['zone_median_price']:.4f}" if ssv.get("zone_median_price") else "N/A"); row("Recent activity",f"{fmt_age(ssv['zone_recent_activity'])} ago" if ssv.get("zone_recent_activity") else "N/A"); row("Dominant exit",f"{ssv['dominant_exit']} ({int(ssv['exit_probability']*100)}% {ssv['exit_direction']})" if ssv.get("dominant_exit") else "None"); row("Avg exit time",f"{ssv['avg_exit_time']} steps" if ssv.get("avg_exit_time") else "N/A"); row("Recon confidence",ssv["reconstruction_confidence"]); L.append(""); L.append(f" FORWARD TRACE (arrival depth={ssv['arrival_depth']}, horizon={ssv['reliable_horizon']} [informational])")
        dists=ssv["fwd_distributions"]
        for i,hd in enumerate(dists[1:],1):
            items=sorted(hd.items(),key=lambda x:x[1],reverse=True); spread=items[0][1]-(items[1][1] if len(items)>1 else 0.0); st=lambda p:"RECONSTRUCTION" if p>=cfg.FWD_RECON_PROB_THRESHOLD else "SPECULATIVE"
            if len(items)>1 and spread<cfg.FWD_BRANCH_SPREAD_THRESHOLD: L.append(f" HOP {i} BRANCH POINT (spread={spread:.3f})")
            for z,p in items: L.append(f" -> {z:<12} prob={p:.3f} [{st(p)}] {bar(p,20)}")
        if len(dists)<=1: L.append(" (insufficient transition history)")
        sec("SENSORS"); ema=ssv["ema_sensor"]
        if ema.get("available"):
            row("EMA value",f"{ema['ema_value']:.4f} (period {ema['ema_period']})"); row("Deviation",f"{ema['current_deviation']:+.4f} [{ema['classification']}]"); row("Deviation pct",f"{ema['deviation_percentile']:.2f}"); row("Reversion prob",f"{ema['reversion_probability']:.2f}"); L.append(" EMA BANDS:")
            f2=lambda v:f"{v:.2f}" if v is not None else "N/A"
            for bn in ("near","moderate","extended"):
                b=ema["bands"].get(bn,{})
                if b.get("episodes"): L.append(f" {bn:<10} ep={b['episodes']} rev={f2(b['reversion_prob'])} cont={f2(b['continuation_prob'])}")
        else: row("EMA",ema.get("message","not available"))
        L.append(""); conv=ssv["convergence_sensor"]
        if conv.get("available"): row("Convergence",f"{conv['classification']} (Z={conv['anomaly_z']:.2f})"); row("Agreement",f"{conv['pairwise_agreement']:.2f} eff={conv['effective_strength']:.2f}"); row("Direction",conv["direction"]); L+=[f" {conv['interpretation']}"," Sensor breakdown:"]
        else: row("Convergence",conv.get("message","not available"))
        if conv.get("available"):
            for sd in conv["sensor_details"]: L.append(f" {sd['name']:<16} {sd['direction']} conf={sd['confidence']:.2f}")
        cis=ssv["cis_sensor"]; teps=len(self.cis_episodes); L.append(""); label="CIS (Contradiction Insight)"
        if cis.get("active"):
            if cis["mode"]=="instability": row(label,"STRUCTURAL INSTABILITY"); L.append(f" {cis['message']}")
            elif cis["mode"]=="historical_resolution": row(label,f"ACTIVE - direction {cis['direction']} conf={cis['confidence']:.2f}"); L.append(f" Mode: historical_resolution matches: {cis['match_count']} episodes entropy: {cis['entropy']:.2f}")
            else: row(label,"SILENT DISAGREEMENT (verbose on)"); L.append(f" {cis['note']}")
        else: row(label,f"learning - {cis.get('match_count',0)} similar episodes (need {cfg.CIS_MIN_MATCHES})" if cis.get("reason")=="insufficient_data" else f"no signal - {cis.get('reason','?')}")
        L.append(f" Contradiction strength: {cis.get('contradiction_strength',0):.2f} (threshold {cfg.CIS_CONTRADICTION_THRESHOLD}) episodes: {teps} pending: {self._cis_pending_n()}"); L.append(f" Component spread: {ssv['component_spread']:.2f} (threshold {cfg.CIS_COMPONENT_SPREAD_MIN}) component pending: {len(self.cis_pending['component'])}"); L.append(f" Memory maturity: {int(min(teps/cfg.CIS_MAX_EPISODES*100,100))}% ({teps}/{cfg.CIS_MAX_EPISODES} episodes)"); mir=self.mirror_analysis(); L.append(""); row("Mirror symmetry",f"{mir['similarity']:.2f} {mir['interpretation']}")
        if mir["best_match"]: row("Best pattern",f"{mir['best_match']} ({mir['matched_hits']}x)")
        if ssv["sensor_notes"]: sec("ALIGNMENT / CONTRADICTION"); L+=[f" {n}" for n in ssv["sensor_notes"]]
        if ssv["contradiction_strength"]>0.3: L+=["",f" Contradiction strength: {ssv['contradiction_strength']:.2f}"]
        if ssv["reconciliation_hint"]: L.append(f" Hint: {ssv['reconciliation_hint']}")
        epi=sorted(((n.value,lv,e.epistemic_weight,n.price_zone) for n in self.nodes.values() for lv,e in n.links.items() if e.epistemic_weight>0),key=lambda x:-x[2]); rel={zone,dmap.get("nearest_attractor"),dmap.get("nearest_repeller")} | set(dmap.get("path_to_equilibrium",[]))
        for hd in dists: rel.update(hd)
        local=[e for e in epi if e[3] in rel]; ae1="N/A"; margin=None
        if local:
