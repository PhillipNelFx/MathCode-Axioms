        if dom_z: dom_dir={1:"UP",-1:"DOWN",0:"FLAT"}[_sgn(_zone_val(dom_z)-_zone_val(zone))]; avg_st=self.ct.avg_steps(zone,dom_z)
        dna=self.dna_distribution(vf=vf,commit=commit); regime=an["regime"]; nd=vfz.get("net_direction",0.0); cls=vfz.get("classification","unknown"); qp=query_price if query_price is not None else top.get("price"); ema=self.ema_sensor(qp) if qp else {"available":False}
        part={"internal_regime":regime,"net_flow_direction":nd,"local_density":nc,"ema_sensor":ema,"fwd_distributions":fwd["distributions"],"observed_zone":zone,"exit_probability":dom_p}; conv=self.convergence_sensor(part); cs,ch=self._contradiction(regime,nd,cls,mir["similarity"],conv.get("anomaly_z")); cc=self._combined_conf(status,nc,dna.get("entropy",0.5),dna.get("epistemic",0.5),stab=dna.get("stability"),persist=dna.get("persistence",0)); comp=self._completion_hyp({"match_confidence":status,"local_density":nc,"zone_classification":cls,"exit_probability":dom_p,"dominant_exit":dom_z,"mirror_similarity":mir["similarity"],"dna_profile":dna,"contradiction_strength":cs,"fwd_structured":fwd["structured"]}); zn=[n for n in self.nodes.values() if n.price_zone==zone]; latest=max((n.created_at for n in zn),default=0); steps=[s for t in an["transitions"] if (s:=self.ct.avg_steps(zone,t))]; pers,pres,stab=dna.get("persistence",0),dna.get("pressure",1.0),dna.get("stability"); rsa={"active":False,"message":""}
        if pers==1 and pres>cfg.REGIME_SHIFT_PRESSURE_MIN and "dominant_state" in dna:
            if stab is not None and stab<0.5: rsa={"active":True,"message":f"DNA shifted to {dna['dominant_state']} (persist={pers} pressure={pres:.2f} stab={stab:.2f})"}
            elif stab is None: rsa={"active":True,"message":f"DNA first classified as {dna['dominant_state']}"}
        ssv={"observed_zone":zone,"observed_price":qp,"matched_node":top["value"],"match_confidence":status,"local_density":nc,"internal_regime":regime,"dominant_exit":dom_z,"exit_probability":dom_p,"exit_direction":dom_dir,"avg_exit_time":avg_st,"zone_classification":cls,"net_flow_direction":nd,"flow_magnitude":vfz.get("magnitude",0.0),"mirror_similarity":mir["similarity"],"fwd_flat":fwd["flat"],"fwd_structured":fwd["structured"],"fwd_distributions":fwd["distributions"],"arrival_depth":fwd["arrival_depth"],"reliable_horizon":fwd["reliable_horizon"],"dna_profile":dna,"contradiction_strength":cs,"reconciliation_hint":ch,"combined_confidence":cc,"zone_median_price":self.median_price(zone),"zone_avg_steps":round(sum(steps)/len(steps),2) if steps else None,"zone_recent_activity":round(time.time()-latest) if latest else None,"ema_sensor":ema,"convergence_sensor":conv,"regime_shift_alert":rsa,"dominant_pattern":dps[0].display if dps else "none","pattern_freq":int(round(dps[0].hits)) if dps else 0,"reconstruction_confidence":"HIGH" if nc>=10 else "MEDIUM" if nc>=4 else "LOW","completion_hypothesis":comp,"component_spread":round(max(cc[k] for k in ("match","density","entropy","epistemic","stability"))-min(cc[k] for k in ("match","density","entropy","epistemic","stability")),4)}
        cis=self._cis_sensor(ssv); ssv["cis_sensor"]=cis
        if cis.get("active") and cis.get("mode")=="historical_resolution": part["cis_sensor"]=cis; ssv["convergence_sensor"]=self.convergence_sensor(part)
        if commit: self._record_agreement(ssv["convergence_sensor"]); ssv["sensor_notes"]=self._sensor_notes(ssv); self._cis_schedule(ssv)
        else: ssv["sensor_notes"]=self._sensor_notes(ssv)
