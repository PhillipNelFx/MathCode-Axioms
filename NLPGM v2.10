#!/usr/bin/env python3
"""NLPGMv2.10 + FLSR v0.2 with Forward Trace - single file, very lean.
B writes, R reads (pure), L only on confirmed transitions, FLSR isolated. Only R and F provide forward traces.
Pure Python, zero deps. Full math preserved."""
import time, math, json, os, shutil, hashlib, re, cmath, random, copy
from dataclasses import dataclass
from itertools import combinations
VERSION="NLPGMv2.10"
@dataclass
class Config:
    LINK_THRESHOLD: float=0.30; GRAPH_BOOST: float=0.10; HOP2_DAMPEN: float=0.30
    DECAY_RATE: float=0.98; MIN_EDGE_STRENGTH: float=0.05; USAGE_BIAS: float=0.002
    REINFORCE_RATE: float=0.05; FREQ_BONUS: float=0.02; BATCH_LINK_STRENGTH: float=0.55
    BOOST_GATE_THRESHOLD: float=0.35; AGRR_MIN_STRENGTH: float=0.60
    RESONANCE_THRESHOLD: float=0.05; HUB_DEGREE_THRESHOLD: float=0.70; HUB_PENALTY_FACTOR: float=0.15
    COMPLEMENTARY_BOOST: float=1.25; SAME_TYPE_PENALTY: float=0.75; CROSS_ZONE_PENALTY: float=0.50
    W_NGRAM: float=0.26; W_PHONETIC: float=0.23; W_VECTOR: float=0.16; W_WORD_OVERLAP: float=0.10
    W_DNA_SIM: float=0.08; W_PRICE: float=0.17; W_PRICE_NUMERIC: float=0.85; W_DNA_NUMERIC: float=0.15
    CONFIDENCE_HIGH: float=0.70; CONFIDENCE_MEDIUM: float=0.40; CONFIDENCE_LOW: float=0.15; CONFIDENCE_NONE: float=0.10
    FOREX_VOL_RATIO: float=0.0002; MID_FOREX_VOL_RATIO: float=0.005; CRYPTO_VOL_RATIO: float=0.02
    GOLD_VOL_RATIO: float=0.01; DEFAULT_VOL_RATIO: float=0.01; EDGE_VOLATILITY_MULT: float=5.0
    MIN_SINGULARITY_LEN: int=3; BASE_SINGULARITY_WT: float=0.12; POSITION_PREFIX_WT: float=0.08; POSITION_SUFFIX_WT: float=0.06
    FINGERPRINT_K: int=8
    PATTERN_MIN_LENGTH: int=3; PATTERN_MAX_STORED: int=50; PATTERN_DECAY_RATE: float=0.90
    CLUSTER_TRANSITION_DECAY: float=0.99; MAX_TRANSITION_EXAMPLES: int=5
    MIRROR_WINDOW: int=10; MIRROR_SIMILARITY_THRESHOLD: float=0.60
    DNA_WINDOW: int=10; DNA_HISTORY_MAX: int=5
    EMA_PERIOD: int=50; EMA_BAND_NEAR_MAX: float=0.20; EMA_BAND_EXTENDED: float=0.70
    COMPLETION_WEIGHT_DIRECT: float=0.5; COMPLETION_WEIGHT_GRAPH: float=0.5
    CONVERGENCE_HISTORY_SIZE: int=20; REGIME_SHIFT_PRESSURE_MIN: float=0.7
    CIS_CONTRADICTION_THRESHOLD: float=0.3; CIS_MILD_TENSION_MIN: float=0.15; CIS_OUTCOME_STEPS: int=5
    CIS_MAX_EPISODES: int=50; CIS_DECAY_AGE_DAYS: float=30.0; CIS_MIN_MATCHES: int=3
    CIS_SIMILARITY_THRESHOLD: float=0.7; CIS_KERNEL_BETA: float=2.5; CIS_CONFIDENCE_CAP: float=0.85
    CIS_VERBOSE: bool=False; CIS_COMPONENT_SPREAD_MIN: float=0.35
    CIS_PRE_TRANSITION_CONTRADICTION_MIN: float=0.6; CIS_PRE_TRANSITION_STABILITY_MAX: float=0.3
    CIS_PRE_TRANSITION_PRESSURE_MIN: float=0.8
    NMD_TOPK: int=5; NMD_ENTROPY_LOW: float=0.4; NMD_ENTROPY_HIGH: float=0.7
    L_ALPHA: float=0.5; L_BETA: float=0.3; L_GAMMA: float=0.2
    FWD_RECON_PROB_THRESHOLD: float=0.4; FWD_BRANCH_SPREAD_THRESHOLD: float=0.15; FWD_MARGINAL_GAIN_MIN: float=0.15
    VF_REFRESH_INTERVAL: int=10
    SAVE_FILE: str="contacts.json"; BACKUP_FILE: str="contacts.json.bak"; TEMP_FILE: str="contacts.json.tmp"
cfg=Config()
FLSR_CFG={"SEED":42,"MAX_WINDOW":1024,"N_SURROGATES":100,"MIN_N":32,"BANDS":{"low":(0.00,0.15),"mid":(0.15,0.40),"high":(0.40,0.50)}}
CONFIDENCE_DISPLAY={"HIGH":"CONFIRMED MATCH","RESOLVED_MATCH":"RESOLVED MATCH","MEDIUM":"CONFIRM BEFORE ACTING","LOW":"WEAK MATCH - CAUTION","AMBIGUOUS":"MULTIPLE CANDIDATES","NO_MATCH":"NO MATCH","INVALID":"NO DATA"}
_ALPHA="ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789. "
_CHAR_NUM={c:i for i,c in enumerate(_ALPHA)}; _BASE=len(_ALPHA)
def _log(tag,msg): print(f" [{tag}] {msg}")
def _cmp(s): return s.replace(" ","").replace(".","")
def _sgn(x): return (x>0)-(x<0)
def _ov(a,b): return sum(1 for x,y in zip(a,b) if x==y)/max(len(a),len(b),1)
def _norm_entropy(p):
    n=len(p); return -sum(x*math.log(x) for x in p if x>0)/math.log(n) if n>1 else 0.0
def _median(v):
    if not v: return None
    m=len(v)//2; return v[m] if len(v)%2 else (v[m-1]+v[m])/2
def clean_text(t):
    if not t: return ""
    s=t.strip()
    if re.match(r'^\d+\.?\d*$',s): return s
    return "".join(c if c in _CHAR_NUM else " " for c in t.upper()).strip()
def _floor(x,k): return math.floor(x*k+1e-9)/k
def get_price_zone(p):
    if p is None: return "Z?"
    if p<5: return f"Z{_floor(p,100):.2f}"
    if p<200: return f"Z{_floor(p,10):.1f}"
    if p<50000: return f"Z{(int(p)//100)*100}"
    return f"Z{(int(p)//1000)*1000}"
def _zone_val(z):
    try: return float(z.replace("Z",""))
    except ValueError: return 0.0
def same_zone(a,b): return a is not None and b is not None and get_price_zone(a)==get_price_zone(b)
def extract_price(text):
    c=clean_text(text); price=None
    try: price=float(c)
    except ValueError:
        d=re.sub(r'[^0-9.]','',c)
        try: price=float(d) if d else None
        except ValueError: pass
    if price and price>0:
        r=(cfg.FOREX_VOL_RATIO if price<5 else cfg.MID_FOREX_VOL_RATIO if price<200 else cfg.CRYPTO_VOL_RATIO if price<10000 else cfg.GOLD_VOL_RATIO)
        return price,price*r
    return None,0.005
def _is_valid_price_line(s):
    # strict: only numeric lines accepted in B. Rejects TEXT, fences, headers.
    return bool(re.match(r'^-?\d+\.?\d*$',s.strip()))
def get_transition(pf,pt):
    if pf is None or pt is None: return None
    d=pt-pf; mag=abs(d); dr="UP" if d>0 else "DOWN" if d<0 else "FLAT"
    k=10000 if pf<5 else 10 if pf<200 else 1
    mr=round(mag*k)/k if k>1 else round(mag,1)
    return {"direction":dr,"magnitude":mr,"signature":f"{dr}_{int(mag*k+1e-9)}"}
def build_pattern_sig(seq):
    if len(seq)<cfg.PATTERN_MIN_LENGTH: return None
    return hashlib.sha256("->".join(seq).encode()).hexdigest()[:16]
def _vol(a,b,v): return v or (max(abs(a),abs(b))*cfg.DEFAULT_VOL_RATIO or 0.005)
def p_sim(a,b,v,mult=1.0):
    if a is None or b is None: return 0.0
    d=abs(a-b); return 1.0 if d==0 else math.exp(-d/(_vol(a,b,v)*mult))
def ep_sim(a,b,v): return p_sim(a,b,v,cfg.EDGE_VOLATILITY_MULT)
def fmt_age(s):
    for lim,div,u in ((60,1,"s"),(3600,60,"m"),(86400,3600,"h"),(604800,86400,"d")):
        if s<lim: return f"{int(s/div)}{u}"
    return f"{int(s/604800)}w"
def detect_regime(nodes):
    ns=sorted((n for n in nodes if n.price),key=lambda n:n.created_at)
    if len(ns)<2: return "SIDEWAYS"
    p=[n.price for n in ns]; h=len(p)//2; fa=sum(p[:h])/h; sa=sum(p[h:])/(len(p)-h)
    return "UP" if sa>fa*1.001 else "DOWN" if sa<fa*0.999 else "SIDEWAYS"
def expr_cat(text):
    w=text.upper().split(); u=text.upper(); hn=any(c.isdigit() for c in u); hl=any(c.isalpha() for c in u); cat=0
    if hn: cat|=2
    if any(any(c.isdigit() for c in x) and any(c.isalpha() for c in x) for x in w): cat|=1
    if any(len(x)>=3 and x.isalpha() for x in w): cat|=8
    if any(len(x)>=4 and x.endswith(("ER","OR","ING")) for x in w): cat|=4
    if hn and not hl: cat=2
    return cat or (2 if hn else 8)
def express_dna(text,links=None,strand=None,price=None):
    links=links or {}; cat=expr_cat(text); zone=get_price_zone(price) if price else "Z?"
    top=sorted(links.items(),key=lambda x:x[1].strength,reverse=True)[:cfg.FINGERPRINT_K]
    if top:
        fp=hashlib.sha256(",".join(f"{t}:{e.strength:.3f}" for t,e in top).encode()).hexdigest()[:16]; ps="->".join(t[:8] for t,_ in top[:5])
    else: fp=hashlib.sha256(b"no_links").hexdigest()[:16]; ps="no_paths"
    cats="+".join(n for b,n in [(1,"SYS"),(2,"DAT"),(4,"OP"),(8,"HUM"),(16,"URG")] if cat&b) or "?"
    disp="00000000|VACUUM" if cat==0 else f"{cat:08b}|T{strand}|{zone}|{fp[:4]}({cats})"
    return {"category":cat,"strand_type":strand,"price_zone":zone,"fingerprint":fp,"path_signature":ps,"display":disp}
def dna_sim(a,b):
    if not a or not b: return 0.0
    s=0.0; ca,cb=a.get("category",0),b.get("category",0)
    if ca and cb and (ca&7)&(cb&7): s+=0.30*(bin(ca&cb).count("1")/max(bin(ca|cb).count("1"),1))
    ta,tb=a.get("strand_type"),b.get("strand_type")
    if ta is not None and tb is not None and ta!=tb: s+=0.12
    za,zb=a.get("price_zone",""),b.get("price_zone","")
    if za and zb and za!="Z?" and za==zb: s+=0.10
    fa,fb=a.get("fingerprint",""),b.get("fingerprint","")
    if fa and fb: s+=0.28*_ov(fa,fb)
    pa,pb=a.get("path_signature",""),b.get("path_signature","")
    if pa and pb and pa!="no_paths" and pb!="no_paths": s+=0.20*_ov(pa,pb)
    return round(min(s,1.0),4)
def _ngrams(text,mn=2,mx=4):
    t=clean_text(text); return [t[i:i+n] for n in range(mn,mx+1) for i in range(len(t)-n+1)]
def _jacc(A,B): return len(A&B)/len(A|B) if A and B else 0.0
def ngram_sim(a,b): return _jacc(set(_ngrams(a)),set(_ngrams(b)))
def phonetic_sim(a,b):
    def sig(t):
        r,prev=[],""
        for c in clean_text(t):
            ch="V" if c in "AEIOU" else "C" if c.isalpha() else "D" if c.isdigit() else c
            if ch!=prev: r.append(ch)
            prev=ch
        return set(r)
    return _jacc(sig(a),sig(b))
def vec_sim(a,b):
    av=[_CHAR_NUM[c] for c in clean_text(a) if c in _CHAR_NUM]; bv=[_CHAR_NUM[c] for c in clean_text(b) if c in _CHAR_NUM]
    if not av or not bv: return 0.0
    n=min(len(av),len(bv)); return 1.0-sum(abs(av[i]-bv[i]) for i in range(n))/(n*(_BASE-1))
def is_num(text):
    c=_cmp(clean_text(text)); return bool(c) and c.isdigit()
def hybrid_score(a,b,da=None,db=None,pa=None,pb=None,vol=None):
    ca,cb=_cmp(clean_text(a)),_cmp(clean_text(b)); has_p=pa is not None and pb is not None
    if is_num(a) and is_num(b):
        t=cfg.W_PRICE_NUMERIC*p_sim(pa,pb,_vol(pa,pb,vol)) if has_p else 0.0
        if da and db: t+=cfg.W_DNA_NUMERIC*dna_sim(da,db)
        if ca==cb: t=min(1.0,t*1.6)
        return min(t,1.0)
    t=cfg.W_NGRAM*ngram_sim(a,b)+cfg.W_PHONETIC*phonetic_sim(a,b)+cfg.W_VECTOR*vec_sim(a,b)
    qw,nw=set(clean_text(a).split()),set(clean_text(b).split())
    if qw and nw: t+=cfg.W_WORD_OVERLAP*len(qw&nw)/len(qw)
    if da and db: t+=cfg.W_DNA_SIM*dna_sim(da,db)
    if has_p: t+=cfg.W_PRICE*p_sim(pa,pb,_vol(pa,pb,vol))
    if ca==cb: t=min(1.0,t*1.6)
    if is_num(a):
        la,lb=len(ca),len(cb); t*=0.4+0.6*(min(la,lb)/max(la,lb) if la and lb else 0.0)
    return min(t,1.0)
# FLSR primitives - aligned windows, separate RNG streams
def _pow2_tail(x):
    n=1<<(len(x).bit_length()-1) if x else 0; return list(x[-n:]) if n else []
def _fft(x):
    n=len(x); a=[complex(v) for v in x]; j=0
    for i in range(1,n):
        bit=n>>1
        while j&bit: j^=bit; bit>>=1
        j^=bit
        if i<j: a[i],a[j]=a[j],a[i]
    m=2
    while m<=n:
        wm=cmath.exp(-2j*math.pi/m); h=m//2
        for k in range(0,n,m):
            w=1+0j
            for t in range(h):
                u,v=a[k+t],a[k+t+h]*w; a[k+t],a[k+t+h]=u+v,u-v; w*=wm
        m<<=1
    return a
def _ifft_real(X):
    n=len(X); return [v.real/n for v in _fft([c.conjugate() for c in X])]
def _periodogram(x,detrend=True):
    n=len(x)
    if n<2: return [],[]
    y=[v-sum(x)/n for v in x] if detrend else list(x); X=_fft(y); freqs,P=[],[]
    for k in range(n//2+1):
        p=abs(X[k])**2/n
        if 0<k<n-k: p*=2.0
        P.append(p); freqs.append(k/n)
    return freqs,P
def _spectral_features(x,detrend=True,force_n=None):
    # force_n: if set, use last force_n then pow2 tail, keeps synthetic/observed/diff comparable
    if force_n: x=list(x[-force_n:])
    x=_pow2_tail(x)
    if len(x)<FLSR_CFG["MIN_N"]: return None
    freqs,P=_periodogram(x,detrend); total=sum(P)
    if total<=0: return None
    pn=[p/total for p in P]; ent=-sum(p*math.log(p) for p in pn if p>0)
    bands={nm:sum(p for f,p in zip(freqs,P) if lo<=f<hi)/total for nm,(lo,hi) in FLSR_CFG["BANDS"].items()}
    return {"centroid":round(sum(f*p for f,p in zip(freqs,pn)),6),"entropy":round(ent/math.log(len(P)) if len(P)>1 else 0.0,6),"bands":{k:round(v,6) for k,v in bands.items()},"total_power":round(total,6),"N":len(x)}
def _vec(f): return None if f is None else [f["centroid"],f["entropy"],f["bands"]["low"],f["bands"]["mid"],f["bands"]["high"]]
def _dist(fa,fb):
    a,b=_vec(fa),_vec(fb); return None if a is None or b is None else round(math.sqrt(sum((p-q)**2 for p,q in zip(a,b))),5)
def _permute(x,rng): y=list(x); rng.shuffle(y); return y
def _phase_randomise(x,rng):
    x=_pow2_tail(x); n=len(x); X=_fft(x)
    for k in range(1,n//2):
        ph=rng.uniform(0,2*math.pi); X[k]=cmath.rect(abs(X[k]),ph); X[n-k]=X[k].conjugate()
    X[n//2]=complex(abs(X[n//2]),0.0); return _ifft_real(X)
def _ar1_null(x,rng):
    n=len(x)
    if n<3: return list(x)
    mean=sum(x)/n; xc=[v-mean for v in x]; var_x=sum(v*v for v in xc)/n; r1=sum(xc[i]*xc[i+1] for i in range(n-1))/(var_x*n or 1e-12)
    phi=max(-0.95,min(0.95,r1)); y=[rng.gauss(0,1)]
    for _ in range(1,n): y.append(phi*y[-1]+rng.gauss(0,1))
    var_y=sum(v*v for v in y)/n or 1e-12; s=math.sqrt(var_x/var_y); return [mean+s*v for v in y]
def _first_diff(x): return [x[i]-x[i-1] for i in range(1,len(x))]
def _log_returns(x): return [math.log(x[i]/x[i-1]) if x[i-1]>0 and x[i]>0 else 0.0 for i in range(1,len(x))]
def _s_order(rng,N=128):
    base=[rng.gauss(0,1) for _ in range(N)]; sh=list(base); rng.shuffle(sh); return sorted(base),sh
def _s_phase(rng,N=128):
    t=[i/N for i in range(N)]; return ([math.sin(2*math.pi*3*u)+0.5*math.sin(2*math.pi*7*u) for u in t],[math.sin(2*math.pi*3*u+1.2)+0.5*math.sin(2*math.pi*7*u+0.7) for u in t])
def _s_freq(rng,N=128):
    t=[i/N for i in range(N)]; return [math.sin(2*math.pi*2*u) for u in t],[math.sin(2*math.pi*45*u) for u in t]
def _s_nonstat(rng,N=128):
    t=[i/N for i in range(N)]; st=[math.sin(2*math.pi*5*u)+0.3*rng.gauss(0,1) for u in t]; ch=[math.sin(2*math.pi*(3*u+6*u*u))+0.3*rng.gauss(0,1) for u in t]; return st,ch
class Edge:
    __slots__=("strength","created_at","hits","price_delta","cross_zone","transition","epistemic_count","mu_entropy","mu_contradiction","mu_confidence","epistemic_weight")
    def __init__(self,strength,hits=0,price_delta=None,cross_zone=False,transition=None):
        self.strength=round(max(0.0,min(1.0,strength)),4); self.created_at=time.time(); self.hits=hits; self.price_delta=price_delta; self.cross_zone=cross_zone; self.transition=transition
        self.epistemic_count=0; self.mu_entropy=self.mu_contradiction=self.mu_confidence=self.epistemic_weight=0.0
    def reinforce(self,pc=1.0): self.strength=min(1.0,round(self.strength+cfg.REINFORCE_RATE*pc,4)); self.hits+=1
    def recompute_weight(self):
        n=self.epistemic_count
        if n>0.1:
            raw=cfg.L_ALPHA+cfg.L_BETA*max(0,self.mu_confidence)-cfg.L_GAMMA*abs(self.mu_contradiction); self.epistemic_weight=round(raw*math.tanh(n/10.0),4)
        else: self.epistemic_weight=self.mu_confidence=self.mu_contradiction=self.mu_entropy=0.0
    def decay(self):
        self.strength=round(min(1.0,max(self.strength*cfg.DECAY_RATE+self.hits*cfg.USAGE_BIAS,cfg.MIN_EDGE_STRENGTH)),4); self.epistemic_count*=cfg.DECAY_RATE; self.recompute_weight()
    def to_dict(self): return {k:getattr(self,k) for k in self.__slots__}
    @classmethod
    def from_dict(cls,d):
        e=cls(d.get("strength",0.5))
        for k in cls.__slots__:
            if k in d: setattr(e,k,d[k])
        return e
class PatternNode:
    __slots__=("transitions","signature","length","hits","created_at","start_zone","display")
    def __init__(self,transitions,signature,start_zone="Z?"):
        self.transitions=transitions; self.signature=signature; self.length=len(transitions); self.hits=1.0; self.created_at=time.time(); self.start_zone=start_zone; self.display="->".join(transitions[:5])+("..." if len(transitions)>5 else "")
    def reinforce(self): self.hits+=1
    def decay(self): self.hits*=cfg.PATTERN_DECAY_RATE
    def alive(self): return self.hits>=0.5
    def age(self): return round(time.time()-self.created_at)
    def to_dict(self): return {k:getattr(self,k) for k in self.__slots__}
class Node:
    def __init__(self,value,hits=0,dna=None,price=None,volatility=None,strand_type=None):
        self.value=clean_text(value); self.created_at=time.time(); self.hits=hits; self.links={}; self.strand_type=strand_type
        ep,ev=extract_price(value); self.price=price if price is not None else ep; self.volatility=volatility if volatility is not None else ev; self.price_zone=get_price_zone(self.price)
        if dna is not None: self.dna=dna; self._dirty=False
        else: self.dna={"category":0,"strand_type":strand_type,"price_zone":self.price_zone,"fingerprint":"","path_signature":"","display":"pending"}; self._dirty=True
    def refresh_dna(self):
        if self._dirty or not self.dna.get("fingerprint"): self.dna=express_dna(self.value,self.links,self.strand_type,self.price); self._dirty=False
    def mark_dirty(self): self._dirty=True
    def age(self): return round(time.time()-self.created_at)
    def freq_bonus(self,qp=None):
        r=math.log1p(min(self.hits,200))*cfg.FREQ_BONUS
        if qp and self.price: r*=p_sim(qp,self.price,self.volatility)
        return round(r,4)
    def hub_pen(self,total):
        if total<=1: return 0.0
        ratio=len(self.links)/(total-1); return round((ratio-cfg.HUB_DEGREE_THRESHOLD)*cfg.HUB_PENALTY_FACTOR,4) if ratio>cfg.HUB_DEGREE_THRESHOLD else 0.0
    def to_dict(self): return {"value":self.value,"hits":self.hits,"dna":self.dna,"price":self.price,"volatility":self.volatility,"created_at":self.created_at,"strand_type":self.strand_type,"price_zone":self.price_zone,"links":{k:e.to_dict() for k,e in self.links.items()}}
class ClusterTransitions:
    def __init__(self): self.counts={}; self.examples={}; self.step_counts={}
    def record(self,fz,tz,fp=None,tp=None,steps=None):
        if fz==tz or "Z?" in (fz,tz): return
        k=f"{fz}->{tz}"; self.counts[k]=self.counts.get(k,0)+1
        if fp and tp:
            ex=self.examples.setdefault(k,[]); ex.append((fp,tp)); del ex[:-cfg.MAX_TRANSITION_EXAMPLES]
        if steps: self.step_counts.setdefault(k,[]).append(steps)
    def probs(self,fz):
        rel={k.split("->")[1]:c for k,c in self.counts.items() if k.startswith(f"{fz}->")}; total=sum(rel.values())
        return dict(sorted(((z,round(c/total,2)) for z,c in rel.items()),key=lambda x:x[1],reverse=True)) if total else {}
    def avg_steps(self,fz,tz):
        sl=self.step_counts.get(f"{fz}->{tz}",[]); return round(sum(sl)/len(sl),2) if sl else None
    def cluster_analysis(self,zone,db_nodes):
        zn=[n for n in db_nodes.values() if n.price_zone==zone]; pr=self.probs(zone)
        return {"zone":zone,"node_count":len(zn),"regime":detect_regime(zn),"transitions":pr,"dominant":max(pr,key=pr.get) if pr else None,"dominant_prob":max(pr.values()) if pr else 0}
    def decay(self):
        for k in list(self.counts):
            self.counts[k]*=cfg.CLUSTER_TRANSITION_DECAY
            if self.counts[k]<0.5:
                for d in (self.counts,self.examples,self.step_counts): d.pop(k,None)
    def to_dict(self): return {"counts":self.counts,"examples":self.examples,"step_counts":self.step_counts}
    def load(self,d):
        self.counts=d.get("counts",{}); self.examples={k:[(float(f),float(t)) for f,t in v] for k,v in d.get("examples",{}).items()}; self.step_counts={k:(v if isinstance(v,list) else []) for k,v in d.get("step_counts",{}).items()}
def _bump(r,x): r["total"]=round(r["total"]+x,4); r["raw_score"]=round(r["raw_score"]+x,4); r["display"]=round(min(r["display"]+x,1.0),4)
def classify(results,db=None):
    if not results: return "INVALID"
    top=results[0]; second=results[1] if len(results)>1 else None; ts=top.get("raw_score",top.get("total",0)); ss=second.get("raw_score",second.get("total",0)) if second else 0.0
    if ts<cfg.CONFIDENCE_NONE: return "NO_MATCH"
    tie=second is not None and abs(ts-ss)<cfg.RESONANCE_THRESHOLD
    if tie and db:
        n1,n2=db.nodes.get(top["value"]),db.nodes.get(second["value"])
        if n1 and n2:
            sim=dna_sim(n1.dna,n2.dna)
            if sim<0.3 or sim>0.7: _bump(top,0.10); return "RESOLVED_MATCH"
            if None not in (n1.strand_type,n2.strand_type) and n1.strand_type!=n2.strand_type: _bump(top,0.08); return "RESOLVED_MATCH"
            if n1.price_zone and n1.price_zone==n2.price_zone: _bump(top,0.06); return "RESOLVED_MATCH"
            if n1 and second["value"] in n1.links and n1.links[second["value"]].strength>=cfg.AGRR_MIN_STRENGTH: _bump(top,n1.links[second["value"]].strength*0.15); return "RESOLVED_MATCH"
    if tie: return "AMBIGUOUS"
    return "HIGH" if ts>cfg.CONFIDENCE_HIGH else "MEDIUM" if ts>cfg.CONFIDENCE_MEDIUM else "LOW" if ts>cfg.CONFIDENCE_LOW else "NO_MATCH"
class FLSRAnalysis:
    def __init__(self,seed=None): self.seed=FLSR_CFG["SEED"] if seed is None else seed; self.results={}
    def _log(self,m): print(f"  [FLSR] {m}")
    def _rng(self,offset): return random.Random(self.seed+offset)
    def null_calibration(self,series,n_surr=None,force_n=None):
        n_surr=n_surr or FLSR_CFG["N_SURROGATES"]; self._log(f"Null-model calibration (N={len(series)}, surrogates={n_surr})")
        obs=_spectral_features(series,force_n=force_n)
        if obs is None: self._log("Series too short."); return None
        def run(gen,n,off):
            rng=self._rng(off); d=[_dist(obs,_spectral_features(gen(series,rng),force_n=force_n)) for _ in range(n)]; d=sorted(x for x in d if x is not None)
            if not d: return {"mean":None,"p05":None,"p95":None}
            return {"mean":round(sum(d)/len(d),5),"p05":d[int(0.05*len(d))],"p95":d[min(int(0.95*len(d)),len(d)-1)]}
        rep={"observed":{k:obs[k] for k in ("centroid","entropy","bands","N")},"permutation_null":run(_permute,n_surr,1001),"phase_random_null":run(_phase_randomise,min(n_surr,40),1002),"ar1_null":run(_ar1_null,min(n_surr,40),1003),"note":"Phase-random null should sit near zero: it preserves the power spectrum by construction."}
        self.results["null"]=rep; return rep
    def differencing_effect(self,series,force_n=None):
        self._log("Differencing / log-return effect")
        keep=lambda f:{k:f[k] for k in ("centroid","entropy","bands")} if f else None
        # aligned windows: take last force_n+1 raw, diff to force_n, so raw/diff/log all use same N
        N=force_n or 64; raw_series=list(series[-(N+1):]) if len(series)>N else list(series)
        raw=_spectral_features(series,force_n=N); fd=_spectral_features(_first_diff(raw_series),force_n=N); lr=_spectral_features(_log_returns(raw_series),force_n=N)
        # multiscale: first half vs second half of raw window
        tail=_pow2_tail(series); h=len(tail)//2; ms={"first_half":keep(_spectral_features(tail[:h],force_n=h)),"second_half":keep(_spectral_features(tail[h:],force_n=h))} if h>=FLSR_CFG["MIN_N"] else {}
        rep={"raw":keep(raw),"first_diff":keep(fd),"log_returns":keep(lr),"multiscale":ms,"note":"First differencing attenuates low-frequency power (high-pass). Aligned windows: raw/diff/log use same N."}
        self.results["differencing"]=rep; return rep
    def full_protocol_report(self,price_hist_copy):
        self._log("Multiscale spectral analysis")
        series=[p for p,_ in price_hist_copy if p is not None] if price_hist_copy else []
        if len(series)<FLSR_CFG["MIN_N"]: return f"  [FLSR] Insufficient data (N={len(series)}, need >={FLSR_CFG['MIN_N']})"
        series=series[-FLSR_CFG["MAX_WINDOW"]:]; used=len(_pow2_tail(series))
        L=[""," ╔══════════════════════════════════════════════════════════╗"," ║  FLSR v0.2 REPORT                           ║"," ║  Frequency-based Latent State Reconstruction  ║"," ╚══════════════════════════════════════════════════════════╝",f"  Seed: {self.seed}  |  N={len(series)} (FFT window {used}, most recent, aligned)  |  Event-time analysis","  NOTE: Spectral features describe observation windows.","        They do NOT automatically equal latent-state identity.",""]
        n=self.null_calibration(series,force_n=used)
        if n:
            o=n["observed"]; L+=[" ── Null-model calibration ──",f"  Observed centroid : {o['centroid']:.4f}",f"  Observed entropy  : {o['entropy']:.4f}",f"  Band powers       : {o['bands']}"]
            for key,lab in (("permutation_null","Permutation"),("phase_random_null","Phase-random"),("ar1_null","AR(1)")):
                s=n[key]; L.append(f"  {lab:<13} null distance  mean={s['mean']}  p05={s['p05']}  p95={s['p95']}")
            L+=[f"  {n['note']}",""]
        d=self.differencing_effect(series,force_n=used)
        L+=[""," ── Effect of differencing (aligned) ──",f"  Raw        : {d['raw']}",f"  First diff : {d['first_diff']}",f"  Log returns: {d['log_returns']}",f"  Multiscale : {d['multiscale']}",f"  {d['note']}",""," ── Scientific status ──","  Architecture component. No claim that FLSR has validated latent-state identity.",""]
        return "\n".join(L)
def _sd_mean(v): return sum(v)/len(v) if v else None
def _hann_detrend(x):
    n=len(x)
    if n<4: return list(x)
    mx=(n-1)/2.0; my=_sd_mean(x); den=sum((i-mx)**2 for i in range(n)) or 1.0
    b=sum((i-mx)*(v-my) for i,v in enumerate(x))/den
    out=[]
    for i,v in enumerate(x):
        w=0.5-0.5*math.cos(2*math.pi*i/(n-1)) if n>1 else 1.0
        out.append((v-my-b*(i-mx))*w)
    return out
def _sd_power_vector(x):
    # Returns (normalised vector, log total power). Uses Hann + linear detrend to cut trend leakage.
    # Trend leakage made the old bin-1 atom expected. Hann + detrend does not remove the trend, it reduces its spill.
    n=len(x)
    if n<8: return None,None
    y=_hann_detrend(x); X=_fft(y); P=[]
    for k in range(n//2+1):
        p=abs(X[k])**2/n
        if 0<k<n-k: p*=2.0
        P.append(p)
    tot=sum(P)
    if tot<=0: return None,None
    return [p/tot for p in P],math.log(tot)


def _flsr_forward_trace(price_hist):
    # FLSR forward trace, NLPGM terminology only, no music names.
    # State = low-band share tertile: Low-Strong / Low-Med / Low-Weak
    # Log power tertile: Low / Medium / High
    # Vol tertile: Low / Medium / High (vol = std of log returns in window)
    # Forward trace = P(next low-band state | current low-band state) + drift stats per state.
    # Window = window 32, step 4, same as Y price 32, so bars are comparable to R windows.
    prices=[p[0] if isinstance(p,(list,tuple)) else p for p in price_hist if (p[0] if isinstance(p,(list,tuple)) else p) is not None]
    if len(prices)<64: return None
    rows=[]
    for st in range(0, len(prices)-32+1, 4):
        seg=prices[st:st+32]
        vec, logp=_sd_power_vector(_pow2_tail(seg))
        if vec is None: continue
        vals=vec[1:]; n=len(vals); third=n//3
        low=sum(vals[:third]); mid=sum(vals[third:2*third]); high=sum(vals[2*third:])
        tot=low+mid+high or 1.0
        rs=[math.log(prices[i]/prices[i-1]) if prices[i-1]>0 and prices[i]>0 else 0.0 for i in range(st+1, st+32)]
        mrs=sum(rs)/len(rs) if rs else 0.0
        vol=math.sqrt(sum((x-mrs)**2 for x in rs)/len(rs)) if rs else 0.0
        rows.append({"start":st,"low":low/tot,"mid":mid/tot,"high":high/tot,"logp":logp,"vol":vol,"price_start":prices[st],"price_end":prices[st+31]})
    if len(rows)<6: return None
    def _tertiles(vals):
        s=sorted(vals); return s[len(s)//3], s[2*len(s)//3]
    low_lo, low_hi=_tertiles([r["low"] for r in rows])
    logp_lo, logp_hi=_tertiles([r["logp"] for r in rows])
    vol_lo, vol_hi=_tertiles([r["vol"] for r in rows])
    def _low_state(low):
        if low>=low_hi: return "Low-Strong"
        if low>=low_lo: return "Low-Med"
        return "Low-Weak"
    def _logp_state(v):
        if v>=logp_hi: return "High"
        if v>=logp_lo: return "Medium"
        return "Low"
    def _vol_state(v):
        if v>=vol_hi: return "High"
        if v>=vol_lo: return "Medium"
        return "Low"
    for r in rows:
        r["low_state"]=_low_state(r["low"]); r["logp_state"]=_logp_state(r["logp"]); r["vol_state"]=_vol_state(r["vol"])
    # Transitions + drift: drift = price at start of next window - price at start of current bar (4 steps)
    from collections import Counter, defaultdict
    trans=defaultdict(Counter); drifts=defaultdict(list)
    for i in range(len(rows)-1):
        a=rows[i]["low_state"]; b=rows[i+1]["low_state"]
        trans[a][b]+=1
        d=rows[i+1]["price_start"]-rows[i]["price_start"]
        drifts[a].append(d)
    # Current bar = last row
    cur=rows[-1]
    # Classification: Calm sideways vs Slow down drift, in NLPGM terms only
    # Calm sideways: Low-Weak + Low log power + Low/Medium vol + drift mean near 0 + up frac 40-60%
    # Slow down drift: Low-Weak + Low log power + Low/Medium vol + drift mean negative + up frac <40%
    # Both need Low-Weak + Low log power, otherwise not in this family.
    cur_drifts=drifts.get(cur["low_state"],[])
    cur_mean=sum(cur_drifts)/len(cur_drifts) if cur_drifts else 0.0
    cur_up=sum(1 for d in cur_drifts if d>0)/len(cur_drifts) if cur_drifts else 0.0
    # Drift as % of price for scale-free reading
    cur_drift_pct=cur_mean/cur["price_start"]*100 if cur["price_start"] else 0.0
    if cur["low_state"]=="Low-Weak" and cur["logp_state"]=="Low" and cur["vol_state"] in ("Low","Medium"):
        if abs(cur_drift_pct)<0.5 and 0.40<=cur_up<=0.60: cls="Calm sideways"
        elif cur_mean<0 and cur_up<0.40: cls="Slow down drift"
        elif cur_mean>0 and cur_up>0.60: cls="Slow up drift"
        else: cls="Low-Weak, Low log power, direction unclear"
    else:
        cls="Not in Low-Weak / Low log power family, calm / slow-drift rules do not apply"
    return {"rows":rows,"low_tertiles":(low_lo,low_hi),"logp_tertiles":(logp_lo,logp_hi),"vol_tertiles":(vol_lo,vol_hi),"trans":dict(trans),"drifts":dict(drifts),"current":cur,"cur_mean":cur_mean,"cur_up":cur_up,"cur_drift_pct":cur_drift_pct,"classification":cls,"n_bars":len(rows)}
def _fmt_drift(x):
    # Adaptive: gold drift 21.9 needs 1 decimal, forex drift 0.0006 needs 4-5 decimals. Fixed 1 decimal hides forex drift as 0.0.
    ax=abs(x)
    if ax>=1: return f"{x:.1f}"
    if ax>=0.01: return f"{x:.4f}"
    if ax>=0.0001: return f"{x:.5f}"
    return f"{x:.6f}"
def _flsr_forward_report(price_hist, dna=None):
    res=_flsr_forward_trace(price_hist)
    if res is None: return "FLSR FORWARD TRACE: need >=64 prices, have fewer."
    L=[]
    L.append("FLSR FORWARD TRACE - Low-band state transitions, NLPGM terminology")
    L.append(f"Windows: window 32, step 4, N windows={res['n_bars']}. Window = 32 prices. Forward trace = P(next low-band state | current low-band state).")
    L.append(f"Low-band tertiles from this song: Low-Weak < {res['low_tertiles'][0]:.3f}, Low-Med {res['low_tertiles'][0]:.3f}-{res['low_tertiles'][1]:.3f}, Low-Strong >= {res['low_tertiles'][1]:.3f}")
    L.append(f"Log power tertiles: Low < {res['logp_tertiles'][0]:.2f}, Medium {res['logp_tertiles'][0]:.2f}-{res['logp_tertiles'][1]:.2f}, High >= {res['logp_tertiles'][1]:.2f}")
    L.append(f"Vol tertiles: Low < {res['vol_tertiles'][0]:.4f}, Medium {res['vol_tertiles'][0]:.4f}-{res['vol_tertiles'][1]:.4f}, High >= {res['vol_tertiles'][1]:.4f}")
    L.append("")
    L.append("Transitions: P(next | current)")
    for a in ("Low-Strong","Low-Med","Low-Weak"):
        cnt=res["trans"].get(a,{})
        tot=sum(cnt.values()) or 1
        ds=res["drifts"].get(a,[])
        mean=sum(ds)/len(ds) if ds else 0.0; up=sum(1 for d in ds if d>0)/len(ds) if ds else 0.0
        L.append(f"  {a} (n={tot}): " + ", ".join(f"{b} {cnt.get(b,0)}/{tot}={cnt.get(b,0)/tot:.2f}" for b in ("Low-Strong","Low-Med","Low-Weak")) + f" | next 4-step drift mean {_fmt_drift(mean)}, up frac {up:.2f}")
    cur=res["current"]
    L.append("")
    L.append(f"Current window (last): start index {cur['start']}, low-band share {cur['low']:.3f} = {cur['low_state']}, mid {cur['mid']:.3f}, high {cur['high']:.3f}")
    L.append(f"  Log power {cur['logp']:.2f} = {cur['logp_state']}, Vol {cur['vol']:.4f} = {cur['vol_state']}")
    if dna is not None:
        L.append(f"  DNA dominant {dna.get('dominant_state')}, distribution {dna.get('distribution')}")
    L.append(f"  After {cur['low_state']}: next 4-step drift mean {_fmt_drift(res['cur_mean'])} ({res['cur_drift_pct']:.2f}% of price), up frac {res['cur_up']:.2f}")
    L.append(f"  Classification: {res['classification']}")
    L.append("  Calm sideways needs: Low-Weak + Low log power + Low/Medium vol + drift near 0 + up frac 40-60%.")
    L.append("  Slow down drift needs: Low-Weak + Low log power + Low/Medium vol + drift negative + up frac <40%.")
    L.append("  Same low-band state, different drift direction = different classification. Low-band alone cannot tell calm vs slow bleed.")
    L.append("  This is a forward trace in spectral state, same math as R forward trace in zone state. It does not predict price, it gives P(next spectral state | current).")
    return "\n".join(L)

class MemoryDB:
    def __init__(self):
        self.nodes={}; self.patterns={}; self.ct=ClusterTransitions(); self._recent=[]; self._last_step_price=None; self.cycles=0; self._last_strand=None; self._pbuf=[]; self._dbuf=[]; self._step_counter=0; self.last_zone=None
        self._last_dna=None; self._dna_valid=False; self._dna_age=0; self._dna_vel=None; self._dna_hist=[]; self._dna_persist=0; self._dna_cache=None; self._dna_cache_step=-1
        self.price_hist=[]; self._agree_hist=[]; self._agree_step=-1; self.cis_verbose=cfg.CIS_VERBOSE; self.cis_episodes=[]; self.cis_pending={"full":[],"mild":[],"component":[]}; self._global_step=0
    def _store_pattern(self,seq,zone):
        sig=build_pattern_sig(seq)
        if not sig: return
        if sig in self.patterns: self.patterns[sig].reinforce(); return
        if len(self.patterns)>=cfg.PATTERN_MAX_STORED: self._prune()
        self.patterns[sig]=PatternNode(list(seq),sig,zone)
    def _flush(self,buf,zone):
        if len(buf)<cfg.PATTERN_MIN_LENGTH: return
        self._store_pattern(buf,zone); ov=cfg.PATTERN_MIN_LENGTH-1; buf[:]=buf[-ov:] if ov and len(buf)>ov else []
    def _prune(self):
        if self.patterns:
            now=time.time(); del self.patterns[min(self.patterns,key=lambda s:self.patterns[s].hits/max(now-self.patterns[s].created_at,1))]
    def _push_transition(self,t):
        if not t: return
        self._recent=(self._recent+[t["signature"]])[-30:]; self._pbuf.append(t["signature"]); self._flush(self._pbuf,"Z?"); self._dbuf.append(t["direction"]); self._flush(self._dbuf,"DIR?")
    def _finalize_batch_patterns(self,seq):
        tr=[]
        for a,b in zip(seq,seq[1:]):
            t=get_transition(a.price,b.price) if a.price and b.price else None
            if t: tr.append(t["signature"])
        if len(tr)>=cfg.PATTERN_MIN_LENGTH: self._store_pattern(tr,seq[0].price_zone)
    def _rec_price(self,price):
        if price: self.price_hist=(self.price_hist+[[price,time.time()]])[-10000:]
    def _zone_prices(self,zone): return sorted(n.price for n in self.nodes.values() if n.price_zone==zone and n.price)
    def median_price(self,zone): return _median(self._zone_prices(zone))
    def _cluster(self,zone): return self.ct.cluster_analysis(zone,self.nodes)
    def _avg_vol(self):
        v=[n.volatility for n in self.nodes.values() if n.price and n.volatility>0]; return max(sum(v)/len(v),1e-6) if v else 0.01
    def _link(self,new,existing):
        for ex in existing.values():
            sc=hybrid_score(new.value,ex.value,new.dna,ex.dna,new.price,ex.price,ex.volatility); cm=(cfg.COMPLEMENTARY_BOOST if new.strand_type!=ex.strand_type else cfg.SAME_TYPE_PENALTY if new.strand_type is not None else 1.0); zm=1.0 if same_zone(new.price,ex.price) else cfg.CROSS_ZONE_PENALTY
            if is_num(new.value) and is_num(ex.value): adj=sc*(0.5+0.5*ep_sim(new.price,ex.price,ex.volatility))*cm*zm
            else: adj=sc*cm
            if adj>=cfg.LINK_THRESHOLD:
                pd=abs(new.price-ex.price) if new.price and ex.price else None; xz=not same_zone(new.price,ex.price); new.links[ex.value]=Edge(adj,price_delta=pd,cross_zone=xz); ex.links[new.value]=Edge(adj,price_delta=pd,cross_zone=xz); ex.mark_dirty()
    def _add_node(self,text,strand):
        if text in self.nodes: self.nodes[text].hits+=1; return None
        n=Node(text,strand_type=strand); self._link(n,self.nodes); self.nodes[text]=n
        for nd in self.nodes.values():
            if nd._dirty: nd.refresh_dna()
        return n  # V2.9: price_hist is recorded in batch_add once per item, not here, so repeats are kept.
    def _track_zone(self,nz,np):
        if self.last_zone is None: self._step_counter=1
        elif nz==self.last_zone: self._step_counter+=1; return
        else:
            if self._last_step_price: self.ct.record(self.last_zone,nz,self._last_step_price,np,self._step_counter)
            self._step_counter=1
        self.last_zone=nz
    def _touch_edge(self,a,b,strength,xz):
        tr=get_transition(a.price,b.price); e=a.links.get(b.value)
        if e: e.reinforce(p_sim(a.price,b.price,a.volatility) if a.price and b.price else 1.0); e.cross_zone=xz
        else: e=a.links[b.value]=Edge(strength,cross_zone=xz,transition=tr)
        if tr: e.transition=tr
        return e
    def _link_transition(self,pn,nn,vf):
        if pn.price and nn.price:
            zm=1.0 if same_zone(nn.price,pn.price) else cfg.CROSS_ZONE_PENALTY; strength=max(cfg.BATCH_LINK_STRENGTH*ep_sim(nn.price,pn.price,nn.volatility)*zm,cfg.MIN_EDGE_STRENGTH)
        else: strength=cfg.BATCH_LINK_STRENGTH
        xz=not same_zone(nn.price,pn.price); self._touch_edge(nn,pn,strength,xz); fwd=self._touch_edge(pn,nn,strength,xz); self._observe_adapt(pn,nn,fwd,vf)
    def batch_add(self,text):
        items=[]; skipped=[]
        for line in text.strip().split("\n"):
            line=line.strip()
            if not line: continue
            if "," in line: parts=[p.strip() for p in line.split(",") if p.strip()]
            elif " " in line and not re.match(r'^\d+\.?\d*$',line): parts=line.split()
            else: parts=[line]
            for p in parts:
                if _is_valid_price_line(p): items.append(p)
                else: skipped.append(p)
        if not items: return f"No valid items. Skipped {len(skipped)} non-numeric: {skipped[:5]}"
        vf=self.vector_field(); seq=[]; prev=None; new_count=0
        for i,item in enumerate(items):
            tc=clean_text(item)
            if not tc: continue
            np,_=extract_price(tc); self._global_step+=1
            self._rec_price(np) if np else None  # V2.9: true time order, repeats kept.
            self._track_zone(get_price_zone(np) if np else "Z?",np)  # V2.9.1: RESTORED - was commented out in V2.9, broke ct.transitions, vector field, R/G/U.
            pn=self.nodes.get(prev) if prev else None
            if pn and pn.price and np: self._push_transition(get_transition(pn.price,np))
            new=self._add_node(tc,i%2); node=new or self.nodes[tc]; new_count+=new is not None
            if pn and pn is not node: self._link_transition(pn,node,vf)
            seq.append(node); prev=tc
            if np: self._last_step_price=np
            if (i+1)%cfg.VF_REFRESH_INTERVAL==0: vf=self.vector_field()
        for n in self.nodes.values(): n.refresh_dna()
        if seq: self._finalize_batch_patterns(seq)
        self._cis_scheduler()
        # V2.6.1: B-only commit, R stays pure. Restores CIS learning + agreement history.
        try:
            if self._last_step_price is not None:
                _res=self.search(str(self._last_step_price))
                if _res:
                    _ssv=self.build_ssv([dict(r) for r in _res],commit=False,query_price=self._last_step_price)
                    self.commit_ssv(_ssv)
        except Exception: pass
        return f"Stored {len(seq)} items ({new_count} new) - {len(self.patterns)} patterns - {len(self.nodes)} total nodes - skipped {len(skipped)}"
    def decay_cycle(self):
        for n in self.nodes.values():
            for e in n.links.values(): e.decay()
        for p in self.patterns.values(): p.decay()
        self.patterns={s:p for s,p in self.patterns.items() if p.alive()}; self.ct.decay(); self.cycles+=1; self._cis_prune(); return f"Decay {self.cycles} complete - {len(self.patterns)} patterns remain"
    def search(self,query):
        if not self.nodes: return []
        qc=_cmp(clean_text(query)); ql=len(qc); qp,_=extract_price(query); qd=express_dna(query,{},price=qp); total=len(self.nodes); long_q=ql>=cfg.MIN_SINGULARITY_LEN; enc=[v for v in self.nodes if long_q and qc in _cmp(v)]; raw={}
        for n in self.nodes.values():
            base=hybrid_score(query,n.value,qd,n.dna,qp,n.price,n.volatility)-n.hub_pen(total); cn=_cmp(n.value); sing=pos=0.0
            if len(enc)==1 and n.value==enc[0]: sing=(cfg.BASE_SINGULARITY_WT+ql/max(len(cn),1)*0.25)*base
            if long_q and qc in cn:
                if cn.startswith(qc): pos+=cfg.POSITION_PREFIX_WT*base
                if cn.endswith(qc): pos+=cfg.POSITION_SUFFIX_WT*base
            raw[n.value]={"value":n.value,"base":round(base,4),"boost":0.0,"singularity":round(sing,4),"position":round(pos,4),"freq":n.freq_bonus(qp),"hub_penalty":n.hub_pen(total),"price":n.price,"zone":n.price_zone}
        gate=cfg.BOOST_GATE_THRESHOLD
        def gated(x,rb): return x*(max(rb,0.0)/gate) if rb<gate else x
        for n in self.nodes.values():
            ns=raw[n.value]["base"]
            if ns<=0: continue
            for lv,edge in n.links.items():
                if lv not in raw: continue
                boost=gated(ns*edge.strength*cfg.GRAPH_BOOST,raw[lv]["base"]); raw[lv]["boost"]+=round(boost,4); ln=self.nodes[lv]
                for h2,h2e in ln.links.items():
                    if h2 not in raw or h2==n.value: continue
                    b2=boost*h2e.strength*cfg.HOP2_DAMPEN
                    if dna_sim(ln.dna,self.nodes[h2].dna)>0.5: b2*=1.25
                    raw[h2]["boost"]+=round(gated(b2,raw[h2]["base"]),4)
        results=[]
        for r in raw.values():
            r["boost"]=round(min(r["boost"],max(r["base"],0.0)*0.5),4); unc=round(r["base"]+r["boost"]+r["singularity"]+r["position"]+r["freq"],4); r["raw_score"]=r["total"]=unc; r["display"]=round(min(unc,1.0),4); results.append(r)
        results.sort(key=lambda x:x["raw_score"],reverse=True); return results
    def get_arrival_depth(self,zone):
        steps=[s for k,sl in self.ct.step_counts.items() if k.endswith(f"->{zone}") for s in sl]; return int(round(_median(sorted(steps)))) if steps else 0
    def trace_forward(self,start_zone,steps=5):
        ad=self.get_arrival_depth(start_zone); rh=max(1,ad//2) if ad>0 else 1; cur={start_zone:1.0}; dists=[dict(cur)]
        for _ in range(steps):
            nxt={}
            for zone,prob in cur.items():
                pr=self.ct.probs(zone)
                if not pr: nxt[zone]=nxt.get(zone,0.0)+prob; continue
                for z,p in pr.items():
                    if z!=zone: nxt[z]=nxt.get(z,0.0)+prob*p
            mass=sum(nxt.values())
            if mass<=0: break
            nxt={z:round(v/mass,4) for z,v in nxt.items()}
            if nxt==cur: break
            dists.append(dict(nxt))
            if max(nxt.values())<cfg.FWD_MARGINAL_GAIN_MIN: break
            cur=nxt
        structured,flat=[], [start_zone]
        for i,dist in enumerate(dists[1:],1):
            items=sorted(dist.items(),key=lambda x:-x[1]); chosen,prob=items[0]; second=items[1][1] if len(items)>1 else 0.0
            structured.append({"zone":chosen,"confidence":prob,"depth":i,"status":"RECONSTRUCTION" if prob>=cfg.FWD_RECON_PROB_THRESHOLD else "SPECULATIVE","ambiguous":len(items)>1 and prob-second<cfg.FWD_BRANCH_SPREAD_THRESHOLD}); flat.append(chosen)
        return {"flat":flat,"structured":structured,"arrival_depth":ad,"reliable_horizon":rh,"distributions":dists}
    def vector_field(self):
        zones=sorted({n.price_zone for n in self.nodes.values() if n.price_zone!="Z?"},key=_zone_val); field={}
        for zone in zones:
            an=self._cluster(zone); pr=an["transitions"]; zv=_zone_val(zone); tp=sum(pr.values()); nd=sum(p*_sgn(_zone_val(t)-zv) for t,p in pr.items())/tp if tp else 0.0; tw=sum(pr.values()); mag=sum((1/a if (a:=self.ct.avg_steps(zone,t)) and a>0 else 1.0)*p for t,p in pr.items())/tw if tw else 0.0; asc=sum(self.ct.probs(oz).get(zone,0) for oz in zones if oz!=zone)-tp; cls="attractor" if asc>0.1 else "repeller" if asc<-0.1 else "transit" if abs(nd)>0.3 else "neutral"; field[zone]={"net_direction":round(nd,4),"magnitude":round(mag,4),"regime":an["regime"],"node_count":an["node_count"],"attractor_score":round(asc,2),"classification":cls}
        return field
    def mirror_analysis(self,window=None):
        window=window or cfg.MIRROR_WINDOW; rd=[s.split("_")[0] for s in self._recent[-window:] if "_" in s]; md=["DOWN" if d=="UP" else "UP" if d=="DOWN" else "FLAT" for d in reversed(rd)]; best,bp=0.0,None
        for pn in self.patterns.values():
            if pn.start_zone!="DIR?": continue
            ml=min(len(md),len(pn.transitions))
            if not ml: continue
            sim=sum(1 for i in range(ml) if md[i]==pn.transitions[i])/max(len(md),len(pn.transitions))
            if sim>best: best,bp=sim,pn
        hits=int(round(bp.hits)) if bp else 0; interp=(f"Strong mirror symmetry ({best:.2f}) - pattern seen {hits}x" if best>=cfg.MIRROR_SIMILARITY_THRESHOLD and bp else f"Moderate mirror symmetry ({best:.2f})" if best>=0.30 else "No significant mirror symmetry")
        return {"recent":rd,"mirror":md,"similarity":round(best,4),"best_match":bp.display if bp else None,"matched_hits":hits,"interpretation":interp}
    def dna_distribution(self,vf=None,commit=True):
        if commit and self._dna_cache is not None and self._dna_cache_step==self._global_step: return self._dna_cache
        vf=vf or self.vector_field()
        if not vf: return {"error":"No zones."}
        tn=sum(v["node_count"] for v in vf.values())
        if tn==0: return {"error":"No nodes in field."}
        and_=sum(v["net_direction"]*v["node_count"] for v in vf.values())/tn; amg=sum(v["magnitude"]*v["node_count"] for v in vf.values())/tn; cg=sum(1 for v in vf.values() if v["classification"]=="attractor")/len(vf); mir=self.mirror_analysis(); rzs=set()
        for k in list(self.ct.counts)[-cfg.DNA_WINDOW:]: rzs.update(k.split("->"))
        zsp=len(rzs)/len(vf); hs=[p.hits for p in self.patterns.values() if p.start_zone=="DIR?"]; th=sum(hs); pe=-sum((h/th)*math.log(max(h/th,1e-12)) for h in hs) if th>0 else 0.0; mgs=[]
        for sig in self._recent[-cfg.DNA_WINDOW:]:
            if "_" in sig:
                try: mgs.append(float(sig.split("_")[1]))
                except ValueError: pass
        mean=sum(mgs)/len(mgs) if mgs else 0.0; ms=math.sqrt(sum((m-mean)**2 for m in mgs)/len(mgs)) if mgs else 0.0; mn=max(self._avg_vol()*5,0.001); ec=math.log(cfg.PATTERN_MAX_STORED); msn,msh,pen=min(ms/mn,1),min(ms/(mn*0.5),1),min(pe/ec,1)
        s={"TrendingUp":max(0,and_)*0.6+(1-cg)*0.2+msn*0.2,"TrendingDown":max(0,-and_)*0.6+(1-cg)*0.2+msn*0.2,"Ranging":(1-abs(and_))*0.3+cg*0.3+mir["similarity"]*0.2+(1-msh)*0.2,"Breakout":msh*0.5+(1-cg)*0.3+min(zsp*5,1)*0.2,"Reversing":mir["similarity"]*0.5+(1-abs(and_))*0.25+(1-pen)*0.25,"LowVol":(1-min(amg*2,1))*0.4+(1-min(ms/(mn*0.3),1))*0.3+pen*0.3}
        ts=sum(s.values()); dist={k:round(v/ts,4) for k,v in s.items()} if ts>0 else {k:1/len(s) for k in s}; dom=max(dist,key=dist.get); conf=dist[dom]; ent=-sum(p*math.log(max(p,1e-12)) for p in dist.values()); last=self._last_dna if self._dna_valid else None; stab=round(1.0-sum(abs(dist.get(k,0)-last.get(k,0)) for k in set(dist)|set(last))/2,4) if last else None; age=(self._dna_age+1 if max(last,key=last.get)==dom else 1) if last else 1; vel={a:round(dist[a]-last.get(a,0),4) for a in dist} if last else None; sp=sorted(dist.values(),reverse=True); pres=round(1-(sp[0]-sp[1]),4); ep=round(1-min(len(self.nodes)/100,1.0),4); hist=(self._dna_hist+[dist.copy()])[-cfg.DNA_HISTORY_MAX:]; ma=dist.copy()
        for h in reversed(hist[:-1]):
            for k in ma: ma[k]=0.6*ma[k]+0.4*h.get(k,0)
        tm=sum(ma.values()); mv={k:round(v/tm,4) for k,v in ma.items()} if tm>0 else {k:1/len(ma) for k in ma}; persist=(self._dna_persist+1 if max(hist[-2],key=hist[-2].get)==dom else 1) if len(hist)>=2 else 1
        interps={"TrendingUp":"Strong upward bias","TrendingDown":"Strong downward bias","Ranging":"Congested balanced directionality","Breakout":"Rapid multi-zone expansion","Reversing":"High mirror symmetry - structural reversal","LowVol":"Low volatility, muted transitions"}
        out={"distribution":dist,"dominant_state":dom,"confidence":round(conf,4),"entropy":round(ent,4),"stability":stab,"pressure":pres,"age":age,"velocity":vel,"epistemic":ep,"interpretation":interps[dom],"persistence":persist,"moving_average":mv}
        if commit: self._last_dna=dist.copy(); self._dna_valid=True; self._dna_age=age; self._dna_vel=vel; self._dna_hist=hist; self._dna_persist=persist; self._dna_cache=out; self._dna_cache_step=self._global_step
        return out
    def ema_sensor(self,qp):
        n=len(self.price_hist)
        if n<cfg.EMA_PERIOD: return {"available":False,"message":f"Need {cfg.EMA_PERIOD} prices (have {n})"}
        if qp is None: return {"available":False,"message":"No query price"}
        prices=[p for p,_ in self.price_hist]; al=2/(cfg.EMA_PERIOD+1); ema=prices[0]; devs=[]
        for p in prices: ema=p*al+ema*(1-al); devs.append(p-ema)
        dev=qp-ema; ma=max(abs(d) for d in devs); ca=abs(dev); pct=sum(1 for d in devs if abs(d)<ca)/len(devs)
        if pct>0.8: rp=min(0.6+0.4*(pct-0.8)/0.2,1.0)
        elif pct>0.6: rp=0.3+0.3*(pct-0.6)/0.2
        elif pct>0.4: rp=0.1+0.2*(pct-0.4)/0.2
        else: rp=0.1*pct/0.4
        rp=round(max(0.0,min(1.0,rp)),3); ratio=ca/max(ma,1e-9); cls=(f"extended_{'above' if dev>0 else 'below'}" if ratio>0.8 else f"{'above' if dev>0 else 'below'}_mean" if ratio>0.5 else "near_mean")
        if ca<self._avg_vol()*0.5: cls="compressed"
        nt,et=cfg.EMA_BAND_NEAR_MAX*ma,cfg.EMA_BAND_EXTENDED*ma; order={"near":0,"moderate":1,"extended":2}; band=lambda d:"near" if d<=nt else "moderate" if d<=et else "extended"; eps={b:{"total":0,"rev":0,"cont":0,"sr":[],"sc":[]} for b in order}; pb=es=None
        for i,d in enumerate(devs):
            cb=band(abs(d))
            if cb!=pb:
                if pb is not None:
                    k,l=("rev","sr") if order[cb]<order[pb] else ("cont","sc"); eps[pb][k]+=1; eps[pb][l].append(i-es)
                es=i; eps[cb]["total"]+=1; pb=cb
        bands={}
        for bn,d in eps.items():
            te=d["rev"]+d["cont"]
            if not d["total"]: bands[bn]={"episodes":0,"reversion_prob":None,"continuation_prob":None}; continue
            avg=lambda l:round(sum(l)/len(l),2) if l else None; bands[bn]={"episodes":d["total"],"reversion_prob":round(d["rev"]/te,4) if te else None,"continuation_prob":round(d["cont"]/te,4) if te else None,"avg_steps_rev":avg(d["sr"]),"avg_steps_cont":avg(d["sc"])}
        return {"available":True,"ema_value":round(ema,4),"current_deviation":round(dev,4),"deviation_percentile":round(pct,4),"reversion_probability":rp,"classification":cls,"data_points":n,"ema_period":cfg.EMA_PERIOD,"bands":bands}
    def convergence_sensor(self,ssv):
        S=[]; regime=ssv.get("internal_regime"); dn=ssv.get("local_density",0)
        if regime in ("UP","DOWN"): S.append(("regime",1 if regime=="UP" else -1,min(0.5+0.05*dn,0.95) if dn else 0.5))
        nd=ssv.get("net_flow_direction",0.0)
        if abs(nd)>0.1: S.append(("vector_field",_sgn(nd),min(abs(nd),1.0)))
        ema=ssv.get("ema_sensor",{})
        if ema.get("available"):
            ec,rp=ema.get("classification"),ema.get("reversion_probability",0.5)
            if ec in ("extended_above","extended_below") and rp>0.5: S.append(("ema",-1 if "above" in ec else 1,rp))
        fd=ssv.get("fwd_distributions",[])
        if len(fd)>=2:
            sv=_zone_val(ssv.get("observed_zone","")); tp=sum(fd[1].values()); ed=sum(p*_sgn(_zone_val(z)-sv) for z,p in fd[1].items())/tp if tp>0 else 0.0; d=1 if ed>0.15 else -1 if ed<-0.15 else 0
            if d: S.append(("forward_trace",d,round(min(abs(ed),1.0),4)))
        cis=ssv.get("cis_sensor",{})
        if cis.get("active") and cis.get("mode")=="historical_resolution" and cis.get("direction") in ("UP","DOWN"): S.append(("cis",1 if cis["direction"]=="UP" else -1,cis["confidence"]))
        if len(S)<2: return {"available":False,"message":f"{len(S)} sensor(s) (need >=2)"}
        tp=twa=0.0
        for a,b in combinations(S,2):
            w=min(a[2],b[2]); tp+=w
            if a[1]==b[1]: twa+=w
        wpa=twa/tp if tp else 0.0; tw=sum(s[2] for s in S); wa=sum(s[1]*s[2] for s in S)/tw if tw else 0.0; eff=cs=abs(wa); h=self._agree_hist; hl=len(h); az=0.0
        if hl>=5:
            mean=sum(h)/hl; std=math.sqrt(sum((x-mean)**2 for x in h)/hl) or 1e-9; az=(wpa-mean)/std
        if hl>=5 and abs(az)>0.1: cls=("HIGH_CONVICTION" if az>2.0 else "MODERATE_CONVICTION" if az>1.5 or (eff>0.7 and az>1.0) else "CONTRADICTORY" if az<-1.5 else "LOW_CONVICTION")
        else: cls=("HIGH_CONVICTION" if eff>0.8 and wpa>0.7 else "MODERATE_CONVICTION" if eff>0.6 or wpa>0.5 else "CONTRADICTORY" if wpa<0.3 else "LOW_CONVICTION")
        interps={"HIGH_CONVICTION":"Sensors converge - meaningful structural agreement" if hl>=5 else "Sensors converge - first-run, no history yet to call it anomalous","MODERATE_CONVICTION":"Moderate convergence - within expected range","LOW_CONVICTION":"Weak convergence - sensors ambiguous","CONTRADICTORY":"Sensors disagree - structure transitioning"}
        ups=sum(1 for s in S if s[1]>0)
        return {"available":True,"sensors_total":len(S),"sensors_agreeing":max(ups,len(S)-ups),"pairwise_agreement":round(wpa,4),"convergence_strength":round(cs,4),"effective_strength":round(eff,4),"anomaly_z":round(az,4),"direction":"UP" if wa>0.2 else "DOWN" if wa<-0.2 else "SIDEWAYS","classification":cls,"interpretation":interps[cls],"sensor_details":[{"name":n,"direction":"UP" if d>0 else "DOWN","confidence":round(c,4)} for n,d,c in S]}
    def _record_agreement(self,conv):
        if conv.get("available") and self._agree_step!=self._global_step: self._agree_hist=(self._agree_hist+[conv["pairwise_agreement"]])[-cfg.CONVERGENCE_HISTORY_SIZE:]; self._agree_step=self._global_step
    def _sensor_notes(self,ssv):
        notes=[]; regime=ssv.get("internal_regime","SIDEWAYS"); nd=ssv.get("net_flow_direction",0.0)
        if regime=="UP" and nd<-0.15: notes.append("[Contradiction] UP regime but downward flow")
        elif regime=="DOWN" and nd>0.15: notes.append("[Contradiction] DOWN regime but upward flow")
        if regime=="SIDEWAYS" and abs(nd)>0.5: notes.append(f"[Mixed] SIDEWAYS regime but strong {'upward' if nd>0 else 'downward'} flow bias")
        ema=ssv.get("ema_sensor",{}); conv=ssv.get("convergence_sensor",{})
        if ema.get("available") and ema.get("reversion_probability",0)>0.5:
            ec=ema.get("classification")
            if ec=="extended_below" and regime=="UP": notes.append("[Alignment] Extended below EMA + UP regime - mean-reversion long setup")
            if ec=="extended_above" and regime=="DOWN": notes.append("[Alignment] Extended above EMA + DOWN regime - mean-reversion short setup")
        if conv.get("classification")=="HIGH_CONVICTION": notes.append("[Alignment] Independent sensors converge strongly")
        elif conv.get("classification")=="CONTRADICTORY": notes.append("[Warning] Sensors disagree - possible structural transition")
        cis=ssv.get("cis_sensor",{})
        if cis.get("active"):
            if cis.get("mode")=="instability": notes.append("[Structural Instability] Contradiction pattern resembles prior shifts - directional confidence may be unreliable")
            elif cis.get("direction"): notes.append(f"[CIS] Historical contradiction resolution supports current consensus ({cis['direction']})")
        return notes
    def _contradiction(self,regime,nd,cls,mir_sim,conv_z=None):
        s=0.0; hint=None
        if regime=="UP" and nd<-0.1: s+=0.4+min(abs(nd),0.5); hint="UP regime contradicts downward flow"
        elif regime=="DOWN" and nd>0.1: s+=0.4+min(nd,0.5); hint="DOWN regime contradicts upward flow"
        elif regime=="SIDEWAYS" and abs(nd)>0.3: s+=0.2+min(abs(nd),0.5)*0.5; hint="SIDEWAYS but biased flow"
        if cls=="attractor" and nd<-0.2: s+=0.2; hint=hint or "Attractor losing gravity"
        elif cls=="repeller" and nd>0.2: s+=0.2; hint=hint or "Repeller gaining strength"
        if mir_sim>0.5 and regime!="SIDEWAYS": s+=0.1; hint=hint or "Mirror symmetry contradicts directional regime"
        if conv_z and abs(conv_z)>1.5: s+=min(abs(conv_z),3)/3*0.2; hint=f"{hint} (conv anomaly {conv_z:.2f})" if hint else f"Convergence anomaly {conv_z:.2f}"
        return round(min(s,1.0),2),hint
    def _completion_hyp(self,ssv):
        cm={"HIGH":1.0,"RESOLVED_MATCH":0.9,"MEDIUM":0.7,"LOW":0.4,"AMBIGUOUS":0.3,"NO_MATCH":0.1,"INVALID":0.0}; ld=ssv.get("local_density",1); dew=round((cm.get(ssv.get("match_confidence","LOW"),0.4)+min(ld/10,1.0)+(1.0 if ld>=4 else 0.5))/3,4); vfw=1.0 if ssv.get("zone_classification") in ("attractor","repeller") else 0.5; ts=ssv.get("exit_probability",0.0); ms=ssv.get("mirror_similarity",0.0); ds=ssv.get("dna_profile",{}).get("confidence",0.0); gcw=round((vfw+ts+ms+ds)/4,4); raw=(cfg.COMPLETION_WEIGHT_DIRECT*dew+cfg.COMPLETION_WEIGHT_GRAPH*gcw)*(1-0.2*ssv.get("contradiction_strength",0.0)); cs=round(max(0.0,min(1.0,raw)),4); inf=[]
        if vfw>0.6: inf.append(f"Zone '{ssv.get('zone_classification')}' from attractor score")
        if ts>0.3: inf.append(f"Exit {ssv.get('dominant_exit')} at {int(ts*100)}%")
        if ms>0.3: inf.append(f"Mirror symmetry {ms:.2f}")
        if ds>0.3: inf.append(f"DNA {ssv.get('dna_profile',{}).get('dominant_state')}")
        fts=ssv.get("fwd_structured",[])
        for tag,label in (("RECONSTRUCTION","Reconstruction"),("SPECULATIVE","Speculative")):
            hs=[h["zone"] for h in fts if h["status"]==tag]
            if hs: inf.append(f"{label}: {' -> '.join(hs)}")
        return {"direct_evidence":dew,"graph_completion":gcw,"completion_strength":cs,"completion_risk":round(1-cs,4),"inferences":inf[:5]}
    def _combined_conf(self,mc,nc,entropy,ep,stab=None,persist=0):
        cm={"HIGH":0.9,"RESOLVED_MATCH":0.85,"MEDIUM":0.6,"LOW":0.35,"AMBIGUOUS":0.2,"NO_MATCH":0.1,"INVALID":0.0}; ms=cm.get(mc,0.3); df=min(nc/20,1.0); ef=max(0.0,1-entropy/2.5) if entropy>0 else 0.5; epf=1-ep; rsf=0.5+0.5*max(0.0,min(1.0,stab))*min(persist/5.0,1.0) if stab is not None else 0.5; return {"overall":round(max(0,min(1,(ms+df+ef+epf+rsf)/5)),4),"match":round(ms,4),"density":round(df,4),"entropy":round(ef,4),"epistemic":round(epf,4),"stability":round(rsf,4)}
    def _confidence_estimate(self,density_factor,contradiction): return round(0.4*density_factor+0.6*(1.0-contradiction),4)
    def _zone_state(self,zone,vf):
        an=self._cluster(zone); v=vf.get(zone,{}); cs,_=self._contradiction(an["regime"],v.get("net_direction",0.0),v.get("classification","neutral"),0.0); return cs,self._confidence_estimate(min(an["node_count"]/10.0,1.0),cs),_norm_entropy(list(self.ct.probs(zone).values()))
    def _observe_adapt(self,from_node,to_node,edge,vf):
        fz,tz=from_node.price_zone,to_node.price_zone
        if fz==tz or "Z?" in (fz,tz): return
        a,b=self._zone_state(fz,vf),self._zone_state(tz,vf); edge.epistemic_count+=1; n=edge.epistemic_count
        for attr,delta in (("mu_entropy",b[2]-a[2]),("mu_contradiction",b[0]-a[0]),("mu_confidence",b[1]-a[1])): setattr(edge,attr,getattr(edge,attr)+(round(delta,4)-getattr(edge,attr))/n)
        edge.recompute_weight()
    def _nmd_summary(self,results):
        cand=results[:cfg.NMD_TOPK]; scores=[max(r["total"],0.0) for r in cand]; s=sum(scores)
        if s<=0 or len(scores)<2: return {"entropy":0.0,"entropy_label":"low","hypothesis_count":len(scores),"dominant_score":scores[0] if scores else 0.0,"second_score":0.0,"spread":0.0,"alternatives":[]}
        ne=round(_norm_entropy([x/s for x in scores]),4); label="low" if ne<cfg.NMD_ENTROPY_LOW else "medium" if ne<cfg.NMD_ENTROPY_HIGH else "high"
        return {"entropy":ne,"entropy_label":label,"hypothesis_count":len(cand),"dominant_score":scores[0],"second_score":scores[1],"spread":round(scores[0]-scores[1],4),"alternatives":[{"zone":r.get("zone","Z?"),"score":r["total"],"price":r.get("price")} for r in cand[1:4]]}
    def _cis_pending_n(self): return sum(len(v) for v in self.cis_pending.values())
    def _cis_snapshot(self,ssv):
        nd=ssv.get("net_flow_direction",0.0); ema=ssv.get("ema_sensor",{}); conv=ssv.get("convergence_sensor",{}); ms=ssv.get("mirror_similarity",0.0); cs=ssv.get("contradiction_strength",0.0); sp=ssv.get("component_spread",0.0)
        return {"regime":ssv.get("internal_regime","SIDEWAYS"),"vector_field_bin":"UP" if nd>0.15 else "DOWN" if nd<-0.15 else "FLAT","ema_class":ema.get("classification","none") if ema.get("available") else "none","mirror_bin":"high" if ms>0.5 else "med" if ms>0.3 else "low","contradiction_bin":"low" if cs<0.3 else "med" if cs<0.6 else "high","convergence_class":conv.get("classification","none") if conv.get("available") else "none","sensor_vector":tuple((s["name"],s["direction"]) for s in conv.get("sensor_details",[])),"component_spread_bin":"low" if sp<0.2 else "med" if sp<0.4 else "high"}
    def _cis_distance(self,a,b):
        W={"regime":0.25,"vector_field_bin":0.25,"ema_class":0.15,"mirror_bin":0.10,"contradiction_bin":0.15,"convergence_class":0.05,"component_spread_bin":0.05}; d=sum(w for k,w in W.items() if a.get(k)!=b.get(k)); va={tuple(x) for x in a.get("sensor_vector",())}; vb={tuple(x) for x in b.get("sensor_vector",())}
        if va or vb: d+=0.1*(1-len(va&vb)/max(len(va|vb),1))
        return round(d,4)
    def _cis_schedule(self,ssv):
        cs=ssv.get("contradiction_strength",0.0); types=[]
        if cs>=cfg.CIS_CONTRADICTION_THRESHOLD: types.append("full")
        elif cs>=cfg.CIS_MILD_TENSION_MIN: types.append("mild")
        if ssv.get("component_spread",0.0)>=cfg.CIS_COMPONENT_SPREAD_MIN: types.append("component")
        if not types: return
        snap=self._cis_snapshot(ssv); zone=ssv["observed_zone"]
        for t in types:
            lst=self.cis_pending[t]
            if any(e["start_step"]==self._global_step and e["start_zone"]==zone for e in lst): continue
            lst.append({"snapshot":snap,"start_zone":zone,"start_step":self._global_step,"type":t,"start_regime":ssv["internal_regime"],"start_dna_stability":ssv.get("dna_profile",{}).get("stability")})
    def _cis_scheduler(self):
        for lst in self.cis_pending.values():
            due=[e for e in lst if self._global_step-e["start_step"]>=cfg.CIS_OUTCOME_STEPS]
            for e in due: self._cis_finalize(e,self.last_zone); lst.remove(e)
    def _cis_finalize(self,ev,cur_zone):
        sz=ev["start_zone"]
        if sz is None or cur_zone is None: return
        d=_sgn(_zone_val(cur_zone)-_zone_val(sz)); direction="UP" if d>0 else "DOWN" if d<0 else "SIDEWAYS"; zn=[n for n in self.nodes.values() if n.price_zone==sz]; regime_changed=ev["start_regime"]!=(detect_regime(zn) if zn else "?"); stab=self.dna_distribution(commit=False).get("stability"); reorg=(direction!="SIDEWAYS")+regime_changed; s0=ev.get("start_dna_stability")
        if s0 is not None and stab is not None and stab>s0+0.1: reorg+=1
        self.cis_episodes.append({"snapshot":ev["snapshot"],"type":ev.get("type","full"),"timestamp":time.time(),"steps_to_outcome":self._global_step-ev["start_step"],"outcome":{"direction":direction,"regime_changed":regime_changed,"convergence_resolved":False,"stability_after":stab,"reorg_score":reorg}}); self._cis_prune()
    def _cis_prune(self):
        cutoff=time.time()-cfg.CIS_DECAY_AGE_DAYS*86400; eps=[e for e in self.cis_episodes if e["timestamp"]>cutoff]; self.cis_episodes=sorted(eps,key=lambda x:x["timestamp"],reverse=True)[:cfg.CIS_MAX_EPISODES]
    def _cis_sensor(self,ssv):
        dna=ssv.get("dna_profile",{}); cs=ssv.get("contradiction_strength",0.0); stab=dna.get("stability"); stab=0.5 if stab is None else stab
        if cs>=cfg.CIS_PRE_TRANSITION_CONTRADICTION_MIN and stab<=cfg.CIS_PRE_TRANSITION_STABILITY_MAX and dna.get("pressure",1.0)>=cfg.CIS_PRE_TRANSITION_PRESSURE_MIN: return {"active":True,"mode":"instability","message":"Structural instability detected - past similar contradiction patterns preceded representational shifts"}
        snap=self._cis_snapshot(ssv); matches=[]
        for ep in self.cis_episodes:
            d=self._cis_distance(snap,ep["snapshot"])
            if d<cfg.CIS_SIMILARITY_THRESHOLD: matches.append((ep,math.exp(-cfg.CIS_KERNEL_BETA*d)))
        off=lambda reason:{"active":False,"reason":reason,"match_count":len(matches),"contradiction_strength":cs,"episode_count":len(self.cis_episodes),"pending_count":self._cis_pending_n()}
        if len(matches)<cfg.CIS_MIN_MATCHES: return off("insufficient_data")
        scores={"UP":0.0,"DOWN":0.0,"SIDEWAYS":0.0}; reorg=0.0
        for ep,w in matches: scores[ep["outcome"]["direction"]]+=w; reorg+=ep["outcome"].get("reorg_score",0)*w
        tot=sum(scores.values()) or 1e-9; probs={k:v/tot for k,v in scores.items()}; ent=-sum(p*math.log(p+1e-9) for p in probs.values()); direction=max(probs,key=probs.get); conf=min(probs[direction],cfg.CIS_CONFIDENCE_CAP); avg_reorg=round(reorg/len(matches),2); conv_dir=ssv.get("convergence_sensor",{}).get("direction","SIDEWAYS")
        if direction!=conv_dir:
            if self.cis_verbose: return {"active":True,"mode":"silent_disagreement","direction":direction,"confidence":conf,"match_count":len(matches),"entropy":ent,"consensus":conv_dir,"avg_reorg":avg_reorg,"note":f"CIS direction {direction} disagrees with consensus {conv_dir} - suppressed"}
            return off("direction_mismatch")
        return {"active":True,"mode":"historical_resolution","direction":direction,"confidence":conf,"entropy":round(ent,4),"match_count":len(matches),"avg_reorg":avg_reorg,"probs":{k:round(v,4) for k,v in probs.items()}}
    def build_ssv(self,results,vf=None,commit=False,query_price=None):
        # R is pure by default. commit=True only from B / explicit commit path.
