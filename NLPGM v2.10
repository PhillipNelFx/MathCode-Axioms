            if fp is not None and tp is not None: ae1="UP" if tp>fp else "DOWN" if tp<fp else "FLAT"
        regime=ssv["internal_regime"]; lsr=ssv.get("exit_direction") or "N/A"; norm=lambda r:"FLAT" if r=="SIDEWAYS" else r; a,b,c=norm(regime),lsr,ae1; config=("INCOMPLETE" if "N/A" in (b,c) else "CONVERGENCE" if a==b==c else "PARTIAL CONVERGENCE" if a==b or a==c or b==c else "DIVERGENCE"); L.append(""); rule(); L+=[" TASO STATE [Diagnostic]",f" Regime {regime}",f" LSR {lsr}",f" AE1-EW {ae1}"]
        if local and ae1!="N/A": L.append(f" AE1-EW determined by: {fs[:12]} -> {ts_[:12]} (ew={mx:.4f}, margin={margin:.4f}) - {'WEAK, fragile' if margin is not None and margin<0.01 else 'OK' if margin is not None and margin>=0.05 else 'MARGINAL'}")
        ssv["taso_margin"]=margin; L+=[f" TASO {regime} / {lsr} / {ae1}",f" Configuration {config}"]; rule()
        if epi: sec("TOP EPISTEMIC TRANSITIONS (L)")
        for i,(x,y,w,_) in enumerate(epi[:3],1): L.append(f" {i}. {x[:12]:<12} -> {y[:12]:<12} epistemic_weight={w:.4f}")
        dna=ssv["dna_profile"]
        if "distribution" in dna:
            sec("MARKET DNA"); row("Dominant",f"{dna['dominant_state']} conf={dna['confidence']:.2f}"); sb=f"{dna['stability']:.2f}" if dna.get("stability") is not None else "N/A"; row("Entropy/Stab/Pres",f"{dna['entropy']:.2f} / {sb} / {dna['pressure']}"); row("Age / Persistence",f"{dna['age']} / {dna['persistence']}"); row("MA dominant",max(dna["moving_average"],key=dna["moving_average"].get)); L.append(" Distribution:")
            for arch,p in sorted(dna["distribution"].items(),key=lambda x:-x[1]): L.append(f" {arch:<14}{p:.3f}{bar(p)}")
            L.append(f" {dna['interpretation']}")
        cc=ssv["combined_confidence"]; sec("STRUCTURAL CONFIDENCE"); L.append(f" Overall: {cc['overall']:.2f}{bar(cc['overall'])}")
        for k,lab in (("match","Match"),("density","Density"),("entropy","Entropy"),("epistemic","Epistemic"),("stability","Regime stab")): row(lab,f"{cc[k]:.2f}")
        comp=ssv["completion_hypothesis"]; sec("COMPLETION HYPOTHESIS"); row("Direct evidence",f"{comp['direct_evidence']:.2f}"); row("Graph completion",f"{comp['graph_completion']:.2f}"); L.append(f" Strength: {comp['completion_strength']:.2f}{bar(comp['completion_strength'])} (risk {comp['completion_risk']:.2f})")
        if comp["inferences"]: L+=[" Inferences:"]+[f" - {i}" for i in comp["inferences"]]
        sec("VECTOR FIELD")
        for z,v in sorted(vf.items(),key=lambda x:_zone_val(x[0])): sym="UP" if v["net_direction"]>0.1 else "DOWN" if v["net_direction"]<-0.1 else "FLAT"; L.append(f" {z:<12}{sym} net={v['net_direction']:+.2f} mag={v['magnitude']:.2f} {v['classification']:<10}{' <- current' if z==zone else ''}")
        sec(f"TRANSITIONS FROM {zone}"); an=self._cluster(zone)
        for t,prob in an["transitions"].items():
            arr={1:"UP",-1:"DOWN",0:"->"}[_sgn(_zone_val(t)-_zone_val(zone))]; med=self.median_price(t); st=self.ct.avg_steps(zone,t); L.append(f" {arr}{t:<12}{int(prob*100):>3}%{f' med~{med:.2f}' if med else ''} {f' {st} steps' if st else ''}")
        if not an["transitions"]: L.append(" (no transitions recorded)")
        if dmap.get("path_to_equilibrium"): sec("STATE DISTANCE MAP"); row("Nearest attractor",str(dmap["nearest_attractor"])); row("Nearest repeller",str(dmap["nearest_repeller"])); row("Path to equilibrium"," -> ".join(dmap["path_to_equilibrium"])); row("Steps",str(dmap["equilibrium_steps"]))
        sec("PATTERNS"); L+=[f" Dominant: {ssv['dominant_pattern']} ({ssv['pattern_freq']}x)",f" Total stored: {len(self.patterns)}"]; rule("="); L.append(""); return "\n".join(L)
    def status_report(self):
        W=54; L=[""," ┌"+"-"*W+"┐",f" │ {VERSION:<{W-9}}│",f" │ nodes={len(self.nodes)} patterns={len(self.patterns)} cycles={self.cycles:<{W-43}}│",f" │ CIS episodes={len(self.cis_episodes)} pending={self._cis_pending_n()} verbose={'ON' if self.cis_verbose else 'OFF':<{W-20}}│"," └"+"-"*W+"┘"]
        if not self.nodes: return "\n".join(L+[" (empty)"])
        zones=sorted({n.price_zone for n in self.nodes.values() if n.price_zone!="Z?"},key=_zone_val)
        if zones:
            L.append("\n ZONES:")
            for z in zones:
                an=self._cluster(z); dom=f"->{an['dominant']}({int(an['dominant_prob']*100)}%)" if an["dominant"] else ""; L.append(f" {z:<12} nodes={an['node_count']} [{an['regime']}]{dom}")
        if self._recent: L+=[f"\n RECENT TRANSITIONS ({len(self._recent)}):",f" {'->'.join(self._recent[-12:])}"]
        if self.patterns:
            L.append("\n TOP PATTERNS:")
            for p in sorted(self.patterns.values(),key=lambda x:-x.hits)[:5]: L.append(f" [{'DIR' if p.start_zone=='DIR?' else 'MAG'}][{p.hits:.1f}x] {p.display} age={fmt_age(p.age())}")
        return "\n".join(L+[""])
    def save(self):
        data={"nlpgm_version":VERSION,"cycles":self.cycles,"nodes":{k:v.to_dict() for k,v in self.nodes.items()},"patterns":{k:v.to_dict() for k,v in self.patterns.items()},"cluster_transitions":self.ct.to_dict(),"recent_transitions":self._recent,"last_step_price":self._last_step_price,"v1_4_step_counter":self._step_counter,"v1_4_last_zone":self.last_zone,"_last_strand":self._last_strand,"_last_dna_distribution":self._last_dna,"_dna_stability_valid":self._dna_valid,"_dna_age":self._dna_age,"_dna_velocity":self._dna_vel,"_dna_hist":self._dna_hist,"_dna_persist":self._dna_persist,"price_history":self.price_hist,"agree_hist":self._agree_hist,"cis_verbose":self.cis_verbose,"cis_episodes":self.cis_episodes,"cis_pending":self.cis_pending,"_global_step":self._global_step}
        try:
            with open(cfg.TEMP_FILE,"w") as f: json.dump(data,f,separators=(",",":"))
            if os.path.exists(cfg.SAVE_FILE): shutil.copy2(cfg.SAVE_FILE,cfg.BACKUP_FILE)
            os.replace(cfg.TEMP_FILE,cfg.SAVE_FILE); return f"Saved - {len(self.nodes)} nodes - {len(self.patterns)} patterns"
        except Exception as ex: return f"Save failed: {ex}"
    def load(self):
        if not os.path.exists(cfg.SAVE_FILE): return "No save file - starting clean"
        try:
            with open(cfg.SAVE_FILE) as f: d=json.load(f)
            sv=d.get("nlpgm_version","?")
            if sv!=VERSION: _log("LOAD",f"version mismatch: file={sv} current={VERSION}")
            self.cycles=d.get("cycles",0); self.nodes={}; self.patterns={}; self.ct=ClusterTransitions(); self._recent=d.get("recent_transitions",[]); self._last_step_price=d.get("last_step_price"); self._step_counter=d.get("v1_4_step_counter",0); self.last_zone=d.get("v1_4_last_zone"); self.cis_verbose=d.get("cis_verbose",cfg.CIS_VERBOSE); self.cis_episodes=d.get("cis_episodes",[]); cp=d.get("cis_pending",{})
            if isinstance(cp,list): cp={"full":cp,"mild":d.get("cis_pending_mild",[]),"component":d.get("cis_pending_component",[])}
            self.cis_pending={k:cp.get(k,[]) for k in ("full","mild","component")}; self._global_step=d.get("_global_step",0)
            if "cluster_transitions" in d: self.ct.load(d["cluster_transitions"])
            for sig,pd in d.get("patterns",{}).items():
                p=PatternNode(pd.get("transitions",[]),sig,pd.get("start_zone","Z?")); p.hits=float(pd.get("hits",1)); p.created_at=pd.get("created_at",0.0); self.patterns[sig]=p
            li=0; last=None
            for val,nd in d.get("nodes",{}).items():
                st=nd.get("strand_type"); st=li%2 if st is None else st; dr=nd.get("dna",{})
                if isinstance(dr,int): dr={"category":dr,"strand_type":st,"price_zone":nd.get("price_zone","Z?"),"fingerprint":"","path_signature":"","display":f"{dr:08b}"}
                elif isinstance(dr,dict):
                    if dr.get("strand_type") is None: dr["strand_type"]=st
                    dr.setdefault("price_zone",nd.get("price_zone","Z?"))
                n=Node(nd["value"],hits=nd.get("hits",0),dna=dr,price=nd.get("price"),volatility=nd.get("volatility"),strand_type=st)
                if "created_at" in nd: n.created_at=nd["created_at"]
                self.nodes[val]=n; last=st; li+=1
            self._last_strand=d.get("_last_strand",last); self._last_dna=d.get("_last_dna_distribution"); self._dna_valid=d.get("_dna_stability_valid",False); self._dna_age=d.get("_dna_age",0); self._dna_vel=d.get("_dna_velocity"); self._dna_hist=d.get("_dna_hist",[]); self._dna_persist=d.get("_dna_persist",0); self._dna_cache=None; self.price_hist=d.get("price_history",[]); self._agree_hist=d.get("agree_hist",[])
            for val,nd in d.get("nodes",{}).items():
                n=self.nodes[val]
                for lv,ed in nd.get("links",{}).items():
                    if lv in self.nodes: n.links[lv]=Edge.from_dict(ed)
                n.refresh_dna()
            return f"Loaded - {len(self.nodes)} nodes - {len(self.patterns)} patterns"
        except Exception as ex: return f"Load failed: {ex}"
def _fmt_elapsed(s):
    if s<1: return f"{s*1000:.0f}ms"
    return f"{s:.2f}s"
def _now_str():
    return time.strftime("%H:%M:%S", time.localtime())
def _menu():
    print("\n ┌"+"-"*52+"┐"); print(f" │ {VERSION:<45}│"); print(" ├"+"-"*52+"┤")
    for k,t in (("R","Reconstruct (structural report)"),("B","Batch add prices"),("D","Run decay cycle"),("S","Status / graph summary"),("W","Save"),("V","Toggle CIS verbose"),("F","FLSR + Forward Trace (read-only)"),("X","Exit")): print(f" │ {k} - {t:<45}│")
    print(" └"+"-"*52+"┘")
def main():
    db=MemoryDB(); _log("BOOT",db.load())
    while True:
        _menu(); c=input("\n Select > ").strip().upper()
        if c=="R":
            q=input(" Query > ").strip()
            if q:
                _t0=time.time(); _t0s=_now_str(); _log("LSR",f"reconstructing for: {q} - started at {_t0s}"); print(db.structural_report(q)); _log("R-TIME",f"LSR execution: {_fmt_elapsed(time.time()-_t0)} - started {_t0s}, finished {_now_str()}")
        elif c=="B":
            print(" Paste prices (empty line to finish):"); lines=[]
            while True:
                line=input(" ")
                if not line.strip(): break
                lines.append(line)
            if lines: _log("BATCH",db.batch_add("\n".join(lines))); _log("SAVE",db.save())
        elif c=="D": _log("DECAY",db.decay_cycle()); _log("SAVE",db.save())
        elif c=="S": print(db.status_report())
        elif c=="W": _log("SAVE",db.save())
        elif c=="V": db.cis_verbose=not db.cis_verbose; _log("CIS-VERBOSE","ON" if db.cis_verbose else "OFF")
        elif c=="F":
            _t0=time.time(); _t0s=_now_str(); _log("FLSR",f"Launching suite on extracted price_hist copy - started at {_t0s}"); series_copy=[list(x) for x in db.price_hist]; exp=FLSRAnalysis(FLSR_CFG["SEED"]); print(exp.full_protocol_report(series_copy)); print(""); print(_flsr_forward_report(db.price_hist, dna=db.dna_distribution())); _log("F-TIME",f"FLSR execution: {_fmt_elapsed(time.time()-_t0)} - started {_t0s}, finished {_now_str()}"); _log("FLSR","Run complete - production state untouched")
        elif c=="X": _log("SAVE",db.save()); _log("EXIT","Goodbye"); break
        else: _log("ERR","Unknown option")
if __name__=="__main__": main()
