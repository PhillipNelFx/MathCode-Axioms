    def snap(self, coord):
        return round(coord / CELL_SIZE) * CELL_SIZE

    def draw_node(self, x, y):
        r = DOT_RADIUS
        item = self.canvas.create_oval(x - r, y - r, x + r, y + r,
                                       fill="white", outline="gray")
        self.node_items[(x, y)] = item

    def draw_user_edge(self, x1, y1, x2, y2):
        line = self.canvas.create_line(x1, y1, x2, y2, fill="white", width=2)
        self.edge_items.add(line)

    def clear_overlays(self):
        for item in self.overlay_items:
            self.canvas.delete(item)
        self.overlay_items.clear()

    def redraw_all(self):
        self.canvas.delete("all")
        self.node_items.clear()
        self.edge_items.clear()
        self.overlay_items.clear()
        for n in self.graph.nodes:
            self.draw_node(*n)
        for e in self.graph.edges:
            (x1, y1), (x2, y2) = e
            self.draw_user_edge(x1, y1, x2, y2)

    def find_closest_node(self, mx, my):
        best, best_d = None, float("inf")
        for n in self.graph.nodes:
            d = math.hypot(n[0] - mx, n[1] - my)
            if d < best_d:
                best_d = d
                best = n
        return best, best_d

    def _update_memory_list(self):
        self.proto_listbox.delete(0, tk.END)
        for e in self.memory.entries:
            self.proto_listbox.insert(tk.END, e["name"])
        self.status_label.config(
            text=f"Memory: {len(self.memory.entries)} prototypes")

    def delete_prototype(self):
        sel = self.proto_listbox.curselection()
        if sel:
            name = self.proto_listbox.get(sel[0])
            self.memory.remove(name)
            ok, msg = self.memory.save()
            if ok:
                self._update_memory_list()
                self.run_pipeline()
            else:
                messagebox.showerror("Save Error", msg)

    def save_prototype(self):
        name = simpledialog.askstring("Prototype Name", "Name:")
        if not name:
            return
        self.memory.add(name, self.graph)
        ok, msg = self.memory.save()
        if ok:
            self._update_memory_list()
            messagebox.showinfo("Saved", msg)
        else:
            messagebox.showerror("Save Error", msg)

    def load_prototypes(self, silent=False):
        ok, msg = self.memory.load()
        self._update_memory_list()
        if not silent:
            if ok:
                messagebox.showinfo("Loaded", msg)
            else:
                messagebox.showwarning("Load Warning", msg)

    def clear_canvas(self):
        self.graph.clear()
        self.stroke_points.clear()
        if self.stroke_line_id:
            self.canvas.delete(self.stroke_line_id)
            self.stroke_line_id = None
        self.redraw_all()
        self.recog_label.config(text="Draw & click Reconstruct")
        self.alt_label.config(text="")
        self.shadow_label.config(text="")

    def auto_connect_nodes(self, new_node):
        if len(self.graph.nodes) < 2:
            return
        others = [n for n in self.graph.nodes if n != new_node]
        if not others:
            return
        others.sort(key=lambda n: math.hypot(n[0] - new_node[0], n[1] - new_node[1]))
        for target in others[:2]:
            dist = math.hypot(new_node[0] - target[0], new_node[1] - target[1])
            if dist > AUTO_CONNECT_MAX_DIST:
                continue
            if frozenset({new_node, target}) not in self.graph.edges:
                self.graph.add_edge(new_node[0], new_node[1], target[0], target[1])
                self.draw_user_edge(new_node[0], new_node[1], target[0], target[1])

    def _on_mode_toggle(self):
        if self.stroke_mode_var.get():
            self.status_label.config(text="Stroke: Drag to draw, Right=delete")
            self.auto_btn.pack_forget()
        else:
            self.status_label.config(text="Manual: Left=node, Drag=edge, Right=delete")
            self.auto_btn.pack(side=tk.LEFT, padx=5, after=self.stroke_btn)

    def _on_press(self, event):
        if self.stroke_mode_var.get():
            self._stroke_press(event)
        else:
            self._manual_press(event)

    def _on_drag(self, event):
        if self.stroke_mode_var.get():
            self._stroke_drag(event)
        else:
            self._manual_drag(event)

    def _on_release(self, event):
        if self.stroke_mode_var.get():
            self._stroke_release(event)
        else:
            self._manual_release(event)

    def _manual_press(self, event):
        x, y = self.snap(event.x), self.snap(event.y)
        closest, dist = self.find_closest_node(event.x, event.y)
        if closest and dist < DOT_RADIUS * 3:
            self.drag_start = closest
        else:
            self.drag_start = None
            if (x, y) not in self.graph.nodes:
                self.graph.add_node(x, y)
                self.draw_node(x, y)
                if self.auto_connect_var.get():
                    self.auto_connect_nodes((x, y))

    def _manual_drag(self, event):
        if self.drag_start:
            if self.active_line:
                self.canvas.delete(self.active_line)
            x1, y1 = self.drag_start
            x2, y2 = self.snap(event.x), self.snap(event.y)
            self.active_line = self.canvas.create_line(x1, y1, x2, y2, fill="gray")

    def _manual_release(self, event):
        if self.drag_start and self.active_line:
            self.canvas.delete(self.active_line)
            self.active_line = None
            x1, y1 = self.drag_start
            x2, y2 = self.snap(event.x), self.snap(event.y)
            if (x2, y2) not in self.graph.nodes:
                self.graph.add_node(x2, y2)
                self.draw_node(x2, y2)
            self.graph.add_edge(x1, y1, x2, y2)
            self.draw_user_edge(x1, y1, x2, y2)
        self.drag_start = None

    def _stroke_press(self, event):
        self.stroke_points = [(event.x, event.y)]
        if self.stroke_line_id:
            self.canvas.delete(self.stroke_line_id)
        self.stroke_line_id = self.canvas.create_line(
            event.x, event.y, event.x+1, event.y, fill="cyan", width=2)

    def _stroke_drag(self, event):
        if self.stroke_points:
            self.stroke_points.append((event.x, event.y))
            flat = [coord for p in self.stroke_points for coord in p]
            if self.stroke_line_id:
                self.canvas.delete(self.stroke_line_id)
            if len(flat) >= 4:
                self.stroke_line_id = self.canvas.create_line(
                    *flat, fill="cyan", width=2)

    def _stroke_release(self, event):
        if not self.stroke_points:
            return
        if len(self.stroke_points) < 2:
            self.stroke_points = []
            return
        if len(self.stroke_points) > STROKE_MAX_POINTS:
            self.stroke_points = self.stroke_points[:STROKE_MAX_POINTS]

        contour = stroke_to_contour(self.stroke_points)
        if not contour:
            self.stroke_points = []
            if self.stroke_line_id:
                self.canvas.delete(self.stroke_line_id)
                self.stroke_line_id = None
            return

        new_graph = contour_to_graph(contour, existing_graph=self.graph)
        self.graph = new_graph

        if self.stroke_line_id:
            self.canvas.delete(self.stroke_line_id)
            self.stroke_line_id = None
        self.stroke_points = []

        self.redraw_all()

    def on_right_click(self, event):
        closest, dist = self.find_closest_node(event.x, event.y)
        if closest and dist < DOT_RADIUS * 3:
            self.graph.remove_node(*closest)
            self.redraw_all()
            self.recog_label.config(text="Draw & click Reconstruct")
            self.alt_label.config(text="")
            self.shadow_label.config(text="")

    # ====================================================================
    # run_pipeline() — Uses main weighted score (NO DTKO)
    # ====================================================================
    def run_pipeline(self):
        self.clear_overlays()
        if not self.graph.nodes:
            self.recog_label.config(text="No nodes drawn")
            self.alt_label.config(text="")
            self.shadow_label.config(text="")
            return

        if not self.memory.entries:
            self.recog_label.config(text="No prototypes in memory")
            self.alt_label.config(text="")
            self.shadow_label.config(text="")
            return

        norm = self.graph.normalised()
        candidates = self.memory.query(norm, top_k=5)
        if not candidates:
            self.recog_label.config(text="No match found")
            self.alt_label.config(text="")
            self.shadow_label.config(text="")
            return

        # Step 1: Shadow overlap for each candidate
        scored_with_shadow = []
        for sc, entry in candidates:
            proto_graph = entry["graph"]
            sh_overlap = compute_shadow_overlap(norm, proto_graph)
            scored_with_shadow.append((sc, sh_overlap, entry))

        # Step 2: Sort by structural score (descending)
        scored_with_shadow.sort(key=lambda x: x[0], reverse=True)

        # Step 3: Shadow-Guided Tie-Breaking
        best_score, best_shadow, best_entry = scored_with_shadow[0]

        if len(scored_with_shadow) > 1:
            second_score, second_shadow, second_entry = scored_with_shadow[1]
            score_delta = best_score - second_score

            if score_delta < 0.05 and (second_shadow - best_shadow) >= 0.20:
                best_score, best_shadow, best_entry = second_score, second_shadow, second_entry
            elif score_delta < 0.01 and second_shadow > best_shadow:
                best_score, best_shadow, best_entry = second_score, second_shadow, second_entry
            elif best_shadow < 0.30 and score_delta < 0.10 and second_shadow >= 0.50:
                best_score, best_shadow, best_entry = second_score, second_shadow, second_entry

        proto_graph = best_entry["graph"]

        # Step 4: Rest of pipeline (reconstruction, overlays, display)
        missing, edge_conf = reconstruct(norm, proto_graph)
        conf = compute_confidence(norm, proto_graph, best_score)

        _, n_label = nmd_entropy([s[0] for s in scored_with_shadow])
        base_thresh = 0.45 if n_label == "high" else 0.35 if n_label == "medium" else 0.25

        if len(scored_with_shadow) > 1 and (scored_with_shadow[0][0] - scored_with_shadow[1][0]) < 0.1:
            blend_edges = {}
            for sc, _, e in scored_with_shadow:
                for ed in e["graph"].edges:
                    blend_edges[ed] = blend_edges.get(ed, 0.0) + sc
            threshold = 0.3 * sum(s[0] for s in scored_with_shadow)
            ambiguous_edges = [ed for ed, w in blend_edges.items()
                               if w >= threshold and ed not in norm.edges]
        else:
            ambiguous_edges = []

        for e in missing:
            (x1n, y1n), (x2n, y2n) = e
            sx1, sy1 = self.graph.denormalize_point(x1n, y1n)
            sx2, sy2 = self.graph.denormalize_point(x2n, y2n)
            color = "green" if edge_conf > 0.6 else "blue"
            line = self.canvas.create_line(sx1, sy1, sx2, sy2, fill=color, width=4)
            self.overlay_items.append(line)
        for e in ambiguous_edges:
            (x1n, y1n), (x2n, y2n) = e
            sx1, sy1 = self.graph.denormalize_point(x1n, y1n)
            sx2, sy2 = self.graph.denormalize_point(x2n, y2n)
            line = self.canvas.create_line(sx1, sy1, sx2, sy2, fill="yellow", width=4)
            self.overlay_items.append(line)

        shadow_text = f"shadow overlap: {best_shadow:.0%}"
        if best_shadow > 0.8:
            self.shadow_label.config(text=shadow_text, fg="light green")
        elif best_shadow > 0.5:
            self.shadow_label.config(text=shadow_text, fg="yellow")
        else:
            self.shadow_label.config(text=shadow_text, fg="red")

        top_sim_pct = best_score * 100
        if best_score >= base_thresh:
            self.recog_label.config(
                text=f"{best_entry['name']}  ({top_sim_pct:.0f}% sim, conf {conf:.0%})")
        else:
            self.recog_label.config(
                text=f"Uncertain (best: {best_entry['name']} {top_sim_pct:.0f}%)")

        alt_parts = [f"{e['name']}({sc * 100:.0f}%)" for sc, _, e in scored_with_shadow[1:]]
        self.alt_label.config(text=" | ".join(alt_parts) if alt_parts else "")
    # ====================================================================

def cross(o, a, b):
    return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])

