# RECONSTRUCTION & CONFIDENCE (unchanged)
# ─────────────────────────────────────────────
def reconstruct(user_graph, prototype, tolerance=EDGE_TOLERANCE):
    missing = []
    matched = 0
    user_edge_list = list(user_graph.edges)
    for proto_edge in prototype.edges:
        (px1, py1), (px2, py2) = proto_edge
        found = False
        for ue in user_edge_list:
            (ux1, uy1), (ux2, uy2) = ue
            d1 = max(math.hypot(px1 - ux1, py1 - uy1),
                     math.hypot(px2 - ux2, py2 - uy2))
            d2 = max(math.hypot(px1 - ux2, py1 - uy2),
                     math.hypot(px2 - ux1, py2 - uy1))
            if min(d1, d2) < tolerance:
                found = True
                break
        if found:
            matched += 1
        else:
            missing.append(proto_edge)
    conf = matched / max(len(prototype.edges), 1)
    return missing, conf

def compute_confidence(user_norm, proto_norm, similarity_score):
    _, edge_conf = reconstruct(user_norm, proto_norm)
    node_ratio = (min(len(user_norm.nodes), len(proto_norm.nodes))
                  / max(len(user_norm.nodes), len(proto_norm.nodes), 1))
    total_dist = 0.0
    for un in user_norm.nodes:
        best = min(math.hypot(un[0] - pn[0], un[1] - pn[1]) for pn in proto_norm.nodes)
        total_dist += best
    avg_dist = total_dist / max(len(user_norm.nodes), 1)
    spatial_conf = max(0.0, 1.0 - avg_dist / 0.5)
    return (CONF_EDGE * edge_conf
            + CONF_NODE * node_ratio
            + CONF_SPATIAL * spatial_conf
            + CONF_FEATURE * similarity_score)

def nmd_entropy(scores):
    if len(scores) < 2:
        return 0.0, "low"
    total = sum(scores)
    if total == 0:
        return 0.0, "low"
    probs = [s / total for s in scores]
    raw = -sum(p * math.log(p) for p in probs if p > 0)
    norm = raw / math.log(len(probs))
    label = "low" if norm < 0.4 else ("medium" if norm < 0.7 else "high")
    return round(norm, 4), label

