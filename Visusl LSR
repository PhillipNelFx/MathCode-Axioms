# STRUCTURAL MEMORY (UPDATED WITH LOOP SIGNATURE)
# ─────────────────────────────────────────────
class StructuralMemory:
    def __init__(self):
        self.entries = []

    def add(self, name, graph):
        norm = graph.normalised()
        fingerprint = norm.compute_structural_fingerprint()
        mask, vec = compute_dna(norm)
        cvec = connectivity_features(norm)
        sdesc = norm.shape_descriptors()
        entry = {
            "name": name,
            "graph": norm,
            "mask": mask,
            "vector": vec,
            "conn_vec": cvec,
            "shape_desc": sdesc,
            "fingerprint": fingerprint
        }
        self.entries.append(entry)

    def query(self, graph, top_k=5):
        norm = graph.normalised()
        query_fp = norm.compute_structural_fingerprint()
        scored = []
        for e in self.entries:
            if "fingerprint" in e:
                fp_score = compare_fingerprints(query_fp, e["fingerprint"])
                node_sim = node_profile_similarity(norm, e["graph"])
                total = fp_score + W_NODE_PROFILE * node_sim
                scored.append((total, e))
            else:
                # Fallback to original scoring (legacy)
                q_mask, q_vec = compute_dna(norm)
                q_conn = connectivity_features(norm)
                q_sdesc = norm.shape_descriptors()
                mask_sim = (bin(q_mask & e["mask"]).count("1")
                            / max(1, bin(q_mask | e["mask"]).count("1")))
                vec_sim = cosine_similarity(q_vec, e["vector"])
                conn_emd = emd_distance(q_conn, e["conn_vec"])
                conn_sim = 1.0 - conn_emd
                node_sim = node_profile_similarity(norm, e["graph"])
                shape_sim = cosine_similarity(q_sdesc, e.get("shape_desc", [0,0,0]))
                score = (W_DNA_MASK * mask_sim + W_DNA_VEC * vec_sim +
                         W_CONNECTIVITY * conn_sim + W_NODE_PROFILE * node_sim +
                         W_SHAPE_DESC * shape_sim)
                scored.append((score, e))
        scored.sort(key=lambda x: x[0], reverse=True)
        return scored[:top_k]

    def remove(self, name):
        self.entries = [e for e in self.entries if e["name"] != name]

    def save(self, path=PROTO_FILE):
        data = []
        for e in self.entries:
            fp = e.get("fingerprint", {})
            data.append({
                "name": e["name"],
                "graph": e["graph"].to_dict(),
                "mask": e["mask"],
                "vector": e["vector"],
                "conn_vec": e["conn_vec"],
                "shape_desc": e["shape_desc"],
                "fingerprint": fp
            })
        try:
            with open(path, "w") as f:
                json.dump(data, f, indent=2)
            return True, f"Saved {len(data)} prototypes."
        except Exception as ex:
            return False, str(ex)

    def load(self, path=PROTO_FILE):
        if not os.path.exists(path):
            return False, "File not found."
        try:
            with open(path) as f:
                data = json.load(f)
            self.entries.clear()
            for d in data:
                g = Graph.from_dict(d["graph"])
                entry = {
                    "name": d["name"],
                    "graph": g,
                    "mask": d["mask"],
                    "vector": d["vector"],
                    "conn_vec": d.get("conn_vec", [0]*CONNECTIVITY_DIM),
                    "shape_desc": d.get("shape_desc", [0,0,0]),
                }
                if "fingerprint" in d:
                    entry["fingerprint"] = d["fingerprint"]
                self.entries.append(entry)
            return True, f"Loaded {len(self.entries)} prototypes."
        except Exception as ex:
            return False, str(ex)

