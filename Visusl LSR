        self.graph = Graph()
        self.node_items = {}
        self.edge_items = set()
        self.overlay_items = []

        self.stroke_points = []
        self.stroke_line_id = None

        self.drag_start = None
        self.active_line = None

        self.memory = StructuralMemory()
